@page "/profissional/agenda"
@model ProjetoTerapia.Pages.AgendaClinicaModel

@{
    ViewData["Title"] = "Agenda profissional";
}

<div class="agenda-layout">

    <!-- =====================================================
         SIDEBAR
    ====================================================== -->

    <aside class="sidebar">

        <img src="~/imagem/AlinhaVIDA.png"
             asp-append-version="true"
             class="logo-sidebar"
             alt="AlinhaVIDA" />

        <nav class="menu-sidebar">

            <a asp-page="/PainelClinica"
               class="menu-item">

                <i class="fa-solid fa-house"></i>

                <span>Dashboard</span>

            </a>


            <a asp-page="/AgendaClinica"
               class="menu-item ativo">

                <i class="fa-regular fa-calendar"></i>

                <span>Agenda</span>

            </a>


            <a asp-page="/PacientesClinica"
               class="menu-item">

                <i class="fa-solid fa-user-group"></i>

                <span>
                    Pacientes
                </span>

            </a>


            <a asp-page="/PerfilClinica"
               class="menu-item">

                <i class="fa-regular fa-id-card"></i>

                <span>Perfil</span>

            </a>

        </nav>

    </aside>


    <!-- =====================================================
         CONTEÚDO
    ====================================================== -->

    <main class="agenda-content">


        <!-- =================================================
             TOPO
        ================================================== -->

        <header class="topo-agenda">

            <div class="titulo-agenda">

                <span class="badge-agenda">
                    Agenda profissional
                </span>

                <h1>
                    Agenda
                </h1>

                <p>
                    Gerencie horários, consultas e solicitações
                    de pacientes em um único lugar.
                </p>

            </div>


            <a asp-page="/NovaConsulta"
               class="btn-nova-consulta">

                <i class="fa-solid fa-plus"></i>

                Nova consulta

            </a>

        </header>
        

            <!-- =================================================
                 RESUMO
            ================================================== -->

            <section class="grid-resumo">

                <article class="card-resumo">

                    <div class="icone-resumo hoje">

                        <i class="fa-regular fa-calendar"></i>

                    </div>

                    <span>
                        Consultas hoje
                    </span>

                    <h2>
                        @Model.ConsultasHoje
                    </h2>

                </article>


                <article class="card-resumo">

                    <div class="icone-resumo confirmada">

                        <i class="fa-solid fa-check"></i>

                    </div>

                    <span>
                        Confirmadas
                    </span>

                    <h2>
                        @Model.Confirmadas
                    </h2>

                </article>


                <article class="card-resumo">

                    <div class="icone-resumo pendente">

                        <i class="fa-regular fa-clock"></i>

                    </div>

                    <span>
                        Pendentes
                    </span>

                    <h2>
                        @Model.Pendentes
                    </h2>

                </article>


                <article class="card-resumo">

                    <div class="icone-resumo cancelada">

                        <i class="fa-solid fa-xmark"></i>

                    </div>

                    <span>
                        Canceladas
                    </span>

                    <h2>
                        @Model.Canceladas
                    </h2>

                </article>

            </section>


            <!-- =================================================
                 SOLICITAÇÕES
            ================================================== -->

            <section class="solicitacoes-box">

                <div class="titulo-box">

                    <div>

                        <span class="subtitulo-box">
                            Novas solicitações
                        </span>

                        <h3>
                            Solicitações de agendamento
                        </h3>

                        <p>
                            Pacientes aguardando sua confirmação.
                        </p>

                    </div>

                </div>


                @if (Model.SolicitacoesPendentes.Any())
                {
                    @foreach (var consulta in Model.SolicitacoesPendentes)
                    {
                        <article class="solicitacao-card">

                            <div class="solicitacao-info">


                                <div class="avatar">

                                    @(string.IsNullOrWhiteSpace(
                                        consulta.NomePaciente)

                                        ? "P"

                                        : consulta.NomePaciente
                                            .Substring(0, 1)
                                            .ToUpper())

                                </div>


                                <div class="dados-paciente">

                                    <h4>

                                        @(string.IsNullOrWhiteSpace(
                                            consulta.NomePaciente)

                                            ? "Paciente"
                                            : consulta.NomePaciente)

                                    </h4>


                                    <div class="infos-consulta">

                                        <span>

                                            <i class="fa-regular fa-calendar"></i>

                                            @(consulta.DataConsulta.HasValue
                                                ? consulta.DataConsulta.Value
                                                    .ToString("dd/MM/yyyy")
                                                : "Data não informada")

                                        </span>


                                        <span>

                                            <i class="fa-regular fa-clock"></i>

                                            @(consulta.DataConsulta.HasValue
                                                ? consulta.DataConsulta.Value
                                                    .ToString("HH:mm")
                                                : "--:--")

                                        </span>


                                        <span>

                                            <i class="fa-solid fa-stethoscope"></i>

                                            @(string.IsNullOrWhiteSpace(
                                                consulta.TipoAtendimento)

                                                ? "Atendimento"
                                                : consulta.TipoAtendimento)

                                        </span>

                                    </div>


                                    @if (!string.IsNullOrWhiteSpace(
                                        consulta.Observacoes))
                                    {
                                        <p class="observacao-paciente">

                                            @consulta.Observacoes

                                        </p>
                                    }

                                </div>

                            </div>


                            <div class="acoes-solicitacao">

                                <form method="post"
                                      asp-page-handler="Confirmar">

                                    <input type="hidden"
                                           name="id"
                                           value="@consulta.Id" />

                                    <button type="submit"
                                            class="btn-solicitacao confirmar">

                                        <i class="fa-solid fa-check"></i>

                                        Confirmar

                                    </button>

                                </form>


                                <form method="post"
                                      asp-page-handler="Cancelar">

                                    <input type="hidden"
                                           name="id"
                                           value="@consulta.Id" />

                                    <button type="submit"
                                            class="btn-solicitacao cancelar">

                                        <i class="fa-solid fa-xmark"></i>

                                        Recusar

                                    </button>

                                </form>

                            </div>

                        </article>
                    }
                }
                else
                {
                    <div class="consulta-vazia pequena">

                        <div class="vazio-icone">

                            <i class="fa-regular fa-circle-check"></i>

                        </div>

                        <h3>
                            Nenhuma solicitação pendente
                        </h3>

                        <p>
                            Quando um paciente solicitar uma consulta,
                            ela aparecerá aqui.
                        </p>

                    </div>
                }

            </section>


            <!-- =================================================
                 AGENDA CONFIRMADA
            ================================================== -->

            <section class="consultas-box">


                <!-- BUSCA -->

                <form method="get"
                      class="busca-agenda">

                    <div class="campo-busca-wrapper">

                        <i class="fa-solid fa-magnifying-glass"></i>

                        <input type="text"
                               name="Busca"
                               value="@Model.Busca"
                               placeholder="Buscar paciente..."
                               class="campo-busca"
                               autocomplete="off" />

                    </div>


                    <button type="submit"
                            class="btn-buscar">

                        Buscar

                    </button>


                    @if (!string.IsNullOrWhiteSpace(Model.Busca))
                    {
                        <a asp-page="/AgendaClinica"
                           class="btn-limpar">

                            Limpar

                        </a>
                    }

                </form>


                <div class="titulo-box">

                    <div>

                        <span class="subtitulo-box">
                            Seus atendimentos
                        </span>

                        <h3>
                            Agenda confirmada
                        </h3>

                        <p>
                            Consultas já confirmadas por você.
                        </p>

                    </div>

                </div>


                @if (Model.Consultas.Any())
                {
                    @foreach (var consulta in Model.Consultas)
                    {
                        <article class="consulta-card
                            @(consulta.DataConsulta?.Date == DateTime.Today
                                ? "consulta-hoje"
                                : "")">


                            <!-- PACIENTE -->

                            <div class="consulta-esquerda">

                                <div class="avatar">

                                    @(string.IsNullOrWhiteSpace(
                                        consulta.NomePaciente)

                                        ? "P"

                                        : consulta.NomePaciente
                                            .Substring(0, 1)
                                            .ToUpper())

                                </div>


                                <div class="dados-paciente">

                                    <h4>

                                        @(string.IsNullOrWhiteSpace(
                                            consulta.NomePaciente)

                                            ? "Paciente"
                                            : consulta.NomePaciente)

                                    </h4>


                                    <div class="infos-consulta">

                                        <span>

                                            <i class="fa-regular fa-calendar"></i>

                                            @(consulta.DataConsulta.HasValue
                                                ? consulta.DataConsulta.Value
                                                    .ToString("dd/MM/yyyy")
                                                : "Data não informada")

                                        </span>


                                        <span>

                                            <i class="fa-regular fa-clock"></i>

                                            @(consulta.DataConsulta.HasValue
                                                ? consulta.DataConsulta.Value
                                                    .ToString("HH:mm")
                                                : "--:--")

                                        </span>


                                        <span>

                                            <i class="fa-solid fa-stethoscope"></i>

                                            @(string.IsNullOrWhiteSpace(
                                                consulta.TipoAtendimento)

                                                ? "Atendimento"
                                                : consulta.TipoAtendimento)

                                        </span>

                                    </div>


                                    @if (!string.IsNullOrWhiteSpace(
                                        consulta.Observacoes))
                                    {
                                        <p class="observacao-paciente">

                                            @consulta.Observacoes

                                        </p>
                                    }

                                </div>

                            </div>


                            <!-- STATUS / AÇÕES -->

                            <div class="consulta-direita">

                                <span class="status confirmado">

                                    <i class="fa-solid fa-circle-check"></i>

                                    Confirmado

                                </span>


                                <div class="acoes-consulta">


                                    <a asp-page="/EditarConsulta"
                                       asp-route-id="@consulta.Id"
                                       class="btn-acao btn-editar"
                                       title="Editar consulta">

                                        <i class="fa-solid fa-pen"></i>

                                    </a>


                                    <form method="post"
                                          asp-page-handler="Cancelar">

                                        <input type="hidden"
                                               name="id"
                                               value="@consulta.Id" />

                                        <button type="submit"
                                                class="btn-acao btn-cancelar"
                                                title="Cancelar consulta"
                                                onclick="return confirm('Deseja cancelar esta consulta?')">

                                            <i class="fa-solid fa-ban"></i>

                                        </button>

                                    </form>


                                    <form method="post"
                                          asp-page-handler="Excluir"
                                          onsubmit="return confirm('Deseja excluir esta consulta definitivamente?')">

                                        <input type="hidden"
                                               name="id"
                                               value="@consulta.Id" />

                                        <button type="submit"
                                                class="btn-acao btn-excluir"
                                                title="Excluir consulta">

                                            <i class="fa-solid fa-trash"></i>

                                        </button>

                                    </form>

                                </div>

                            </div>

                        </article>
                    }
                }
                else
                {
                    <div class="consulta-vazia">

                        <div class="vazio-icone">

                            <i class="fa-regular fa-calendar-xmark"></i>

                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.Busca))
                        {
                            <h3>
                                Nenhum paciente encontrado
                            </h3>

                            <p>
                                Não encontramos consultas confirmadas
                                para a busca informada.
                            </p>
                        }
                        else
                        {
                            <h3>
                                Nenhuma consulta confirmada
                            </h3>

                            <p>
                                Quando você confirmar um atendimento,
                                ele aparecerá aqui.
                            </p>
                        }

                    </div>
                }

            </section>

       

    </main>

</div>


<style>

    /* =========================================================
           BASE
        ========================================================= */

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: 'Segoe UI', sans-serif;
        background: radial-gradient( circle at top right, rgba(37,99,235,.05), transparent 25% ), radial-gradient( circle at bottom left, rgba(14,165,233,.04), transparent 30% ), #f8fafc;
        color: #0f172a;
    }

    .container,
    .container-fluid,
    main.pb-3 {
        padding: 0 !important;
        margin: 0 !important;
        max-width: 100% !important;
    }


    /* =========================================================
           LAYOUT
        ========================================================= */

    .agenda-layout {
        min-height: 100vh;
        display: flex;
    }


    /* =========================================================
           SIDEBAR
        ========================================================= */

    .sidebar {
        position: relative;
        width: 270px;
        flex-shrink: 0;
        padding: 32px 24px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        background: linear-gradient( 180deg, #ffffff 0%, #f8fbff 100% );
        border-right: 1px solid #e2e8f0;
        box-shadow: 0 0 30px rgba(15,23,42,.03);
    }


        .sidebar::before {
            content: "";
            position: absolute;
            width: 240px;
            height: 240px;
            top: -120px;
            left: -120px;
            border-radius: 50%;
            background: rgba(37,99,235,.08);
            filter: blur(60px);
        }


        .sidebar::after {
            content: "";
            position: absolute;
            width: 220px;
            height: 220px;
            right: -120px;
            bottom: -120px;
            border-radius: 50%;
            background: rgba(14,165,233,.08);
            filter: blur(60px);
        }


    .logo-sidebar {
        position: relative;
        z-index: 2;
        width: 210px;
        max-width: 100%;
        height: auto;
        object-fit: contain;
        margin-bottom: 45px;
    }


    .menu-sidebar {
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }


    .menu-item {
        min-height: 52px;
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 15px 18px;
        border-radius: 16px;
        color: #475569;
        text-decoration: none;
        font-weight: 600;
        transition: .25s;
    }


    a.menu-item:hover {
        background: rgba(37,99,235,.05);
        color: #2563eb;
        transform: translateX(4px);
    }


    .menu-item.ativo {
        background: linear-gradient( 135deg, #2563eb, #06b6d4 );
        color: white;
        box-shadow: 0 8px 20px rgba(37,99,235,.18);
    }


    .menu-item-desabilitado {
        color: #94a3b8;
        cursor: default;
        opacity: .75;
    }


    /* =========================================================
           CONTEÚDO
        ========================================================= */

    .agenda-content {
        flex: 1;
        min-width: 0;
        padding: 45px;
    }


    /* =========================================================
           TOPO
        ========================================================= */

    .topo-agenda {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 30px;
        margin-bottom: 38px;
    }


    .titulo-agenda {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }


    .badge-agenda {
        width: fit-content;
        display: inline-flex;
        padding: 8px 14px;
        border: 1px solid rgba(37,99,235,.08);
        border-radius: 999px;
        background: rgba(37,99,235,.06);
        color: #3b82f6;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .5px;
        text-transform: uppercase;
    }


    .topo-agenda h1 {
        margin: 0;
        color: #0f172a;
        font-size: 36px;
        line-height: 1.15;
        font-weight: 700;
        letter-spacing: -1px;
    }


    .topo-agenda p {
        max-width: 650px;
        margin: 0;
        color: #64748b;
        font-size: 15px;
        line-height: 1.7;
    }


    /* =========================================================
           BOTÃO NOVA CONSULTA
        ========================================================= */

    .btn-nova-consulta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        padding: 16px 25px;
        border-radius: 18px;
        background: linear-gradient( 135deg, #2563eb, #0ea5e9 );
        color: white;
        text-decoration: none;
        font-size: 15px;
        font-weight: 700;
        box-shadow: 0 12px 30px rgba(37,99,235,.18);
        transition: .25s;
    }


        .btn-nova-consulta:hover {
            color: white;
            transform: translateY(-3px);
            box-shadow: 0 18px 40px rgba(37,99,235,.25);
        }


    /* =========================================================
           ALERTA
        ========================================================= */

    .alerta-agenda {
        display: flex;
        align-items: center;
        gap: 17px;
        padding: 22px;
        border: 1px solid #fecaca;
        border-radius: 20px;
        background: #fff;
        box-shadow: 0 10px 30px rgba(15,23,42,.05);
    }


    .alerta-icone {
        width: 48px;
        height: 48px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: #fee2e2;
        color: #dc2626;
    }


    .alerta-agenda strong {
        display: block;
        margin-bottom: 4px;
    }


    .alerta-agenda p {
        margin: 0;
        color: #64748b;
    }


    .alerta-agenda a {
        margin-left: auto;
        padding: 11px 16px;
        border-radius: 12px;
        background: #2563eb;
        color: white;
        text-decoration: none;
        font-weight: 600;
    }


    /* =========================================================
           RESUMO
        ========================================================= */

    .grid-resumo {
        display: grid;
        grid-template-columns: repeat(4, minmax(0,1fr));
        gap: 20px;
        margin-bottom: 35px;
    }


    .card-resumo {
        position: relative;
        padding: 24px;
        overflow: hidden;
        border: 1px solid #edf2f7;
        border-radius: 24px;
        background: rgba(255,255,255,.90);
        box-shadow: 0 10px 30px rgba(15,23,42,.04);
        transition: .25s;
    }


        .card-resumo:hover {
            transform: translateY(-3px);
            box-shadow: 0 18px 38px rgba(15,23,42,.07);
        }


    .icone-resumo {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 18px;
        border-radius: 13px;
    }


        .icone-resumo.hoje {
            background: #dbeafe;
            color: #2563eb;
        }


        .icone-resumo.confirmada {
            background: #dcfce7;
            color: #16a34a;
        }


        .icone-resumo.pendente {
            background: #fef3c7;
            color: #d97706;
        }


        .icone-resumo.cancelada {
            background: #fee2e2;
            color: #dc2626;
        }


    .card-resumo span {
        color: #64748b;
        font-size: 14px;
    }


    .card-resumo h2 {
        margin: 8px 0 0;
        color: #0f172a;
        font-size: 34px;
    }


    /* =========================================================
           BOXES
        ========================================================= */

    .solicitacoes-box,
    .consultas-box {
        padding: 30px;
        border: 1px solid #e2e8f0;
        border-radius: 30px;
        background: rgba(255,255,255,.95);
        box-shadow: 0 10px 30px rgba(15,23,42,.04);
    }


    .solicitacoes-box {
        margin-bottom: 35px;
    }


    .titulo-box {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 24px;
    }


    .subtitulo-box {
        display: block;
        margin-bottom: 6px;
        color: #2563eb;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .6px;
    }


    .titulo-box h3 {
        margin: 0 0 5px;
        color: #0f172a;
        font-size: 21px;
    }


    .titulo-box p {
        margin: 0;
        color: #64748b;
        font-size: 14px;
    }


    /* =========================================================
           SOLICITAÇÕES
        ========================================================= */

    .solicitacao-card {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 16px;
        padding: 22px;
        border: 1px solid #fed7aa;
        border-radius: 24px;
        background: #fffaf4;
    }


    .solicitacao-info {
        min-width: 0;
        display: flex;
        align-items: flex-start;
        gap: 16px;
    }


    .acoes-solicitacao {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
    }


        .acoes-solicitacao form {
            margin: 0;
        }


    .btn-solicitacao {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 12px 17px;
        border: none;
        border-radius: 14px;
        font-weight: 700;
        cursor: pointer;
        transition: .25s;
    }


        .btn-solicitacao:hover {
            transform: translateY(-2px);
        }


        .btn-solicitacao.confirmar {
            background: #16a34a;
            color: white;
        }


        .btn-solicitacao.cancelar {
            background: #fee2e2;
            color: #991b1b;
        }


    /* =========================================================
           BUSCA
        ========================================================= */

    .busca-agenda {
        display: flex;
        gap: 12px;
        margin-bottom: 30px;
    }


    .campo-busca-wrapper {
        position: relative;
        flex: 1;
        display: flex;
        align-items: center;
    }


        .campo-busca-wrapper > i {
            position: absolute;
            left: 17px;
            color: #94a3b8;
            pointer-events: none;
        }


    .campo-busca {
        width: 100%;
        height: 50px;
        padding: 0 18px 0 45px;
        border: 1px solid #dbe2ea;
        border-radius: 14px;
        background: #f8fafc;
        color: #0f172a;
        font-size: 14px;
        outline: none;
    }


        .campo-busca:focus {
            border-color: #2563eb;
            background: white;
            box-shadow: 0 0 0 4px rgba(37,99,235,.08);
        }


    .btn-buscar,
    .btn-limpar {
        min-height: 50px;
        padding: 0 21px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        font-weight: 600;
        text-decoration: none;
    }


    .btn-buscar {
        border: none;
        background: #2563eb;
        color: white;
        cursor: pointer;
    }


    .btn-limpar {
        border: 1px solid #e2e8f0;
        background: white;
        color: #64748b;
    }


    /* =========================================================
           CONSULTAS
        ========================================================= */

    .consulta-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 25px;
        margin-bottom: 16px;
        padding: 22px;
        border: 1px solid #eef2f7;
        border-radius: 24px;
        background: #f8fafc;
        transition: .25s;
    }


        .consulta-card:hover {
            border-color: #e2e8f0;
            background: white;
            transform: translateY(-2px);
            box-shadow: 0 15px 35px rgba(15,23,42,.06);
        }


    .consulta-hoje {
        border-left: 5px solid #2563eb;
        background: white;
    }


