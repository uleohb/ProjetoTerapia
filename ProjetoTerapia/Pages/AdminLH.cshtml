@page
@model ProjetoTerapia.Pages.AdminLHModel

<div class="admin-page">

    <aside class="sidebar-admin">

        <div class="logo-admin">
            <img src="/imagem/logo.png" alt="AlinhaMente" />
        </div>

        <nav class="menu-admin">

            <a href="javascript:void(0)" onclick="mostrarAba('dashboard', this)">
                Dashboard
            </a>

            <a href="javascript:void(0)" onclick="mostrarAba('clinicas', this)">
                Clínicas
            </a>

            <a href="javascript:void(0)" onclick="mostrarAba('alteracoes', this)">
                Alterações
            </a>

            <a href="javascript:void(0)" onclick="mostrarAba('pagamentos', this)">
                Pagamentos
            </a>

            <a href="javascript:void(0)" onclick="mostrarAba('divulgacao', this)">
                Clube de Descontos
            </a>

            <a href="javascript:void(0)" onclick="mostrarAba('vendedores', this)">
                Vendedores
            </a>

            <a href="javascript:void(0)" onclick="mostrarAba('historico', this)">
                Histórico
            </a>

        </nav>

        <form method="post" asp-page-handler="Logout" class="form-logout">
            <button class="btn-logout">
                Sair
            </button>
        </form>

    </aside>

    <main class="conteudo-admin">

        @if (TempData["MensagemSucesso"] != null)
        {
            <div class="alerta-sucesso">
                @TempData["MensagemSucesso"]
            </div>
        }

        @if (TempData["MensagemErro"] != null)
        {
            <div class="alerta-erro">
                @TempData["MensagemErro"]
            </div>
        }

        <section id="dashboard" class="aba">

            <div class="topo-conteudo">

                <div>
                    <span class="badge-admin">
                        Administração
                    </span>

                    <h1>
                        Painel Administrativo
                    </h1>

                    <p>
                        Acompanhe cadastros, pagamentos, visualizações e solicitações da plataforma.
                    </p>
                </div>

                <a href="/Teste" class="btn-site">
                    Ver site
                </a>

            </div>

            <div class="cards-dashboard">

                <div class="card-info">
                    <span>Total de profissionais</span>
                    <strong>@Model.TotalClinicas</strong>
                    <p>Cadastros realizados</p>
                </div>

                <div class="card-info pendente">
                    <span>Pendentes</span>
                    <strong>@Model.Pendentes</strong>
                    <p>Aguardando aprovação</p>
                </div>

                <div class="card-info ativo">
                    <span>Ativos</span>
                    <strong>@Model.Ativas</strong>
                    <p>Pagamentos confirmados</p>
                </div>

                <div class="card-info alerta">
                    <span>Alterações pendentes</span>
                    <strong>@Model.AlteracoesPendentes</strong>
                    <p>Perfis aguardando revisão</p>
                </div>

                <div class="card-info destaque">
                    <span>Receita total</span>
                    <strong>@Model.ReceitaPrevistaFormatada</strong>

                    <p class="resumo-receita-linha">
                        Planos: @Model.ReceitaPlanosPrincipaisFormatada
                    </p>

                    <p class="resumo-receita-linha">
                        Divulgação: @Model.ReceitaDivulgacaoRegionalFormatada
                    </p>
                </div>

                <div class="card-info ativo">
                    <span>Divulgações ativas</span>
                    <strong>@Model.DivulgacoesAtivas</strong>
                    <p>Cidades extras em exibição</p>
                </div>

                <div class="card-info">
                    <span>Visualizações</span>
                    <strong>@Model.TotalVisualizacoes</strong>
                    <p>Total de acessos aos perfis</p>
                </div>

                <div class="card-info">
                    <span>Cliques WhatsApp</span>
                    <strong>@Model.TotalCliquesWhatsapp</strong>
                    <p>Contatos iniciados</p>
                </div>

                <div class="card-info conversao">
                    <span>Conversão</span>
                    <strong>@Model.TaxaConversao%</strong>
                    <p>Aprovadas que viraram pagas</p>
                </div>

            </div>

        </section>

        <section id="clinicas" class="aba" style="display:none">

            <div class="topo-secao">

                <div>
                    <h2>
                        Gerenciar profissionais
                    </h2>

                    <p>
                        Aprove cadastros, confirme pagamentos e revise perfis cadastrados.
                    </p>
                </div>

            </div>

            <form method="get" class="filtros-admin">

                <input type="hidden" name="aba" value="clinicas" />

                <input type="text"
                       name="Busca"
                       value="@Model.Busca"
                       placeholder="Buscar por nome, email ou cidade..." />

                <select name="FiltroStatus">
                    <option value="">Todos os status</option>
                    <option value="pendente">Pendentes</option>
                    <option value="aprovado">Aprovadas sem pagamento</option>
                    <option value="ativo">Ativas</option>
                    <option value="alteracao">Alterações pendentes</option>
                </select>

                <button type="submit" class="btn-filtrar">
                    Filtrar
                </button>

            </form>

            <div class="lista-clinicas">

                @foreach (var clinica in Model.Clinicas)
                {
                    <article class="card-clinica">

                        <div class="card-topo">

                            <div>
                                <h3>
                                    @clinica.Nome
                                </h3>

                                <p>
                                    @clinica.Email
                                </p>
                            </div>

                            <div class="status-tags">

                                @if (!clinica.Aprovado)
                                {
                                    <span class="tag pendente">
                                        Pendente
                                    </span>
                                }
                                else
                                {
                                    <span class="tag aprovado">
                                        Aprovado
                                    </span>
                                }

                                @if (clinica.Pago)
                                {
                                    <span class="tag pago">
                                        Pago
                                    </span>
                                }
                                else
                                {
                                    <span class="tag nao-pago">
                                        Não pago
                                    </span>
                                }

                                @if (clinica.ClinicaAlteracaoPendente)
                                {
                                    <span class="tag alteracao">
                                        Alteração pendente
                                    </span>
                                }

                        </div>

                    </div>

                    <div class="info-grid">

                        <div>
                            <span>Cidade</span>
                            <strong>@(string.IsNullOrWhiteSpace(clinica.Cidade) ? "Não informada" : clinica.Cidade)</strong>
                        </div>

                        <div>
                            <span>Telefone</span>
                            <strong>@(string.IsNullOrWhiteSpace(clinica.Telefone) ? "Não informado" : clinica.Telefone)</strong>
                        </div>

                        <div>
                            <span>Valor consulta</span>
                            <strong>@clinica.Valor.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</strong>
                        </div>

                        <div>
                            <span>Visualizações</span>
                            <strong>@clinica.Visualizacoes</strong>
                        </div>

                        <div>
                            <span>Cliques WhatsApp</span>
                            <strong>@clinica.CliquesWhatsapp</strong>
                        </div>

                        <div>
                            <span>Vencimento</span>
                            <strong>
                                @(clinica.DataVencimento.HasValue
                                                                ? clinica.DataVencimento.Value.ToString("dd/MM/yyyy")
                                                                : "Sem vencimento")
                                                                               </strong>
                                                                           </div>

                    </div>

                    <p class="descricao-card">
                        @(string.IsNullOrWhiteSpace(clinica.Descricao)
                                                ? "Sem descrição cadastrada."
                                                : clinica.Descricao)
                    </p>

                        <div class="acoes-card-admin">

                            <form method="post">

                                <input type="hidden" name="id" value="@clinica.Id" />

                            @if (!clinica.Aprovado)
                                {
                                    <button type="submit"
                                            name="acao"
                                            value="aprovar"
                                            class="btn-acao aprovar"
                                            onclick='return confirmarAcao(this, "aprovar este profissional?")'>
                                        Aprovar cadastro
                                    </button>
                                }

                                @if (clinica.ClinicaAlteracaoPendente)
                                {
                                    <a href="?aba=alteracoes" class="btn-ver-perfil">
                                        Ver alterações pendentes
                                    </a>
                                }

                                @if (clinica.Aprovado && !clinica.Pago)
                                {
                                    <button type="submit"
                                            name="acao"
                                            value="pagar"
                                            class="btn-acao pagar"
                                            onclick='return confirmarAcao(this, "confirmar o pagamento deste profissional?")'>
                                        Confirmar pagamento
                                    </button>
                                }

                                @if (clinica.Pago)
                                {
                                    <button type="submit"
                                            name="acao"
                                            value="suspender"
                                            class="btn-acao suspender"
                                            onclick='return confirmarAcao(this, "suspender o plano deste profissional?")'>
                                        Suspender plano
                                    </button>
                                }

                                <button type="submit"
                                        name="acao"
                                        value="excluir"
                                        class="btn-acao excluir"
                                        onclick='return confirmarAcao(this, "excluir permanentemente este profissional?")'>
                                    Excluir
                                </button>

                            </form>

                            <a href="/PerfilClinica?id=@clinica.Id"
                               target="_blank"
                               class="btn-ver-perfil">
                                Ver perfil público
                            </a>

                        </div>

                    </article>
                }

                @if (!Model.Clinicas.Any())
                {
                    <div class="vazio-card">
                        Nenhum profissional encontrado com os filtros selecionados.
                    </div>
                }

            </div>

        </section>

        <section id="alteracoes" class="aba" style="display:none">

            <div class="topo-secao">

                <div>
                    <h2>
                        Alterações pendentes
                    </h2>

                    <p>
                        Revise alterações enviadas por profissionais antes de publicar no perfil público.
                    </p>
                </div>

            </div>

            <div class="lista-clinicas">

                @foreach (var alteracao in Model.AlteracoesClinicasPendentes)
                {
                    <article class="card-clinica">

                        <div class="card-topo">

                            <div>
                                <h3>
                                    @(alteracao.Clinica?.Nome ?? alteracao.Nome)
                                </h3>

                                <p>
                                    @(alteracao.Clinica?.Email ?? alteracao.Email)
                                </p>
                            </div>

                            <span class="tag alteracao">
                                Aguardando revisão
                            </span>

                        </div>

                        <div class="comparacao-alteracao">

                            <div class="coluna-comparacao atual">
                                <span>Perfil atual publicado</span>

                                <p>
                                    <strong>Nome:</strong>
                                    @(alteracao.Clinica?.Nome ?? "Não informado")
                                </p>

                                <p>
                                    <strong>Cidade:</strong>
                                    @(alteracao.Clinica?.Cidade ?? "Não informada")
                                </p>

                                <p>
                                    <strong>Valor:</strong>
                                    @(alteracao.Clinica != null
                                                                    ? alteracao.Clinica.Valor.ToString("C", new System.Globalization.CultureInfo("pt-BR"))
                                                                    : "Não informado")
                            </p>

                                <p>
                                    <strong>Descrição:</strong>
                                    @(alteracao.Clinica?.Descricao ?? "Sem descrição")
                                </p>

                                <p>
                                    <strong>Especialidades:</strong>
                                    @(alteracao.Clinica?.Especialidades ?? "Não informadas")
                                </p>
                            </div>

                            <div class="coluna-comparacao nova">
                                <span>Alteração enviada</span>

                                <p>
                                    <strong>Nome:</strong>
                                    @alteracao.Nome
                                </p>

                                <p>
                                    <strong>Cidade:</strong>
                                    @(string.IsNullOrWhiteSpace(alteracao.Cidade) ? "Não informada" : alteracao.Cidade)
                                </p>

                                <p>
                                    <strong>Valor:</strong>
                                    @alteracao.Valor.ToString("C", new System.Globalization.CultureInfo("pt-BR"))
                                </p>

                                <p>
                                    <strong>Descrição:</strong>
                                    @(string.IsNullOrWhiteSpace(alteracao.Descricao) ? "Sem descrição enviada" : alteracao.Descricao)
                                </p>

                                <p>
                                    <strong>Especialidades:</strong>
                                    @(string.IsNullOrWhiteSpace(alteracao.Especialidades) ? "Não informadas" : alteracao.Especialidades)
                                </p>
                            </div>

                        </div>

                        <div class="info-grid">

                            <div>
                                <span>Telefone enviado</span>
                                <strong>@(string.IsNullOrWhiteSpace(alteracao.Telefone) ? "Não informado" : alteracao.Telefone)</strong>
                            </div>

                            <div>
                                <span>Email enviado</span>
                                <strong>@alteracao.Email</strong>
                            </div>

                            <div>
                                <span>Solicitado em</span>
                                <strong>@alteracao.DataSolicitacao.ToString("dd/MM/yyyy HH:mm")</strong>
                            </div>

                            <div>
                                <span>Atendimento online</span>
                                <strong>@(alteracao.AtendimentoOnline ? "Sim" : "Não")</strong>
                            </div>

                            <div>
                                <span>Atendimento presencial</span>
                                <strong>@(alteracao.AtendimentoPresencial ? "Sim" : "Não")</strong>
                            </div>

                            <div>
                                <span>Status</span>
                                <strong>@alteracao.Status</strong>
                            </div>

                        </div>

                        <div class="acoes-card-admin">

                            <form method="post">

                                <input type="hidden" name="id" value="@alteracao.Id" />

                                <button type="submit"
                                        name="acao"
                                        value="aprovarAlteracao"
                                        class="btn-acao aprovar"
                                        onclick='return confirmarAcao(this, "aprovar as alterações deste perfil?")'>
                                    Aprovar alterações
                                </button>

                            </form>

                            <form method="post" class="form-recusa">

                                <input type="hidden" name="id" value="@alteracao.Id" />

                                <input type="text"
                                       name="MotivoRecusa"
                                       class="input-recusa"
                                       placeholder="Motivo da recusa..." />

                                <button type="submit"
                                        name="acao"
                                        value="recusarAlteracao"
                                        class="btn-acao excluir"
                                        onclick='return confirmarAcao(this, "recusar as alterações deste perfil?")'>
                                    Recusar
                                </button>

                            </form>

                        @if (alteracao.Clinica != null)
                            {
                                <a href="/PerfilClinica?id=@alteracao.Clinica.Id"
                                   target="_blank"
                                   class="btn-ver-perfil">
                                    Ver perfil atual
                                </a>
                            }

                        </div>

                    </article>
                }

                @if (!Model.AlteracoesClinicasPendentes.Any())
                {
                    <div class="vazio-card">
                        Nenhuma alteração pendente no momento.
                    </div>
                }

            </div>

        </section>

        <section id="pagamentos" class="aba" style="display:none">

            <div class="topo-secao">

                <div>
                    <h2>
                        Pagamentos
                    </h2>

                    <p>
                        Confirme manualmente pagamentos realizados pelo link do Mercado Pago.
                    </p>
                </div>

            </div>

            <div class="lista-clinicas">

                @foreach (var clinica in Model.Clinicas.Where(c => c.Aprovado && !c.Pago))
                {
                    <article class="card-clinica">

                        <div class="card-topo">

                            <div>
                                <h3>@clinica.Nome</h3>
                                <p>@clinica.Email</p>
                            </div>

                            <span class="tag nao-pago">
                                Pagamento pendente
                            </span>

                        </div>

                        <div class="pagamento-box">

                            <div>
                                <span>Plano</span>
                                <strong>Plano Profissional Anual</strong>
                            </div>

                            <div>
                                <span>Valor</span>
                                <strong>R$ 450,00 / ano ou 12x de R$ 37,50</strong>
                            </div>

                            <div>
                                <span>Forma atual</span>
                                <strong>Link Mercado Pago</strong>
                            </div>

                        </div>

                        <div class="acoes-card-admin">

                            <a href="https://mpago.la/33FgjZL"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="btn-ver-perfil">
                                Abrir link de pagamento
                            </a>

                            <form method="post">

                                <input type="hidden" name="id" value="@clinica.Id" />

                                <button type="submit"
                                        name="acao"
                                        value="pagar"
                                        class="btn-acao pagar"
                                        onclick='return confirmarAcao(this, "confirmar o pagamento deste profissional?")'>
                                    Confirmar pagamento
                                </button>

                            </form>

                        </div>

                    </article>
                }

                @if (!Model.Clinicas.Any(c => c.Aprovado && !c.Pago))
                {
                    <div class="vazio-card">
                        Nenhum pagamento pendente no momento.
                    </div>
                }

            </div>

        </section>

        <section id="divulgacao" class="aba" style="display:none">

            <div class="topo-secao">

                <div>
                    <h2>
                        Clube de Descontos
                    </h2>

                    <p>
                        Acompanhe pagamentos e divulgações regionais ativas dos profissionais.
                    </p>
                </div>

            </div>

            <div class="clube-grid">

                <div class="clube-card">
                    <span>Divulgação regional</span>
                    <h3>+1 cidade</h3>
                    <strong>R$ 30,00</strong>
                    <p>Cidade principal + 1 adicional.</p>
                </div>

                <div class="clube-card">
                    <span>Divulgação regional</span>
                    <h3>+3 cidades</h3>
                    <strong>R$ 35,00</strong>
                    <p>Cidade principal + 3 adicionais.</p>
                </div>

                <div class="clube-card">
                    <span>Divulgação regional</span>
                    <h3>+5 cidades</h3>
                    <strong>R$ 40,00</strong>
                    <p>Cidade principal + 5 adicionais.</p>
                </div>

                <div class="clube-card">
                    <span>Divulgação regional</span>
                    <h3>+8 cidades</h3>
                    <strong>R$ 45,00</strong>
                    <p>Cidade principal + 8 adicionais.</p>
                </div>

                <div class="clube-card">
                    <span>Divulgação regional</span>
                    <h3>+10 cidades</h3>
                    <strong>R$ 50,00</strong>
                    <p>Cidade principal + 10 adicionais.</p>
                </div>

                <div class="clube-card">
                    <span>Divulgação regional</span>
                    <h3>+15 cidades</h3>
                    <strong>R$ 55,00</strong>
                    <p>Cidade principal + 15 adicionais.</p>
                </div>

                <div class="clube-card">
                    <span>Divulgação regional</span>
                    <h3>+20 cidades</h3>
                    <strong>R$ 60,00</strong>
                    <p>Cidade principal + 20 adicionais.</p>
                </div>

                <div class="clube-card">
                    <span>Divulgação regional</span>
                    <h3>+25 cidades</h3>
                    <strong>R$ 65,00</strong>
                    <p>Cidade principal + 25 adicionais.</p>
                </div>

                <div class="clube-card destaque">
                    <span>Divulgação regional</span>
                    <h3>+27 cidades</h3>
                    <strong>R$ 70,00</strong>
                    <p>Cobertura regional ampliada.</p>
                </div>

            </div>

            <div class="lista-clinicas">

                @foreach (var item in Model.DivulgacoesRegionais)
                {
                    <article class="card-clinica">

                        <div class="card-topo">

                            <div>
                                <h3>
                                    @(item.Clinica?.Nome ?? "Profissional não encontrado")
                                </h3>

                                <p>
                                    @(item.Clinica?.Email ?? "")
                                </p>
                            </div>

                            <div class="status-tags">

                                @if (item.Status == "Expirado")
                                {
                                    <span class="tag expirado">
                                        Expirado
                                    </span>
                                }
                                else if (item.Status == "Cancelado")
                                {
                                    <span class="tag cancelado">
                                        Cancelado
                                    </span>
                                }
                                else if (item.Status == "Substituído")
                                {
                                    <span class="tag substituido">
                                        Substituído
                                    </span>
                                }
                                else if (item.Ativo)
                                {
                                    <span class="tag pago">
                                        Ativo
                                    </span>
                                }
                                else if (item.Pago)
                                {
                                    <span class="tag aprovado">
                                        Pagamento confirmado
                                    </span>
                                }
                                else
                                {
                                    <span class="tag nao-pago">
                                        Aguardando pagamento
                                    </span>
                                }

                        </div>

                    </div>

                    <div class="info-grid">

                        <div>
                            <span>Plano</span>
                            <strong>@item.NomePlano</strong>
                        </div>

                        <div>
                            <span>Valor</span>
                            <strong>@item.Valor.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</strong>
                        </div>

                        <div>
                            <span>Status</span>
                            <strong>@item.Status</strong>
                        </div>

                        <div>
                            <span>Cidades</span>
                            <strong>@item.CidadesSelecionadas</strong>
                        </div>

                        <div>
                            <span>Solicitado em</span>
                            <strong>@item.DataSolicitacao.ToString("dd/MM/yyyy HH:mm")</strong>
                        </div>

                        <div>
                            <span>Pagamento</span>
                            <strong>
                                @(item.DataPagamento.HasValue
                                                                ? item.DataPagamento.Value.ToString("dd/MM/yyyy HH:mm")
                                                                : "Não confirmado")
                                                                               </strong>
                                                                           </div>

                        <div>
                            <span>Início</span>
                            <strong>
                                @(item.DataInicio.HasValue
                                                                ? item.DataInicio.Value.ToString("dd/MM/yyyy")
                                                                : "Não iniciado")
                                                                             </strong>
                                                                         </div>

                        <div>
                            <span>Fim</span>
                            <strong>
                                @(item.DataFim.HasValue
                                                                ? item.DataFim.Value.ToString("dd/MM/yyyy")
                                                                : "Não iniciado")
                                                                             </strong>
                                                                         </div>

                        <div>
                            <span>Mercado Pago</span>
                            <strong>
                                @(string.IsNullOrWhiteSpace(item.MercadoPagoStatus)
                                                                ? "Sem retorno"
                                                                : item.MercadoPagoStatus)
                            </strong>
                        </div>

                        </div>

                        <div class="acoes-card-admin">

                            <form method="post">

                                <input type="hidden" name="id" value="@item.Id" />

                            @if (item.Pago &&
                                                        !item.Ativo &&
                                                        item.Status != "Cancelado" &&
                                                        item.Status != "Expirado" &&
                                                        item.Status != "Substituído")
                                {
                                    <button type="submit"
                                            name="acao"
                                            value="ativarDivulgacao"
                                            class="btn-acao aprovar"
                                            onclick='return confirmarAcao(this, "ativar esta divulgação regional?")'>
                                        Ativar divulgação
                                    </button>
                                }

                                @if (item.Ativo)
                                {
                                    <button type="submit"
                                            name="acao"
                                            value="cancelarDivulgacao"
                                            class="btn-acao suspender"
                                            onclick='return confirmarAcao(this, "cancelar esta divulgação regional?")'>
                                        Cancelar divulgação
                                    </button>
                                }

                                @if (!item.Ativo)
                                {
                                    <button type="submit"
                                            name="acao"
                                            value="excluirDivulgacao"
                                            class="btn-acao excluir"
                                            onclick='return confirmarAcao(this, "remover este registro da listagem?")'>
                                        Excluir registro
                                    </button>
                                }

                            </form>

                            @if (!string.IsNullOrWhiteSpace(item.LinkPagamento) && !item.Pago)
                            {
                                <a href="@item.LinkPagamento"
                                   target="_blank"
                                   class="btn-ver-perfil">
                                    Abrir pagamento
                                </a>
                            }

                            @if (item.Clinica != null)
                            {
                                <a href="/PerfilClinica?id=@item.Clinica.Id"
                                   target="_blank"
                                   class="btn-ver-perfil">
                                    Ver perfil
                                </a>
                            }

                        </div>

                    </article>
                }

                @if (!Model.DivulgacoesRegionais.Any())
                {
                    <div class="vazio-card">
                        Nenhuma divulgação regional no momento.
                    </div>
                }

            </div>

        </section>

        <section id="vendedores" class="aba" style="display:none">

            <div class="topo-secao">

                <div>
                    <h2>
                        Vendedores
                    </h2>

                    <p>
                        Cadastre vendedores freelancers e acompanhe indicações vinculadas à plataforma.
                    </p>
                </div>

            </div>

            <article class="card-clinica">

                <div class="card-topo">

                    <div>
                        <h3>
                            Cadastrar vendedor
                        </h3>

                        <p>
                            O sistema gera automaticamente um código de indicação para cada vendedor.
                        </p>
                    </div>

                </div>

                <form method="post" class="form-vendedor-admin">

                    <input type="text"
                           asp-for="NovoVendedorNome"
                           placeholder="Nome do vendedor" />

                    <input type="email"
                           asp-for="NovoVendedorEmail"
                           placeholder="Email do vendedor" />

                    <input type="text"
                           asp-for="NovoVendedorTelefone"
                           placeholder="Telefone / WhatsApp" />

                    <input type="password"
                           asp-for="NovoVendedorSenha"
                           placeholder="Senha inicial" />

                    <div class="campo-vendedor">
                        <label>Comissão (%)</label>

                        <input type="number"
                               asp-for="NovoVendedorComissao"
                               min="1"
                               max="100"
                               step="1" />
                    </div>

                    <input type="text"
                           asp-for="NovoVendedorPix"
                           placeholder="Chave Pix" />

                    <button type="submit"
                            name="acao"
                            value="cadastrarVendedor"
                            class="btn-acao aprovar">
                        Cadastrar vendedor
                    </button>

                </form>

            </article>

            <div class="lista-clinicas" style="margin-top: 22px;">

                @foreach (var vendedor in Model.Vendedores)
                {
                    <article class="card-clinica">

                        <div class="card-topo">

                            <div>
                                <h3>
                                    @vendedor.Nome
                                </h3>

                                <p>
                                    @vendedor.Email
                                </p>
                            </div>

                            <div class="status-tags">

                                @if (vendedor.Ativo)
                                {
                                    <span class="tag pago">
                                        Ativo
                                    </span>
                                }
                                else
                                {
                                    <span class="tag cancelado">
                                        Inativo
                                    </span>
                                }

                            </div>

                        </div>

                        <div class="info-grid">

                            <div>
                                <span>Código</span>
                                <strong>@vendedor.CodigoIndicacao</strong>
                            </div>

                            <div>
                                <span>Comissão</span>
                                <strong>@vendedor.PercentualComissao%</strong>
                            </div>

                            <div>
                                <span>Telefone</span>
                                <strong>@(string.IsNullOrWhiteSpace(vendedor.Telefone) ? "Não informado" : vendedor.Telefone)</strong>
                            </div>

                            <div>
                                <span>Pix</span>
                                <strong>@(string.IsNullOrWhiteSpace(vendedor.ChavePix) ? "Não informado" : vendedor.ChavePix)</strong>
                            </div>

                            <div>
                                <span>Cadastrado em</span>
                                <strong>@vendedor.DataCadastro.ToString("dd/MM/yyyy")</strong>
                            </div>

                            <div>
                                <span>Link de indicação</span>
                                <strong>/CadastroConta?vendedor=@vendedor.CodigoIndicacao</strong>
                            </div>

                        </div>

                        <div class="acoes-card-admin">

                            <form method="post">

                                <input type="hidden" name="id" value="@vendedor.Id" />

                                @if (vendedor.Ativo)
                                {
                                    <button type="submit"
                                            name="acao"
                                            value="desativarVendedor"
                                            class="btn-acao suspender"
                                            onclick='return confirmarAcao(this, "desativar este vendedor?")'>
                                        Desativar
                                    </button>
                                }
                                else
                                {
                                    <button type="submit"
                                            name="acao"
                                            value="ativarVendedor"
                                            class="btn-acao aprovar"
                                            onclick='return confirmarAcao(this, "ativar este vendedor?")'>
                                        Ativar
                                    </button>
                                }

                            </form>

                        </div>

                    </article>
                }

                @if (!Model.Vendedores.Any())
                {
                    <div class="vazio-card">
                        Nenhum vendedor cadastrado ainda.
                    </div>
                }

            </div>

            <div class="topo-secao" style="margin-top: 34px;">

                <div>
                    <h2>
                        Vendas e comissões
                    </h2>

                    <p>
                        Acompanhe vendas vinculadas aos vendedores, comprovantes enviados e pagamentos de comissão.
                    </p>
                </div>

            </div>

            <div class="lista-clinicas">

                @foreach (var venda in Model.VendasVendedores)
                {
                    <article class="card-clinica">

                        <div class="card-topo">

                            <div>
                                <h3>
                                    @venda.NomeClinica
                                </h3>

                                <p>
                                    Vendedor: @(venda.Vendedor?.Nome ?? "Não encontrado")
                                </p>
                            </div>

                            <div class="status-tags">

                                @if (venda.ComissaoPaga)
                                {
                                    <span class="tag pago">
                                        Comissão paga
                                    </span>
                                }
                                else if (!string.IsNullOrWhiteSpace(venda.ComprovanteNotaFiscal))
                                {
                                    <span class="tag aprovado">
                                        Documento enviado
                                    </span>
                                }
                                else
                                {
                                    <span class="tag pendente">
                                        Aguardando documento
                                    </span>
                                }

                        </div>

                    </div>

                    <div class="info-grid">

                        <div>
                            <span>Email da clínica</span>
                            <strong>@venda.EmailClinica</strong>
                        </div>

                        <div>
                            <span>Código vendedor</span>
                            <strong>@venda.CodigoIndicacao</strong>
                        </div>

                        <div>
                            <span>Valor da venda</span>
                            <strong>@venda.ValorVenda.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</strong>
                        </div>

                        <div>
                            <span>Comissão</span>
                            <strong>@venda.PercentualComissao%</strong>
                        </div>

                        <div>
                            <span>Valor comissão</span>
                            <strong>@venda.ValorComissao.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</strong>
                        </div>

                        <div>
                            <span>Status</span>
                            <strong>@venda.Status</strong>
                        </div>

                        <div>
                            <span>Venda confirmada em</span>
                            <strong>
                                @(venda.DataConfirmacaoVenda.HasValue
                                                                ? venda.DataConfirmacaoVenda.Value.ToString("dd/MM/yyyy HH:mm")
                                                                : venda.DataCadastro.ToString("dd/MM/yyyy HH:mm"))
                                                                                                              </strong>
                                                                                                          </div>

                        <div>
                            <span>Comissão paga em</span>
                            <strong>
                                @(venda.DataPagamentoComissao.HasValue
                                                                ? venda.DataPagamentoComissao.Value.ToString("dd/MM/yyyy HH:mm")
                                                                : "Pendente")
                                                                         </strong>
                                                                     </div>

                        <div>
                            <span>Documento</span>
                            <strong>
                                @(string.IsNullOrWhiteSpace(venda.ComprovanteNotaFiscal)
                                                                ? "Não enviado"
                                                                : "Enviado")
                            </strong>
                        </div>

                        </div>

                        <div class="acoes-card-admin">

                        @if (!string.IsNullOrWhiteSpace(venda.ComprovanteNotaFiscal))
                            {
                                <a href="@venda.ComprovanteNotaFiscal"
                                   target="_blank"
                                   class="btn-ver-perfil">
                                    Ver documento
                                </a>
                            }

                            @if (venda.ClinicaId.HasValue)
                            {
                                <a href="/PerfilClinica?id=@venda.ClinicaId"
                                   target="_blank"
                                   class="btn-ver-perfil">
                                    Ver clínica
                                </a>
                            }

                            <form method="post">

                                <input type="hidden" name="id" value="@venda.Id" />

                                @if (!venda.ComissaoPaga)
                                {
                                    <button type="submit"
                                            name="acao"
                                            value="marcarComissaoPaga"
                                            class="btn-acao pagar"
                                            onclick='return confirmarAcao(this, "marcar esta comissão como paga?")'>
                                        Marcar como paga
                                    </button>
                                }
                                else
                                {
                                    <button type="submit"
                                            name="acao"
                                            value="reabrirComissao"
                                            class="btn-acao suspender"
                                            onclick='return confirmarAcao(this, "reabrir esta comissão?")'>
                                        Reabrir comissão
                                    </button>
                                }

                            </form>

                        </div>

                    </article>
                }

                @if (!Model.VendasVendedores.Any())
                {
                    <div class="vazio-card">
                        Nenhuma venda vinculada a vendedores ainda.
                    </div>
                }

            </div>

        </section>

        <section id="historico" class="aba" style="display:none">

            <div class="topo-secao">

                <div>
                    <h2>
                        Histórico administrativo
                    </h2>

                    <p>
                        Acompanhe ações realizadas por administradores no painel.
                    </p>
                </div>

            </div>

            <div class="historico-lista">

                @foreach (var log in Model.AdminLogs)
                {
                    <article class="historico-card">

                        <div class="historico-topo">

                            <div>
                                <span class="historico-acao">
                                    @log.Acao
                                </span>

                                <h3>
                                    @log.NomeAdmin
                                </h3>
                            </div>

                            <span class="tag aprovado">
                                @log.PerfilAdmin
                            </span>

                        </div>

                        <p>
                            @log.Descricao
                        </p>

                        <div class="historico-meta">

                            <span>
                                @log.DataAcao.ToString("dd/MM/yyyy HH:mm")
                            </span>

                        </div>

                    </article>
                }

                @if (!Model.AdminLogs.Any())
                {
                    <div class="vazio-card">
                        Nenhum registro administrativo encontrado ainda.
                    </div>
                }

            </div>

        </section>

    </main>

</div>

<div id="modalConfirmacao" class="modal-confirmacao">

    <div class="modal-box">

        <h3>
            Confirmar ação
        </h3>

        <p id="textoModal">
            Deseja realmente continuar?
        </p>

        <div class="modal-botoes">

            <button type="button"
                    class="btn-cancelar"
                    onclick="fecharModal()">
                Cancelar
            </button>

            <button type="button"
                    class="btn-confirmar"
                    id="btnConfirmarFinal">
                Confirmar
            </button>

        </div>

    </div>

</div>

