@page
@model ProjetoTerapia.Pages.EditarConsultaModel

<div class="editar-page">

    <div class="editar-card">

        <img src="/imagem/logo.png" class="logo-editar" />

        <span class="badge-editar">
            Consulta
        </span>

        <h1>
            Editar consulta
        </h1>

        <p class="sub">
            Atualize data, modalidade, status e anotações internas sobre o paciente.
        </p>

        <div class="paciente-box">

            <div>
                <span>Paciente</span>
                <strong>@Model.Consulta.NomePaciente</strong>
            </div>

            <div>
                <span>Email</span>
                <strong>@Model.Consulta.EmailPaciente</strong>
            </div>

            <div>
                <span>Status atual</span>
                <strong>@Model.Consulta.Status</strong>
            </div>

        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Consulta.Observacoes))
        {
            <div class="observacao-box">

                <span>Observação enviada pelo paciente</span>

                <p>
                    @Model.Consulta.Observacoes
                </p>

            </div>
        }

        @if (Model.Consulta.ResultadoTestePaciente != null)
        {
            <div class="resultado-box">

                <span>Resultado compartilhado</span>

                <strong>
                    @Model.Consulta.ResultadoTestePaciente.Nivel
                </strong>

                <p>
                    Ansiedade: @Model.Consulta.ResultadoTestePaciente.PercentualAnsiedade% |
                    Depressão: @Model.Consulta.ResultadoTestePaciente.PercentualDepressao%
                </p>

            </div>
        }

        <form method="post">

            <input type="hidden" asp-for="Id" />

            <div class="campo">
                <label>Data e horário</label>
                <input asp-for="DataConsulta" type="datetime-local" />
            </div>

            <div class="campo">
                <label>Modalidade</label>

                <select asp-for="TipoAtendimento">
                    <option value="Online">Online</option>
                    <option value="Presencial">Presencial</option>
                </select>
            </div>

            <div class="campo">
                <label>Status</label>

                <select asp-for="Status">
                    <option value="Pendente">Pendente</option>
                    <option value="Confirmado">Confirmado</option>
                    <option value="Cancelado">Cancelado</option>
                    <option value="Realizado">Realizado</option>
                </select>
            </div>

            <div class="campo">
                <label>Anotações internas do profissional</label>

                <textarea asp-for="AnotacoesProfissional"
                          placeholder="Escreva informações importantes sobre o atendimento, evolução, observações ou próximos passos."></textarea>
            </div>

            <button type="submit" class="btn-salvar">
                Salvar alterações
            </button>

        </form>

        <a href="/AgendaClinica" class="btn-voltar-editar">
            Voltar para agenda
        </a>

    </div>

</div>

<style>

    @@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

    * {
        box-sizing: border-box;
        font-family: 'Poppins', sans-serif;
    }

    html,
    body {
        margin: 0;
        padding: 0;
        background: #eaf8ff;
    }

    .container,
    .container-fluid,
    main {
        padding: 0 !important;
        margin: 0 !important;
        max-width: 100% !important;
        background: transparent !important;
    }

    .editar-page {
        min-height: 100vh;
        padding: 45px 20px;
        background: radial-gradient(circle at top left, rgba(14,165,233,.20), transparent 34%), radial-gradient(circle at bottom right, rgba(124,58,237,.15), transparent 35%), linear-gradient(135deg,#e0f7ff 0%, #f8fcff 48%, #edf3ff 100%);
        display: flex;
        justify-content: center;
    }

    .editar-card {
        width: 100%;
        max-width: 820px;
        background: rgba(255,255,255,.94);
        border: 1px solid rgba(226,232,240,.9);
        backdrop-filter: blur(18px);
        border-radius: 34px;
        padding: 38px;
        box-shadow: 0 25px 70px rgba(15,23,42,.10);
    }

    .logo-editar {
        width: 230px;
        display: block;
        margin: 0 auto 12px;
    }

    .badge-editar {
        display: inline-block;
        padding: 8px 16px;
        border-radius: 999px;
        background: rgba(14,165,233,.12);
        color: #0369a1;
        font-size: 13px;
        font-weight: 800;
        margin-bottom: 16px;
    }

    h1 {
        margin: 0 0 12px;
        color: #0f172a;
        font-size: 38px;
        letter-spacing: -1px;
    }

    .sub {
        color: #64748b;
        line-height: 1.7;
        margin-bottom: 24px;
    }

    .paciente-box {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 12px;
        margin-bottom: 20px;
    }

        .paciente-box div,
        .observacao-box,
        .resultado-box {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 20px;
            padding: 18px;
        }

            .paciente-box span,
            .observacao-box span,
            .resultado-box span {
                display: block;
                color: #94a3b8;
                font-size: 12px;
                font-weight: 800;
                margin-bottom: 7px;
                text-transform: uppercase;
            }

            .paciente-box strong,
            .resultado-box strong {
                color: #0f172a;
            }

    .observacao-box,
    .resultado-box {
        margin-bottom: 20px;
    }

        .observacao-box p,
        .resultado-box p {
            color: #64748b;
            line-height: 1.6;
            margin: 0;
        }

    .campo {
        margin-bottom: 18px;
    }

        .campo label {
            display: block;
            color: #334155;
            font-weight: 800;
            margin-bottom: 8px;
        }

        .campo input,
        .campo select,
        .campo textarea {
            width: 100%;
            border: 1px solid #dbeafe;
            border-radius: 16px;
            padding: 15px;
            background: #f8fafc;
            outline: none;
            font-size: 15px;
        }

        .campo textarea {
            min-height: 170px;
            resize: vertical;
        }

            .campo input:focus,
            .campo select:focus,
            .campo textarea:focus {
                border-color: #0ea5e9;
                background: white;
                box-shadow: 0 0 0 4px rgba(14,165,233,.10);
            }

    .btn-salvar,
    .btn-voltar-editar {
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        text-decoration: none;
        border-radius: 18px;
        padding: 16px 22px;
        font-weight: 800;
        transition: .25s;
    }

    .btn-salvar {
        border: none;
        color: white;
        background: linear-gradient(135deg,#14b8a6,#0ea5e9);
        cursor: pointer;
        font-size: 16px;
        box-shadow: 0 14px 28px rgba(14,165,233,.18);
    }

    .btn-voltar-editar {
        margin-top: 14px;
        color: #0ea5e9;
        background: white;
        border: 1px solid #dbeafe;
    }

        .btn-salvar:hover,
        .btn-voltar-editar:hover {
            transform: translateY(-2px);
        }

    @@media(max-width: 750px) {
        .editar-card {
            padding: 28px 20px;
        }

        .paciente-box {
            grid-template-columns: 1fr;
        }

        h1 {
            font-size: 31px;
        }
    }

</style>