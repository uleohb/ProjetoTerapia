@page
@model ProjetoTerapia.Pages.SuporteModel

<div class="suporte-page">

    <div class="suporte-card">

        <div class="topo-suporte">

            <img src="/imagem/logo.png"
                 class="logo-suporte"
                 alt="AlinhaMente" />

            <span class="badge-suporte">
                Suporte via WhatsApp
            </span>

            <h1>
                Precisa de ajuda?
            </h1>

            <p>
                Clique no botão abaixo para abrir uma conversa com o suporte oficial do AlinhaMente.
                A mensagem já será preenchida automaticamente para você enviar.
            </p>

        </div>

        @if (TempData["Erro"] != null)
        {
            <div class="alerta-erro">
                @TempData["Erro"]
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.LinkWhatsappSuporte))
        {
            <a href="@Model.LinkWhatsappSuporte"
               target="_blank"
               rel="noopener noreferrer"
               class="btn-whatsapp-suporte">
                <i class="fa-brands fa-whatsapp"></i>
                Falar com suporte no WhatsApp
            </a>
        }

        <div class="info-suporte">

            <strong>
                Como funciona?
            </strong>

            <p>
                O WhatsApp será aberto com uma mensagem pronta. Depois, basta enviar e continuar o atendimento diretamente com nossa equipe.
            </p>

        </div>

        <div class="rodape-suporte">

            <a href="/Teste">
                Voltar para a página inicial
            </a>

        </div>

    </div>

</div>

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<style>

    @@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

    * {
        box-sizing: border-box;
        font-family: 'Poppins', sans-serif;
    }

    html,
    body {
        margin: 0;
        padding: 0;
        background: #eaf8ff;
    }

    .container,
    .container-fluid,
    main {
        padding: 0 !important;
        margin: 0 !important;
        max-width: 100% !important;
        background: transparent !important;
    }

    .suporte-page {
        min-height: 100vh;
        padding: 45px 20px;
        background: radial-gradient(circle at top left, rgba(14,165,233,.20), transparent 34%), radial-gradient(circle at bottom right, rgba(124,58,237,.15), transparent 35%), linear-gradient(135deg,#e0f7ff 0%, #f8fcff 48%, #edf3ff 100%);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .suporte-card {
        width: 100%;
        max-width: 760px;
        background: rgba(255,255,255,.94);
        border: 1px solid rgba(226,232,240,.9);
        backdrop-filter: blur(18px);
        border-radius: 34px;
        padding: 42px 38px;
        box-shadow: 0 25px 70px rgba(15,23,42,.10);
        text-align: center;
    }

    .topo-suporte {
        margin-bottom: 28px;
    }

    .logo-suporte {
        width: 245px;
        max-width: 100%;
        margin-bottom: 10px;
    }

    .badge-suporte {
        display: inline-block;
        padding: 8px 16px;
        border-radius: 999px;
        background: rgba(34,197,94,.14);
        color: #166534;
        font-size: 13px;
        font-weight: 800;
        margin-bottom: 16px;
    }

    h1 {
        margin: 0 0 12px;
        font-size: 38px;
        color: #0f172a;
        letter-spacing: -1px;
    }

    .topo-suporte p {
        margin: 0 auto;
        color: #64748b;
        line-height: 1.7;
        max-width: 610px;
    }

    .btn-whatsapp-suporte {
        width: 100%;
        min-height: 62px;
        border-radius: 20px;
        background: linear-gradient(135deg,#22c55e,#16a34a);
        color: white;
        font-size: 17px;
        font-weight: 900;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        box-shadow: 0 18px 38px rgba(34,197,94,.22);
        transition: .25s;
    }

        .btn-whatsapp-suporte:hover {
            transform: translateY(-2px);
            box-shadow: 0 24px 48px rgba(34,197,94,.28);
        }

        .btn-whatsapp-suporte i {
            font-size: 24px;
        }

    .info-suporte {
        margin-top: 22px;
        padding: 18px;
        border-radius: 20px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        text-align: left;
    }

        .info-suporte strong {
            display: block;
            color: #0f172a;
            font-size: 16px;
            margin-bottom: 6px;
        }

        .info-suporte p {
            margin: 0;
            color: #64748b;
            line-height: 1.6;
            font-size: 14px;
        }

    .rodape-suporte {
        display: flex;
        justify-content: center;
        margin-top: 22px;
    }

        .rodape-suporte a {
            color: #0ea5e9;
            text-decoration: none;
            font-weight: 800;
            background: white;
            border: 1px solid #dbeafe;
            border-radius: 16px;
            padding: 13px 18px;
            transition: .25s;
        }

            .rodape-suporte a:hover {
                transform: translateY(-2px);
                background: #f8fafc;
            }

    .alerta-erro {
        padding: 15px 18px;
        border-radius: 16px;
        margin-bottom: 20px;
        font-weight: 700;
        background: #fee2e2;
        color: #991b1b;
        border: 1px solid #fecaca;
        text-align: left;
    }

    @@media(max-width: 700px) {
        .suporte-page {
            padding: 24px 14px;
        }

        .suporte-card {
            padding: 30px 20px;
            border-radius: 28px;
        }

        .logo-suporte {
            width: 205px;
        }

        h1 {
            font-size: 31px;
        }

        .topo-suporte p {
            font-size: 15px;
        }

        .btn-whatsapp-suporte {
            min-height: 58px;
            font-size: 15px;
            border-radius: 18px;
        }

        .rodape-suporte a {
            width: 100%;
            text-align: center;
        }
    }

</style>