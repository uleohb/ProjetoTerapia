@page
@model ProjetoTerapia.Pages.LoginClinicaModel

@{
    ViewData["Title"] = "Login profissional";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />


<div class="container-auth">

    <div class="auth-wrapper">


        <!-- =================================================
             LADO ESQUERDO
        ================================================== -->

        <div class="side-login">

            <div class="gradient-circle circle-1"></div>
            <div class="gradient-circle circle-2"></div>


            <div class="content-side">

                <span class="badge-side">

                    <i class="fa-solid fa-heart-pulse"></i>

                    Plataforma para saúde emocional

                </span>


                <h1>
                    Bem-vindo de volta ao AlinhaVIDA.
                </h1>


                <p>
                    Acesse sua plataforma e continue conectando
                    pessoas, organizando seus atendimentos
                    e gerenciando sua presença profissional.
                </p>


                <div class="mini-cards">


                    <div class="mini-card">

                        <div class="mini-icon">

                            <i class="fa-solid fa-shield-halved"></i>

                        </div>

                        <div>

                            <strong>
                                Ambiente seguro
                            </strong>

                            <small>
                                Proteção e privacidade
                            </small>

                        </div>

                    </div>


                    <div class="mini-card">

                        <div class="mini-icon">

                            <i class="fa-regular fa-calendar-check"></i>

                        </div>

                        <div>

                            <strong>
                                Gestão inteligente
                            </strong>

                            <small>
                                Organize seus atendimentos
                            </small>

                        </div>

                    </div>


                    <div class="mini-card">

                        <div class="mini-icon">

                            <i class="fa-solid fa-users"></i>

                        </div>

                        <div>

                            <strong>
                                Conexões humanas
                            </strong>

                            <small>
                                Aproximando pacientes e profissionais
                            </small>

                        </div>

                    </div>


                </div>

            </div>

        </div>


        <!-- =================================================
             LADO DIREITO
        ================================================== -->

        <div class="card-auth">


            <img src="~/imagem/AlinhaVIDA.png"
                 asp-append-version="true"
                 class="logo-auth"
                 alt="AlinhaVIDA" />


            <h2>
                Entrar na plataforma
            </h2>


            <p class="sub">
                Entre com sua conta profissional para acessar
                seu painel e seus atendimentos.
            </p>


            <!-- =================================================
                 GOOGLE
            ================================================== -->

            <a asp-page="/LoginClinica"
               asp-page-handler="LoginGoogle"
               class="btn-google"
               id="btnGoogle">

                <span class="google-icon-area">

                    <i class="fa-brands fa-google"></i>

                </span>

                <span>
                    Continuar com Google
                </span>

            </a>


            <!--
                IMPORTANTE:

                NÃO existe onclick no botão Google.

                Portanto o carregamento NÃO aparece antes
                da pessoa escolher uma conta.

                Ele só aparecerá quando o Google retornar
                para o AlinhaVIDA.
            -->


            <div class="divider">

                <span>
                    ou
                </span>

            </div>


            <!-- =================================================
                 ERRO
            ================================================== -->

            @if (!string.IsNullOrWhiteSpace(Model.Erro))
            {
                <div class="validation-box">

                    <i class="fa-solid fa-circle-exclamation"></i>

                    <p>
                        @Model.Erro
                    </p>

                </div>
            }


            <!-- =================================================
                 LOGIN NORMAL
            ================================================== -->

            <form method="post"
                  id="formLoginNormal"
                  onsubmit="mostrarCarregamentoLoginNormal()">


                <div class="campo-login">

                    <label asp-for="Email">
                        Email
                    </label>


                    <div class="input-wrapper">

                        <i class="fa-regular fa-envelope"></i>


                        <input type="email"
                               asp-for="Email"
                               placeholder="seuemail@exemplo.com"
                               autocomplete="email"
                               required />

                    </div>

                </div>


                <div class="campo-login">

                    <label asp-for="Senha">
                        Senha
                    </label>


                    <div class="input-wrapper">

                        <i class="fa-solid fa-lock"></i>


                        <input type="password"
                               asp-for="Senha"
                               id="campoSenha"
                               placeholder="Digite sua senha"
                               autocomplete="current-password"
                               required />


                        <button type="button"
                                class="btn-ver-senha"
                                onclick="alternarSenha()"
                                aria-label="Mostrar ou ocultar senha">

                            <i class="fa-regular fa-eye"
                               id="iconeSenha"></i>

                        </button>

                    </div>

                </div>


                <button type="submit"
                        class="btn-primary"
                        id="btnLoginNormal">

                    Entrar

                </button>


                <a asp-page="/RecuperarSenha"
                   class="link-recuperar">

                    Esqueci minha senha

                </a>

            </form>


            <p class="link-login">

                Ainda não possui conta?

                <a asp-page="/CadastroConta">
                    Criar conta
                </a>

            </p>

        </div>

    </div>

</div>


<!-- =========================================================
     FORMULÁRIO INTERNO DO GOOGLE
========================================================= -->

@if (Model.ProcessandoGoogle)
{
    /*
     * Esta página só chega aqui DEPOIS que a pessoa
     * selecionou sua conta no Google.
     *
     * O navegador primeiro renderiza a tela de carregamento.
     * Logo depois este formulário é enviado automaticamente
     * para finalizar a consulta ao banco.
     */

    <form method="post"
          asp-page-handler="FinalizarGoogle"
          id="formFinalizarGoogle"
          class="form-processamento-google">

    </form>
}


<!-- =========================================================
     CARREGAMENTO
========================================================= -->

<div id="carregamentoLogin"
     class="carregamento-login @(Model.ProcessandoGoogle ? "ativo" : "")"
     role="status"
     aria-live="polite">


    <div class="loading-card">


        <div class="spinner-login"></div>


        @if (Model.ProcessandoGoogle)
        {
            <h3>
                Entrando na sua conta...
            </h3>

            <p>
                Sua conta Google foi confirmada.
                Estamos preparando seu painel profissional.
            </p>
        }
        else
        {
            <h3>
                Entrando na sua conta...
            </h3>

            <p>
                Estamos validando seus dados com segurança.
            </p>
        }


        <small>
            Isso pode levar alguns segundos.
        </small>

    </div>

</div>


<style>

    /* =========================================================
       RESET
    ========================================================= */

    @@import url(
        'https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap'
    );


    * {
        margin: 0;

        padding: 0;

        box-sizing: border-box;

        font-family:
            'Poppins',
            sans-serif;
    }


    html,
    body {
        min-height: 100%;

        margin: 0;
    }


    body {
        overflow-x: hidden;

        background:
            linear-gradient(
                135deg,
                #06121f,
                #0b1b2b,
                #10263a
            );
    }


    .container,
    .container-fluid,
    main.pb-3 {
        width: 100% !important;

        max-width: 100% !important;

        margin: 0 !important;

        padding: 0 !important;
    }


    /* =========================================================
       LAYOUT
    ========================================================= */

    .container-auth {
        min-height: 100vh;

        display: flex;

        justify-content: center;

        align-items: center;

        padding: 40px;
    }


    .auth-wrapper {
        width: 100%;

        max-width: 1400px;

        min-height: 820px;

        display: flex;

        overflow: hidden;

        border-radius: 35px;

        background:
            rgba(255,255,255,.04);

        backdrop-filter:
            blur(10px);

        box-shadow:
            0 30px 80px
            rgba(0,0,0,.35);
    }


    /* =========================================================
       LADO ESQUERDO
    ========================================================= */

    .side-login {
        position: relative;

        width: 55%;

        overflow: hidden;

        display: flex;

        align-items: center;

        justify-content: center;

        padding: 70px;

        background:
            linear-gradient(
                135deg,
                #0f172a 0%,
                #111827 45%,
                #1e293b 100%
            );
    }


    .content-side {
        position: relative;

        z-index: 2;

        max-width: 540px;
    }


    .badge-side {
        display: inline-flex;

        align-items: center;

        gap: 8px;

        margin-bottom: 28px;

        padding: 10px 18px;

        border:
            1px solid
            rgba(255,255,255,.08);

        border-radius: 999px;

        background:
            rgba(255,255,255,.08);

        color: #cbd5e1;

        font-size: 13px;

        backdrop-filter:
            blur(12px);
    }


    .content-side h1 {
        margin-bottom: 24px;

        color: white;

        font-size: 56px;

        line-height: 1.06;

        font-weight: 700;

        letter-spacing: -2px;
    }


    .content-side > p {
        margin-bottom: 40px;

        color: #cbd5e1;

        font-size: 17px;

        line-height: 1.8;
    }


    .mini-cards {
        display: flex;

        flex-direction: column;

        gap: 16px;
    }


    .mini-card {
        display: flex;

        align-items: center;

        gap: 16px;

        padding: 18px;

        border:
            1px solid
            rgba(255,255,255,.08);

        border-radius: 20px;

        background:
            rgba(255,255,255,.06);

        backdrop-filter:
            blur(12px);
    }


    .mini-icon {
        width: 46px;
        height: 46px;

        flex-shrink: 0;

        display: flex;

        align-items: center;

        justify-content: center;

        border-radius: 14px;

        background:
            rgba(14,165,233,.15);

        color: #7dd3fc;

        font-size: 19px;
    }


    .mini-card strong {
        display: block;

        margin-bottom: 3px;

        color: white;
    }


    .mini-card small {
        color: #94a3b8;
    }


    .gradient-circle {
        position: absolute;

        border-radius: 50%;

        filter: blur(90px);
    }


    .circle-1 {
        width: 350px;
        height: 350px;

        top: -120px;
        left: -120px;

        background:
            rgba(37,99,235,.25);
    }


    .circle-2 {
        width: 300px;
        height: 300px;

        right: -100px;
        bottom: -100px;

        background:
            rgba(14,165,233,.20);
    }


    /* =========================================================
       LOGIN
    ========================================================= */

    .card-auth {
        width: 45%;

        max-width: 520px;

        margin: auto;

        padding: 40px;

        border-radius: 30px;

        background:
            rgba(255,255,255,.98);

        text-align: center;

        box-shadow:
            0 25px 60px
            rgba(0,0,0,.25);
    }


    .logo-auth {
        width: 260px;

        max-width: 100%;

        height: auto;

        margin-bottom: 12px;
    }


    .card-auth h2 {
        margin-bottom: 10px;

        color: #0f172a;

        font-size: 28px;
    }


    .sub {
        margin-bottom: 28px;

        color: #64748b;

        font-size: 14px;

        line-height: 1.7;
    }


    /* =========================================================
       GOOGLE
    ========================================================= */

    .btn-google {
        width: 100%;

        min-height: 54px;

        display: flex;

        align-items: center;

        justify-content: center;

        gap: 12px;

        padding: 14px 18px;

        border:
            1px solid #e2e8f0;

        border-radius: 14px;

        background: white;

        color: #334155;

        text-decoration: none;

        font-weight: 600;

        transition: .25s;
    }


    .btn-google:hover {
        color: #0f172a;

        transform:
            translateY(-2px);

        box-shadow:
            0 10px 22px
            rgba(0,0,0,.06);
    }


    .google-icon-area {
        color: #4285f4;

        font-size: 20px;
    }


    /* =========================================================
       DIVISOR
    ========================================================= */

    .divider {
        position: relative;

        margin: 25px 0;

        text-align: center;
    }


    .divider::before {
        content: "";

        position: absolute;

        width: 100%;
        height: 1px;

        top: 50%;
        left: 0;

        background: #e2e8f0;
    }


    .divider span {
        position: relative;

        padding: 0 14px;

        background: white;

        color: #94a3b8;

        font-size: 13px;
    }


    /* =========================================================
       CAMPOS
    ========================================================= */

    .campo-login {
        margin-bottom: 15px;

        text-align: left;
    }


    .campo-login label {
        display: block;

        margin-bottom: 7px;

        color: #334155;

        font-size: 13px;

        font-weight: 600;
    }


    .input-wrapper {
        position: relative;

        display: flex;

        align-items: center;
    }


    .input-wrapper > i {
        position: absolute;

        left: 16px;

        z-index: 2;

        color: #94a3b8;
    }


    .input-wrapper input {
        width: 100%;

        height: 54px;

        margin: 0;

        padding:
            0 48px 0 45px;

        border:
            1px solid #dbeafe;

        border-radius: 14px;

        background: #f8fafc;

        color: #0f172a;

        font-size: 14px;

        outline: none;

        transition: .2s;
    }


    .input-wrapper input:focus {
        border-color: #2563eb;

        background: white;

        box-shadow:
            0 0 0 4px
            rgba(37,99,235,.09);
    }


    .btn-ver-senha {
        position: absolute;

        right: 8px;

        width: 38px;
        height: 38px;

        display: flex;

        align-items: center;

        justify-content: center;

        border: none;

        background: transparent;

        color: #64748b;

        cursor: pointer;
    }


    /* =========================================================
       BOTÃO NORMAL
    ========================================================= */

    .btn-primary {
        width: 100%;

        min-height: 54px;

        margin-top: 5px;

        padding: 15px;

        border: none;

        border-radius: 14px;

        background:
            linear-gradient(
                135deg,
                #2563eb,
                #0ea5e9
            );

        color: white;

        font-size: 15px;

        font-weight: 700;

        cursor: pointer;

        transition: .25s;
    }


    .btn-primary:hover {
        transform:
            translateY(-2px);

        box-shadow:
            0 15px 30px
            rgba(37,99,235,.25);
    }


    .btn-primary:disabled {
        cursor: wait;

        opacity: .75;

        transform: none;
    }


    /* =========================================================
       LINKS
    ========================================================= */

    .link-recuperar {
        display: block;

        margin-top: 15px;

        color: #2563eb;

        text-decoration: none;

        font-size: 14px;

        font-weight: 600;
    }


    .link-login {
        margin-top: 22px;

        color: #64748b;

        font-size: 14px;
    }


    .link-login a {
        color: #2563eb;

        text-decoration: none;

        font-weight: 700;
    }


    /* =========================================================
       ERRO
    ========================================================= */

    .validation-box {
        display: flex;

        align-items: flex-start;

        gap: 9px;

        margin-bottom: 18px;

        padding: 13px 14px;

        border:
            1px solid
            rgba(239,68,68,.20);

        border-radius: 14px;

        background:
            rgba(239,68,68,.08);

        text-align: left;
    }


    .validation-box i {
        margin-top: 2px;

        color: #dc2626;
    }


    .validation-box p {
        margin: 0;

        color: #dc2626;

        font-size: 13px;

        line-height: 1.5;

        font-weight: 500;
    }


    /* =========================================================
       CARREGAMENTO
    ========================================================= */

    .carregamento-login {
        position: fixed;

        inset: 0;

        z-index: 99999;

        display: none;

        align-items: center;

        justify-content: center;

        padding: 24px;

        background:
            rgba(15,23,42,.72);

        backdrop-filter:
            blur(8px);
    }


    .carregamento-login.ativo {
        display: flex;
    }


    .loading-card {
        width: 100%;

        max-width: 430px;

        padding: 38px 30px;

        border:
            1px solid
            rgba(255,255,255,.7);

        border-radius: 26px;

        background: white;

        text-align: center;

        box-shadow:
            0 30px 80px
            rgba(0,0,0,.28);
    }


    .spinner-login {
        width: 58px;
        height: 58px;

        margin:
            0 auto 22px;

        border:
            5px solid #e2e8f0;

        border-top-color: #2563eb;

        border-radius: 50%;

        animation:
            girar .8s linear infinite;
    }


    .loading-card h3 {
        margin-bottom: 8px;

        color: #0f172a;

        font-size: 21px;
    }


    .loading-card p {
        margin-bottom: 12px;

        color: #64748b;

        font-size: 14px;

        line-height: 1.6;
    }


    .loading-card small {
        color: #94a3b8;

        font-size: 12px;
    }


    .form-processamento-google {
        display: none;
    }


    @@keyframes girar {

        to {
            transform:
                rotate(360deg);
        }

    }


    /* =========================================================
       RESPONSIVO
    ========================================================= */

    @@media (max-width: 900px) {

        .side-login {
            display: none;
        }


        .auth-wrapper {
            min-height: auto;

            background: transparent;

            box-shadow: none;
        }


        .card-auth {
            width: 100%;

            max-width: 520px;
        }


        .container-auth {
            padding: 20px;
        }

    }


    @@media (max-width: 520px) {

        .container-auth {
            padding: 14px;
        }


        .card-auth {
            padding:
                30px 20px;

            border-radius: 24px;
        }


        .logo-auth {
            width: 215px;
        }


        .card-auth h2 {
            font-size: 24px;
        }


        .loading-card {
            padding:
                32px 22px;

            border-radius: 22px;
        }

    }

</style>


<script>

    // =========================================================
    // LOGIN NORMAL
    // =========================================================

    function mostrarCarregamentoLoginNormal() {

        const carregamento =
            document.getElementById(
                "carregamentoLogin"
            );

        const botao =
            document.getElementById(
                "btnLoginNormal"
            );


        if (carregamento) {

            carregamento.classList.add(
                "ativo"
            );

        }


        if (botao) {

            botao.disabled = true;

            botao.textContent =
                "Entrando...";

        }

    }


    // =========================================================
    // MOSTRAR / OCULTAR SENHA
    // =========================================================

    function alternarSenha() {

        const campo =
            document.getElementById(
                "campoSenha"
            );

        const icone =
            document.getElementById(
                "iconeSenha"
            );


        if (!campo || !icone) {
            return;
        }


        if (campo.type === "password") {

            campo.type = "text";

            icone.classList.remove(
                "fa-eye"
            );

            icone.classList.add(
                "fa-eye-slash"
            );

        }
        else {

            campo.type = "password";

            icone.classList.remove(
                "fa-eye-slash"
            );

            icone.classList.add(
                "fa-eye"
            );

        }

    }


    // =========================================================
    // GOOGLE
    // =========================================================

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            const formularioGoogle =
                document.getElementById(
                    "formFinalizarGoogle"
                );


            /*
             * Se este formulário existe, significa que:
             *
             * 1. Google já autenticou;
             * 2. usuário já escolheu a conta;
             * 3. tela de carregamento já está visível.
             *
             * Agora começamos o trabalho no banco.
             */

            if (formularioGoogle) {

                requestAnimationFrame(
                    function () {

                        setTimeout(
                            function () {

                                formularioGoogle.submit();

                            },
                            150
                        );

                    }
                );

            }

        }
    );


    // =========================================================
    // VOLTAR DO CACHE DO NAVEGADOR
    // =========================================================

    window.addEventListener(
        "pageshow",
        function () {

            const formularioGoogle =
                document.getElementById(
                    "formFinalizarGoogle"
                );


            /*
             * Se NÃO estamos processando Google,
             * removemos qualquer overlay antigo que
             * possa ter sido restaurado pelo navegador.
             */

            if (!formularioGoogle) {

                const carregamento =
                    document.getElementById(
                        "carregamentoLogin"
                    );


                const botao =
                    document.getElementById(
                        "btnLoginNormal"
                    );


                if (carregamento) {

                    carregamento.classList.remove(
                        "ativo"
                    );

                }


                if (botao) {

                    botao.disabled = false;

                    botao.textContent =
                        "Entrar";

                }

            }

        }
    );

</script>