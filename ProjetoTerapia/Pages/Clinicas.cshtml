@page
@model ProjetoTerapia.Pages.ClinicasModel

@using System
@using System.Linq

@{
    ViewData["Title"] = "Profissionais";
}

<div class="clinicas-page">

    <!-- =====================================================
         HEADER
    ====================================================== -->

    <header class="header-clinicas">

        <a asp-page="/Teste"
           class="logo-header"
           aria-label="Ir para o início">

            <img src="~/imagem/AlinhaVIDA.png"
                 asp-append-version="true"
                 alt="AlinhaVIDA" />

        </a>


        <div class="header-actions">

            <a asp-page="/Teste"
               class="header-link">

                Fazer teste emocional

            </a>


            @if (Model.PacienteLogado)
            {
                <a asp-page="/HomePaciente"
                   class="header-button">

                    Minha área

                </a>
            }
            else
            {
                <a asp-page="/LoginPaciente"
                   class="header-button">

                    Entrar como paciente

                </a>
            }

        </div>

    </header>


    <!-- =====================================================
         HERO / BUSCA
    ====================================================== -->

    <section class="hero-clinicas">

        <span class="badge">
            Profissionais disponíveis
        </span>


        <h1>
            Encontre apoio profissional para sua saúde emocional
        </h1>


        <p>
            Conheça profissionais e clínicas preparados para acompanhar você
            com cuidado, responsabilidade e acolhimento.
        </p>


        <form method="get"
              asp-page="/Clinicas"
              class="busca-clinica busca-clinica-avancada">


            <input type="text"
                   name="busca"
                   value="@Model.Busca"
                   placeholder="Buscar por nome, especialidade ou palavra-chave..."
                   autocomplete="off" />


            <input type="text"
                   name="cidade"
                   value="@Model.Cidade"
                   placeholder="Cidade ou região..."
                   autocomplete="off" />


            <select name="perfil"
                    aria-label="Especialidade">

                <option value="">
                    Todas as especialidades
                </option>

                <option value="Ansiedade"
                        selected="@(Model.Perfil == "Ansiedade")">
                    Ansiedade
                </option>

                <option value="Depressão"
                        selected="@(Model.Perfil == "Depressão")">
                    Depressão
                </option>

                <option value="Autoestima"
                        selected="@(Model.Perfil == "Autoestima")">
                    Autoestima
                </option>

                <option value="Relacionamentos"
                        selected="@(Model.Perfil == "Relacionamentos")">
                    Relacionamentos
                </option>

                <option value="Terapia"
                        selected="@(Model.Perfil == "Terapia")">
                    Terapia
                </option>

                <option value="Burnout"
                        selected="@(Model.Perfil == "Burnout")">
                    Burnout
                </option>

                <option value="Estresse"
                        selected="@(Model.Perfil == "Estresse")">
                    Estresse
                </option>

            </select>


            <select name="atendimento"
                    aria-label="Tipo de atendimento">

                <option value="">
                    Online/Presencial
                </option>

                <option value="Online"
                        selected="@(Model.Atendimento == "Online")">
                    Online
                </option>

                <option value="Presencial"
                        selected="@(Model.Atendimento == "Presencial")">
                    Presencial
                </option>

            </select>


            <button type="submit">

                <i class="fa-solid fa-magnifying-glass"></i>

                Buscar

            </button>


            <a asp-page="/Clinicas"
               class="btn-limpar-filtros">

                Limpar

            </a>

        </form>

    </section>


    <!-- =====================================================
         CONTEÚDO
    ====================================================== -->

    <main class="container-clinicas">


        <!-- =================================================
             TÍTULO DA LISTA
        ================================================== -->

        <div class="resultado-info">

            <div>

                <span>
                    Lista de profissionais
                </span>

                <h2>
                    Profissionais disponíveis
                </h2>

            </div>


            <p>
                Escolha um profissional e entre em contato
                para iniciar sua jornada de cuidado.
            </p>

        </div>


        <!-- =================================================
             NENHUM RESULTADO
        ================================================== -->

        @if (!Model.Clinicas.Any())
        {
            <div class="alerta-vazio">

                <div class="alerta-vazio-icone">

                    <i class="fa-regular fa-face-frown"></i>

                </div>

                <h3>
                    Nenhum profissional encontrado
                </h3>

                <p>
                    No momento não encontramos profissionais
                    com esses filtros. Tente outra especialidade,
                    cidade ou tipo de atendimento.
                </p>

                <a asp-page="/Clinicas"
                   class="btn-remover-filtros">

                    Remover filtros

                </a>

            </div>
        }


        <!-- =================================================
             GRID
        ================================================== -->

        <div class="grid-clinicas">

            @foreach (var clinica in Model.Clinicas)
            {
                /*
                 * =================================================
                 * PERFIL
                 * =================================================
                 */

                var perfilUrl =
                    Url.Page(
                        "/PerfilClinica",
                        new
                        {
                            id = clinica.Id
                        }
                    )
                    ?? $"/profissional/perfil?id={clinica.Id}";


                /*
                 * =================================================
                 * WHATSAPP
                 * =================================================
                 *
                 * Converte:
                 *
                 * (11) 99999-9999
                 *
                 * para:
                 *
                 * 5511999999999
                 */

                var telefoneWhatsapp =
                    new string(
                        (clinica.Telefone ?? "")
                            .Where(char.IsDigit)
                            .ToArray()
                    );


                /*
                 * Remove zeros de operadora/prefixo.
                 */

                telefoneWhatsapp =
                    telefoneWhatsapp.TrimStart('0');


                /*
                 * Se o número não começa com o código
                 * internacional do Brasil, adicionamos 55.
                 */

                if (!string.IsNullOrWhiteSpace(telefoneWhatsapp) &&
                    !telefoneWhatsapp.StartsWith("55"))
                {
                    telefoneWhatsapp =
                        "55" + telefoneWhatsapp;
                }


                /*
                 * Número brasileiro completo costuma possuir
                 * 12 ou 13 dígitos incluindo o 55.
                 */

                var whatsappDisponivel =
                    !string.IsNullOrWhiteSpace(telefoneWhatsapp) &&
                    telefoneWhatsapp.Length >= 12;


                var mensagemWhatsapp =
                    Uri.EscapeDataString(
                        "Olá! Encontrei seu perfil no AlinhaVIDA e gostaria de saber mais sobre o atendimento."
                    );


                var whatsappUrl =
                    whatsappDisponivel
                        ? $"https://wa.me/{telefoneWhatsapp}?text={mensagemWhatsapp}"
                        : "";


                /*
                 * =================================================
                 * INSTAGRAM
                 * =================================================
                 */

                var instagram =
                    clinica.Instagram?.Trim() ?? "";


                if (!string.IsNullOrWhiteSpace(instagram) &&
                    !instagram.StartsWith(
                        "http",
                        StringComparison.OrdinalIgnoreCase))
                {
                    instagram =
                        "https://instagram.com/" +
                        instagram.Replace("@", "");
                }


                /*
                 * =================================================
                 * SITE
                 * =================================================
                 */

                var site =
                    clinica.Site?.Trim() ?? "";


                if (!string.IsNullOrWhiteSpace(site) &&
                    !site.StartsWith(
                        "http",
                        StringComparison.OrdinalIgnoreCase))
                {
                    site =
                        "https://" + site;
                }


                /*
                 * =================================================
                 * INICIAL
                 * =================================================
                 */

                var inicial =
                    string.IsNullOrWhiteSpace(clinica.Nome)
                        ? "A"
                        : clinica.Nome
                            .Trim()
                            .Substring(0, 1)
                            .ToUpper();


                <!-- =================================================
                     CARD
                ================================================== -->

                <article class="card-clinica"
                         onclick="abrirPerfil(event, '@perfilUrl')">


                    <!-- TOPO -->

                    <div class="card-header">

                        @if (!string.IsNullOrWhiteSpace(
                            clinica.FotoPerfil))
                        {
                            <div class="avatar-clinica imagem">

                                <img src="@clinica.FotoPerfil"
                                     alt="@clinica.Nome"
                                     loading="lazy" />

                            </div>
                        }
                        else
                        {
                            <div class="avatar-clinica">

                                @inicial

                            </div>
                        }


                        <div class="card-identidade">

                            <h3>

                                @(string.IsNullOrWhiteSpace(
                                    clinica.Nome)

                                    ? "Profissional"
                                    : clinica.Nome)

                            </h3>


                            <span class="selo-verificado">

                                <i class="fa-solid fa-circle-check"></i>

                                Profissional verificado

                            </span>

                        </div>

                    </div>


                    <!-- DESCRIÇÃO -->

                    <p class="descricao">

                        @(string.IsNullOrWhiteSpace(
                            clinica.Descricao)

                            ? "Profissional disponível para atendimento na plataforma AlinhaVIDA."
                            : clinica.Descricao)

                    </p>


                    <!-- ESPECIALIDADES -->

                    @if (!string.IsNullOrWhiteSpace(
                        clinica.Especialidades))
                    {
                        var lista =
                            clinica.Especialidades
                                .Split(
                                    ',',
                                    StringSplitOptions.RemoveEmptyEntries
                                );


                        <div class="lista-especialidades">

                            @foreach (var esp in lista)
                            {
                                var especialidade =
                                    esp.Trim();


                                if (!string.IsNullOrWhiteSpace(
                                    especialidade))
                                {
                                    <span class="tag-especialidade">

                                        @especialidade

                                    </span>
                                }
                            }

                        </div>
                    }


                    <!-- DETALHES -->

                    <div class="detalhes-clinica">


                        @if (!string.IsNullOrWhiteSpace(
                            clinica.Cidade))
                        {
                            <div class="detalhe-item">

                                <span>
                                    Cidade
                                </span>

                                <strong>
                                    @clinica.Cidade
                                </strong>

                            </div>
                        }


                        <div class="detalhe-item">

                            <span>
                                Atendimento
                            </span>


                            <strong>

                                @if (clinica.AtendimentoOnline &&
                                     clinica.AtendimentoPresencial)
                                {
                                    <text>
                                        Online e presencial
                                    </text>
                                }
                                else if (clinica.AtendimentoOnline)
                                {
                                    <text>
                                        Online
                                    </text>
                                }
                                else if (clinica.AtendimentoPresencial)
                                {
                                    <text>
                                        Presencial
                                    </text>
                                }
                                else
                                {
                                    <text>
                                        A consultar
                                    </text>
                                }

                            </strong>

                        </div>


                        @if (!string.IsNullOrWhiteSpace(
                            clinica.Endereco))
                        {
                            <div class="detalhe-item detalhe-endereco">

                                <span>
                                    Endereço
                                </span>

                                <strong>
                                    @clinica.Endereco
                                </strong>

                            </div>
                        }

                    </div>


                    <!-- =================================================
                         AÇÕES
                    ================================================== -->

                    <div class="acoes-card">


                        <!-- PERFIL -->

                        <a asp-page="/PerfilClinica"
                           asp-route-id="@clinica.Id"
                           class="btn-acao-card btn-perfil-card"
                           title="Ver perfil"
                           aria-label="Ver perfil de @clinica.Nome">

                            <i class="fa-regular fa-user"></i>

                        </a>


                        <!-- WHATSAPP -->

                        @if (whatsappDisponivel)
                        {
                            <a href="@whatsappUrl"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="btn-acao-card btn-whatsapp"
                               title="WhatsApp"
                               aria-label="Conversar com @clinica.Nome pelo WhatsApp">

                                <i class="fa-brands fa-whatsapp"></i>

                            </a>
                        }


                        <!-- INSTAGRAM -->

                        @if (!string.IsNullOrWhiteSpace(instagram))
                        {
                            <a href="@instagram"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="btn-acao-card btn-instagram"
                               title="Instagram"
                               aria-label="Instagram de @clinica.Nome">

                                <i class="fa-brands fa-instagram"></i>

                            </a>
                        }


                        <!-- SITE -->

                        @if (!string.IsNullOrWhiteSpace(site))
                        {
                            <a href="@site"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="btn-acao-card btn-site"
                               title="Site"
                               aria-label="Site de @clinica.Nome">

                                <i class="fa-solid fa-globe"></i>

                            </a>
                        }

                    </div>

                </article>
            }

        </div>


        <!-- =================================================
             CTA PACIENTE
        ================================================== -->

        @if (!Model.PacienteLogado)
        {
            <section class="cta-paciente">

                <div>

                    <span>
                        Área do paciente
                    </span>

                    <h2>
                        Quer acompanhar sua evolução emocional?
                    </h2>

                    <p>
                        Crie uma conta gratuita para registrar seus sentimentos,
                        salvar sua jornada e acessar sua área pessoal
                        dentro da plataforma.
                    </p>

                </div>


                <div class="cta-actions">

                    <a asp-page="/CadastroPaciente"
                       class="btn-criar-conta">

                        Criar conta gratuita

                    </a>


                    <a asp-page="/LoginPaciente"
                       class="btn-login">

                        Já tenho conta

                    </a>

                </div>

            </section>
        }


        <!-- =================================================
             CTA PROFISSIONAL
        ================================================== -->

        <section class="area-profissional">

            <div>

                <span>
                    Para profissionais
                </span>

                <h3>
                    É profissional ou possui clínica?
                </h3>

                <p>
                    Cadastre-se na plataforma e aumente sua
                    visibilidade para pacientes que buscam
                    apoio emocional.
                </p>

            </div>


            <a asp-page="/CadastroConta"
               class="btn-cadastro">

                Cadastrar minha clínica

            </a>

        </section>

    </main>

</div>


<!-- =========================================================
     SCRIPT
========================================================= -->

<script>

    /*
     * O card inteiro abre o perfil.
     *
     * Porém, se o usuário clicar em um botão/âncora
     * dentro do card, deixamos o link executar normalmente.
     */

    function abrirPerfil(event, url) {

        if (
            event.target.closest("a") ||
            event.target.closest("button") ||
            event.target.closest("form")
        ) {
            return;
        }

        window.location.href = url;
    }


    /*
     * Evita que cliques nos botões internos
     * disparem o clique do card.
     */

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            const links =
                document.querySelectorAll(
                    ".acoes-card a"
                );

            links.forEach(function (link) {

                link.addEventListener(
                    "click",
                    function (event) {

                        event.stopPropagation();

                    }
                );

            });

        }
    );

</script>


<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />


<style>

    /* =========================================================
       FONTE / RESET
    ========================================================= */

    @@import url(
        'https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap'
    );


    * {
        box-sizing: border-box;
    }


    html,
    body {
        width: 100%;
        min-height: 100%;

        margin: 0;
        padding: 0;

        background: #ecfeff;

        color: #0f172a;

        overflow-x: hidden;
    }


    body {
        font-family:
            'Poppins',
            'Segoe UI',
            sans-serif;
    }


    a {
        text-decoration: none;
    }


    .container,
    .container-fluid,
    main.pb-3 {
        width: 100% !important;

        max-width: 100% !important;

        margin: 0 !important;

        padding: 0 !important;

        background: transparent !important;
    }


    /* =========================================================
       PÁGINA
    ========================================================= */

    .clinicas-page {
        width: 100%;

        min-height: 100vh;

        padding-bottom: 60px;

        background:
            radial-gradient(
                circle at top left,
                rgba(20,184,166,.14),
                transparent 34%
            ),
            radial-gradient(
                circle at bottom right,
                rgba(14,165,233,.10),
                transparent 36%
            ),
            linear-gradient(
                135deg,
                #ecfeff 0%,
                #f8fcff 52%,
                #eef7ff 100%
            );
    }


    .container-clinicas {
        width: 100%;

        max-width: 1280px;

        margin: 0 auto;

        padding: 22px 24px;
    }


    /* =========================================================
       HEADER
    ========================================================= */

    .header-clinicas {
        max-width: 1180px;

        margin: auto;

        padding: 24px 24px 0;

        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 20px;
    }


    .logo-header {
        display: inline-block;

        border: none;

        background: transparent;
    }


    .logo-header img {
        width: 220px;

        max-width: 100%;

        height: auto;

        display: block;
    }


    .header-actions {
        display: flex;

        align-items: center;

        gap: 14px;
    }


    .header-link {
        color: #0f766e;

        font-weight: 700;

        transition: .2s;
    }


    .header-link:hover {
        color: #0ea5e9;
    }


    .header-button {
        padding: 13px 18px;

        border-radius: 16px;

        background:
            linear-gradient(
                135deg,
                #14b8a6,
                #0ea5e9
            );

        color: white;

        font-weight: 800;

        box-shadow:
            0 14px 30px
            rgba(14,165,233,.18);

        transition: .25s;
    }


    .header-button:hover {
        color: white;

        transform: translateY(-2px);

        box-shadow:
            0 18px 36px
            rgba(14,165,233,.24);
    }


    /* =========================================================
       HERO
    ========================================================= */

    .hero-clinicas {
        max-width: 1180px;

        margin: auto;

        padding: 55px 24px 35px;

        text-align: center;
    }


    .badge {
        display: inline-block;

        margin-bottom: 22px;

        padding: 9px 16px;

        border-radius: 999px;

        background: #ccfbf1;

        color: #0f766e;

        font-size: 13px;

        font-weight: 800;
    }


    .hero-clinicas h1 {
        max-width: 900px;

        margin:
            0 auto 18px;

        color: #0f172a;

        font-size: 46px;

        line-height: 1.12;

        letter-spacing: -1px;
    }


    .hero-clinicas > p {
        max-width: 760px;

        margin: auto;

        color: #64748b;

        font-size: 18px;

        line-height: 1.7;
    }


    /* =========================================================
       BUSCA
    ========================================================= */

    .busca-clinica {
        margin:
            36px auto 0;

        display: grid;

        grid-template-columns:
            1.3fr
            1fr
            1fr
            .8fr
            auto
            auto;

        gap: 12px;

        padding: 16px;

        align-items: stretch;

        border:
            1px solid #e2e8f0;

        border-radius: 24px;

        background:
            rgba(255,255,255,.94);

        box-shadow:
            0 20px 55px
            rgba(15,23,42,.08);

        backdrop-filter:
            blur(14px);
    }


    .busca-clinica input,
    .busca-clinica select {
        width: 100%;

        min-width: 0;

        padding: 16px;

        border:
            1px solid #dbeafe;

        border-radius: 16px;

        outline: none;

        background: #f8fafc;

        color: #334155;

        font-size: 15px;

        transition: .2s;
    }


    .busca-clinica input:focus,
    .busca-clinica select:focus {
        border-color: #0ea5e9;

        background: white;

        box-shadow:
            0 0 0 4px
            rgba(14,165,233,.10);
    }


    .busca-clinica button {
        display: inline-flex;

        align-items: center;

        justify-content: center;

        gap: 8px;

        padding: 0 24px;

        border: none;

        border-radius: 16px;

        background:
            linear-gradient(
                135deg,
                #14b8a6,
                #0ea5e9
            );

        color: white;

        font-weight: 800;

        cursor: pointer;

        white-space: nowrap;

        transition: .25s;
    }


    .busca-clinica button:hover {
        transform: translateY(-2px);

        box-shadow:
            0 14px 28px
            rgba(14,165,233,.20);
    }


    .btn-limpar-filtros {
        display: flex;

        align-items: center;

        justify-content: center;

        padding: 0 20px;

        border:
            1px solid #dbeafe;

        border-radius: 16px;

        background: #f8fafc;

        color: #0ea5e9;

        font-weight: 800;

        white-space: nowrap;

        transition: .25s;
    }


    .btn-limpar-filtros:hover {
        background: white;

        color: #0284c7;

        transform: translateY(-2px);

        box-shadow:
            0 14px 28px
            rgba(15,23,42,.08);
    }


    /* =========================================================
       TÍTULO RESULTADO
    ========================================================= */

    .resultado-info {
        display: flex;

        align-items: flex-end;

        justify-content: space-between;

        gap: 20px;

        margin-bottom: 24px;
    }


    .resultado-info span,
    .cta-paciente span,
    .area-profissional span {
        color: #0ea5e9;

        font-size: 13px;

        font-weight: 800;

        text-transform: uppercase;

        letter-spacing: .5px;
    }


    .resultado-info h2 {
        margin:
            6px 0 0;

        color: #0f172a;

        font-size: 27px;
    }


    .resultado-info p {
        max-width: 420px;

        margin: 0;

        color: #64748b;

        line-height: 1.6;
    }


    /* =========================================================
       SEM RESULTADOS
    ========================================================= */

    .alerta-vazio {
        margin-bottom: 30px;

        padding: 40px 30px;

        border:
            1px dashed #cbd5e1;

        border-radius: 26px;

        background:
            rgba(255,255,255,.94);

        text-align: center;
    }


    .alerta-vazio-icone {
        width: 58px;
        height: 58px;

        margin:
            0 auto 16px;

        display: flex;

        align-items: center;

        justify-content: center;

        border-radius: 18px;

        background: #ecfeff;

        color: #0ea5e9;

        font-size: 25px;
    }


    .alerta-vazio h3 {
        margin:
            0 0 8px;
    }


    .alerta-vazio p {
        max-width: 580px;

        margin:
            0 auto 20px;

        color: #64748b;

        line-height: 1.6;
    }


    .btn-remover-filtros {
        display: inline-flex;

        padding: 12px 18px;

        border-radius: 14px;

        background: #0ea5e9;

        color: white;

        font-weight: 700;
    }


    /* =========================================================
       GRID
    ========================================================= */

    .grid-clinicas {
        display: grid;

        grid-template-columns:
            repeat(
                3,
                minmax(280px, 1fr)
            );

        gap: 18px;
    }


    /* =========================================================
       CARD
    ========================================================= */

    .card-clinica {
        position: relative;

        padding: 18px;

        overflow: hidden;

        border:
            1px solid #e2e8f0;

        border-radius: 22px;

        background:
            rgba(255,255,255,.96);

        cursor: pointer;

        box-shadow:
            0 14px 34px
            rgba(15,23,42,.06);

        transition: .25s;
    }


    .card-clinica:hover {
