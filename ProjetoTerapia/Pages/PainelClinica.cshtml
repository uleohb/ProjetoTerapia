    /* =========================================================
           ANIMAÇÃO PREMIUM DO ÍCONE DE LOCALIZAÇÃO
           - sem bolinha no canto
           - aura suave expandindo em volta do bloco
           - funciona no ícone do Clube de Descontos
        ========================================================= */

    .clube-topo-icone,
    .icone-localizacao {
        position: relative;
        overflow: visible;
        isolation: isolate;
        animation: flutuarLocalizacao 3.2s ease-in-out infinite;
    }

        .clube-topo-icone::before,
        .icone-localizacao::before {
            content: "";
            position: absolute;
            inset: -14px;
            border-radius: 32px;
            background: radial-gradient(circle, rgba(34,197,94,.34) 0%, rgba(34,197,94,.18) 38%, rgba(34,197,94,.06) 62%, rgba(34,197,94,0) 78%);
            filter: blur(7px);
            opacity: .75;
            z-index: -1;
            animation: auraVerdeSuave 2.8s ease-in-out infinite;
        }

        .clube-topo-icone::after,
        .icone-localizacao::after {
            content: "";
            position: absolute;
            inset: -18px;
            border-radius: 36px;
            border: 2px solid rgba(34,197,94,.22);
            opacity: 0;
            z-index: -2;
            animation: anelVerdeExpandindo 2.8s ease-out infinite;
        }

        .clube-topo-icone i,
        .icone-localizacao i {
            position: relative;
            z-index: 2;
        }

    .sinal-clube {
        display: none;
    }

    @@keyframes auraVerdeSuave {
        0%, 100% {
            transform: scale(.96);
            opacity: .42;
        }

        50% {
            transform: scale(1.12);
            opacity: .78;
        }
    }

    @@keyframes anelVerdeExpandindo {
        0% {
            transform: scale(.88);
            opacity: .45;
        }

        70% {
            transform: scale(1.22);
            opacity: 0;
        }

        100% {
            transform: scale(1.22);
            opacity: 0;
        }
    }

    @@keyframes flutuarLocalizacao {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-3px);
        }
    }

