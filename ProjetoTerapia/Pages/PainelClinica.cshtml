@page
@model ProjetoTerapia.Pages.PainelClinicaModel

@functions {
    bool PlanoRegionalAtivo(int quantidade)
    {
        return Model.DivulgacaoRegionalAtiva != null &&
               Model.DivulgacaoRegionalAtiva.QuantidadeCidades == quantidade;
    }
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<div class="painel-container" id="topoPainel">

    <div class="rgb rgb-1"></div>
    <div class="rgb rgb-2"></div>
    <div class="rgb rgb-3"></div>

    <div class="painel-container">

        @if (Model.Clinica != null)
        {
            <header class="topo-painel">

                <div class="topo-esquerda">

                    <img src="/imagem/logo.png"
                         class="logo-painel"
                         alt="AlinhaMente" />

                    <div>
                        <span class="badge-painel">
                            Painel profissional
                        </span>

                        <h1>
                            @(string.IsNullOrEmpty(Model.Clinica.Nome)
                                                    ? "Profissional"
                                                    : Model.Clinica.Nome)
                    </h1>

                        <p>
                            Gerencie seu perfil, acompanhe seus resultados e organize seus atendimentos.
                        </p>
                    </div>

                </div>

                <div class="topo-acoes">

                    <a href="/Clinicas" class="btn-topo secundario">
                        Ver vitrine pública
                    </a>

                    <a href="/Teste" class="btn-topo principal">
                        Voltar ao site
                    </a>

                </div>

            </header>

        @if (Model.AlteracaoPendente != null)
            {
                <div class="alerta-alteracao analise">
                    <div class="alerta-alteracao-icone">
                        <i class="fa-regular fa-clock"></i>
                    </div>

                    <div>
                        <strong>Alterações em análise</strong>
                        <p>
                            Suas alterações foram enviadas com sucesso e estão aguardando aprovação da nossa equipe.
                        </p>
                    </div>
                </div>
            }

            @if (Model.AlteracaoRecusada != null)
            {
                <div class="alerta-recusa-compacto">

                    <form method="post"
                          asp-page-handler="ExcluirAlteracaoRecusada"
                          class="form-fechar-recusa"
                          onsubmit="sessionStorage.setItem('voltarTopoPainel', '1')">

                        <input type="hidden"
                               name="alteracaoId"
                               value="@Model.AlteracaoRecusada.Id" />

                        <button type="submit"
                                class="btn-fechar-recusa"
                                title="Remover aviso">
                            ×
                        </button>

                    </form>

                    <div class="recusa-icone">
                        <i class="fa-solid fa-circle-exclamation"></i>
                    </div>

                    <div class="recusa-conteudo">

                        <strong>
                            Alterações recusadas
                        </strong>

                        <p>
                            @(string.IsNullOrWhiteSpace(Model.AlteracaoRecusada.MotivoRecusa)
                                                ? "Suas alterações não foram aprovadas pela nossa equipe."
                                                : Model.AlteracaoRecusada.MotivoRecusa)
                </p>

                        <a href="/CadastroClinica" class="btn-corrigir-recusa">
                            Corrigir alterações
                        </a>

                    </div>

                </div>
                }

        @if (!Model.Clinica!.Aprovado)
            {
                <section class="alerta status-analise">

                    <div class="alerta-icone">
                        <i class="fa-solid fa-hourglass-half"></i>
                    </div>

                    <div>
                        <h2>Cadastro em análise</h2>

                        <p>
                            Sua clínica está aguardando aprovação. Assim que for aprovada,
                            você poderá ativar seu plano e aparecer na vitrine da plataforma.
                        </p>
                    </div>

                </section>
            }

            @if (Model.Clinica!.Aprovado && !Model.Clinica.Pago)
            {
                <section class="alerta status-aprovado">

                    <div class="alerta-icone">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>

                    <div>
                        <h2>Sua clínica foi aprovada</h2>

                        <p>
                            Seu perfil está pronto. Ative seu plano para começar a receber pacientes.
                        </p>
                    </div>

                    <a href="/PagamentoClinica" class="btn-alerta">
                        Ativar plano
                    </a>

                </section>
            }

            @if (Model.Clinica!.Pago)
            {
                <section class="alerta status-ativo">

                    <div class="alerta-icone">
                        <i class="fa-solid fa-shield-heart"></i>
                    </div>

                    <div>
                        <h2>Plano ativo</h2>

                        <p>
                            Sua clínica está disponível para receber pacientes na plataforma.
                        </p>
                    </div>

                </section>
            }

            @if (Model.Clinica != null && Model.Clinica.Pago && Model.DiasRestantes.HasValue && Model.DiasRestantes <= 30 && !Model.PlanoVencido)
            {
                <section class="alerta-vencimento">

                    <h2>
                        Seu plano está perto de vencer
                    </h2>

                    <p>
                        Faltam @Model.DiasRestantes dia(s) para o vencimento do seu plano.
                        Faça a renovação para manter seu perfil ativo na plataforma.
                    </p>

                    <a href="/PagamentoClinica">
                        Renovar plano
                    </a>

                </section>
            }

            @if (Model.Clinica != null && Model.Clinica.Pago && Model.PlanoVencido)
            {
                <section class="alerta-vencimento vencido">

                    <h2>
                        Plano vencido
                    </h2>

                    <p>
                        Seu plano venceu. Renove para manter seu perfil disponível aos pacientes.
                    </p>

                    <a href="/PagamentoClinica">
                        Regularizar plano
                    </a>

                </section>
            }

            @if (Model.Clinica != null && !Model.Clinica.PerfilCompleto)
            {
                <section class="alerta-perfil">

                    <div>
                        <span>Perfil incompleto</span>

                        <h2>Finalize seu cadastro profissional</h2>

                        <p>
                            Adicione suas informações, especialidades, cidade, formas de atendimento
                            e dados públicos para que sua clínica possa ser exibida corretamente.
                        </p>
                    </div>

                    <a href="/CadastroClinica" class="btn-completar">
                        Completar perfil
                    </a>

                </section>
            }

        <section class="dashboard-hero">

            <div class="hero-info">

                <span>Resumo profissional</span>

                <h2>
                    Seu desempenho na plataforma
                </h2>

                <p>
                    Acompanhe visualizações, contatos iniciados, status financeiro
                    e oportunidades para aparecer em mais regiões.
                </p>

            </div>

            <div class="hero-status">

                <span>Status atual</span>

                <strong class="status-texto @(Model.Clinica != null && Model.Clinica.Pago ? "ativo" : "pendente")">
                    @Model.StatusPlano
                </strong>

                <small>
                    Perfil público:
                    @(Model.PerfilPublicoAtivo ? "ativo" : "não ativo")
                </small>

            </div>

        </section>

        <section class="kpi-grid">

            <div class="kpi-card">

                <div class="kpi-icon">
                    <i class="fa-solid fa-eye"></i>
                </div>

                <span>Visualizações</span>

                <strong>@Model.Visualizacoes</strong>

                <p>
                    Quantidade de acessos ao seu perfil público.
                </p>

            </div>

            <div class="kpi-card">

                <div class="kpi-icon">
                    <i class="fa-brands fa-whatsapp"></i>
                </div>

                <span>Contatos iniciados</span>

                <strong>@Model.CliquesWhatsapp</strong>

                <p>
                    Cliques no botão de WhatsApp do seu perfil.
                </p>

            </div>

            <div class="kpi-card">

                <div class="kpi-icon">
                    <i class="fa-solid fa-chart-line"></i>
                </div>

                <span>Conversão</span>

                <strong>@Model.TaxaConversao%</strong>

                <p>
                    Relação entre visualizações e contatos recebidos.
                </p>

            </div>

            <div class="kpi-card">

                <div class="kpi-icon">
                    <i class="fa-solid fa-calendar-check"></i>
                </div>

                <span>Vencimento</span>

                <strong>
                    @(Model.DiasRestantes.HasValue
                                        ? (Model.PlanoVencido ? "Vencido" : $"{Model.DiasRestantes} dias")
                                        : "Sem plano")
                                                  </strong>

                <p>
                    Data: @Model.DataVencimentoFormatada
                </p>

            </div>

        </section>

        <section class="conteudo-grid">

            <div class="painel-bloco financeiro">

                <div class="bloco-topo">

                    <div>
                        <span>Financeiro</span>

                        <h2>Assinatura e pagamentos</h2>

                        <p>
                            Acompanhe o status do seu plano e informações básicas de pagamento.
                        </p>
                    </div>

                    <div class="icone-bloco">
                        <i class="fa-solid fa-wallet"></i>
                    </div>

                </div>

                <div class="financeiro-grid">

                    <div>
                        <small>Plano atual</small>
                        <strong>@Model.NomePlanoPrincipalFormatado</strong>
                    </div>

                    <div>
                        <small>Valor do plano</small>
                        <strong>@Model.ValorPlanoFormatado</strong>
                    </div>

                    <div>
                        <small>Pagamento confirmado</small>
                        <strong>
                            @(Model.Clinica!.DataPagamento.HasValue
                                                        ? Model.Clinica!.DataPagamento.Value.ToString("dd/MM/yyyy")
                                                        : "Pendente")
                        </strong>
                    </div>

                        <div>
                            <small>Vencimento</small>
                            <strong>@Model.DataVencimentoFormatada</strong>
                        </div>

                </div>

                @if (Model.DivulgacaoRegionalAtiva != null)
                    {
                        <div class="divulgacao-regional-ativa-box">
                            <span>Divulgação regional ativa</span>

                            <strong>@Model.NomePlanoRegionalFormatado</strong>

                            <p>
                                Cidades: @Model.CidadesPlanoRegional
                            </p>

                            <small>
                                Ativo até @Model.DataFimPlanoRegionalFormatada
                                @if (Model.DiasRestantesPlanoRegional.HasValue)
                                {
                                    <text> — @Model.DiasRestantesPlanoRegional dia(s) restante(s)</text>
                                }
                            </small>
                        </div>
                    }

                    <div class="bloco-acoes">

                        <a href="/PagamentoClinica" class="btn-bloco principal">
                            Gerenciar plano
                        </a>

                        <a href="/Suporte" class="btn-bloco secundario">
                            Falar com suporte
                        </a>

                    </div>

                    <div class="chamada-financeiro">
                        <strong>Seu perfil ativo aumenta sua presença na plataforma.</strong>

                        <p>
                            Mantenha seu plano em dia para continuar aparecendo para pacientes e liberar recursos de divulgação regional.
                        </p>
                    </div>

                </div>

            @if (Model.Clinica?.Pago == true)
                {
                    <section class="painel-bloco clube-descontos" id="clube-descontos">

                        <div class="clube-topo">
                            <div class="clube-titulos">
                                <span class="clube-label">Clube de descontos</span>

                                <h2>Apareça em mais cidades</h2>

                                <p>
                                    Sua cidade principal já está inclusa no plano.
                                    Escolha cidades adicionais para aumentar sua visibilidade
                                    e receber novos pacientes em outras regiões.
                                </p>
                            </div>

                            <div class="icone-bloco destaque icone-localizacao">
                                <i class="fa-solid fa-location-dot"></i>
                            </div>
                        </div>

                        @{
                            /*
                            Cidades liberadas neste momento para o Clube de Descontos.
                            A cidade principal da clínica já está inclusa no plano profissional,
                            então ela não entra como cidade adicional.
                            */
                            var cidadesLiberadasClube = new List<string>
                                {
                                "Osasco",
                                "Barueri",
                                "São Paulo"
                                };

                            var cidadePrincipalClube = Model.Clinica?.Cidade?.Trim() ?? "";

                            var cidadesAdicionaisDisponiveis = cidadesLiberadasClube
                            .Where(c => !string.Equals(c, cidadePrincipalClube, StringComparison.OrdinalIgnoreCase))
                            .ToList();

                            var quantidadeAdicionaisDisponiveis = cidadesAdicionaisDisponiveis.Count;
                        }

                        <div class="clube-info-compacto">

                            <div>
                                <h3>Cidades adicionais</h3>

                                <p>
                                    Disponível agora para Osasco, Barueri e São Paulo.
                                    Sua cidade principal já está inclusa no plano profissional.
                                </p>
                            </div>

                            <div class="cidades-liberadas-mini">

                                @foreach (var cidade in cidadesLiberadasClube)
                                {
                                    if (string.Equals(cidade, cidadePrincipalClube, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="cidade-mini principal">
                                            @cidade
                                            <small>Principal</small>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="cidade-mini">
                                            @cidade
                                        </span>
                                    }
                                }

                            </div>

                        </div>

                        <div class="clube-grid-compacto">

                            @if (quantidadeAdicionaisDisponiveis >= 1)
                            {
                                <div class="clube-item compacto @(PlanoRegionalAtivo(1) ? "ativo" : "")">

                                    <div>
                                        <span class="clube-qtd">+1 cidade</span>

                                        <strong>R$ 30</strong>

                                        <small>
                                            Escolha 1 cidade adicional.
                                        </small>
                                    </div>

                                    @if (PlanoRegionalAtivo(1))
                                    {
                                        <em class="tag-regional-ativo">
                                            Ativo até @Model.DataFimPlanoRegionalFormatada
                                        </em>
                                    }

                                </div>
                            }

                            @if (quantidadeAdicionaisDisponiveis >= 2)
                            {
                                <div class="clube-item compacto @(PlanoRegionalAtivo(2) ? "ativo" : "")">

                                    <div>
                                        <span class="clube-qtd">+2 cidades</span>

                                        <strong>R$ 35</strong>

                                        <small>
                                            Escolha 2 cidades adicionais.
                                        </small>
                                    </div>

                                    @if (PlanoRegionalAtivo(2))
                                    {
                                        <em class="tag-regional-ativo">
                                            Ativo até @Model.DataFimPlanoRegionalFormatada
                                        </em>
                                    }

                                </div>
                            }

                            @if (quantidadeAdicionaisDisponiveis >= 3)
                            {
                                <div class="clube-item compacto @(PlanoRegionalAtivo(3) ? "ativo" : "")">

                                    <div>
                                        <span class="clube-qtd">+3 cidades</span>

                                        <strong>R$ 35</strong>

                                        <small>
                                            Escolha 3 cidades adicionais.
                                        </small>
                                    </div>

                                    @if (PlanoRegionalAtivo(3))
                                    {
                                        <em class="tag-regional-ativo">
                                            Ativo até @Model.DataFimPlanoRegionalFormatada
                                        </em>
                                    }

                                </div>
                            }

                            <div class="clube-item compacto bloqueado">

                                <div>
                                    <span class="clube-qtd">Mais regiões</span>

                                    <strong>Em breve</strong>

                                    <small>
                                        Novas cidades serão liberadas depois.
                                    </small>
                                </div>

                            </div>

                        </div>

                        <a href="/SolicitarDivulgacao" class="btn-clube-descontos compacto">
                            Solicitar divulgação regional
                        </a>

                    </section>
                } 
            </section>

            <section class="titulo-secao">

                <h2>Área operacional</h2>

                <p>
                    Acesse os principais recursos da sua conta profissional.
                </p>

            </section>

            <section class="grid-operacional">

                <a href="/AgendaClinica" class="card-operacional">

                    <div class="topo-operacional">
                        <i class="fa-regular fa-calendar"></i>
                    </div>

                    <h3>Agenda</h3>

                    <p>
                        Gerencie consultas, horários disponíveis e atendimentos.
                    </p>

                </a>

                <a href="/CadastroClinica" class="card-operacional">

                    <div class="topo-operacional">
                        <i class="fa-regular fa-id-card"></i>
                    </div>

                    <h3>Perfil profissional</h3>

                    <p>
                        Atualize suas informações públicas, especialidades e dados de contato.
                    </p>

                </a>

                <a href="/Clinicas" class="card-operacional">

                    <div class="topo-operacional">
                        <i class="fa-solid fa-store"></i>
                    </div>

                    <h3>Vitrine pública</h3>

                    <p>
                        Veja como sua clínica aparece para pacientes dentro da plataforma.
                    </p>

                </a>

                <a href="#clube-descontos" class="card-operacional">

                    <div class="topo-operacional">
                        <i class="fa-solid fa-bullhorn"></i>
                    </div>

                    <h3>Divulgação regional</h3>

                    <p>
                        Conheça opções para aparecer em mais cidades e regiões.
                    </p>

                </a>

            </section>

            <section class="acoes-dashboard">

                <a href="/CadastroClinica" class="btn-dashboard principal">
                    Editar perfil
                </a>

                <a href="/AgendaClinica" class="btn-dashboard secundario">
                    Abrir agenda
                </a>

                <a href="/Suporte" class="btn-dashboard secundario">
                    Falar com suporte
                </a>

            </section>
                }
        else
        {
            <div class="erro-card">

                <h2>Erro ao carregar os dados da clínica</h2>

                <a href="/LoginClinica" class="btn-dashboard principal">
                    Fazer login novamente
                </a>

            </div>
        }

    </div>

</div>

<style>

    /* =========================================================
           FONTE / RESET GERAL
        ========================================================= */

    @@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

    * {
        box-sizing: border-box;
        font-family: 'Poppins', sans-serif;
    }

    html,
    body {
        margin: 0;
        padding: 0;
        background: #eaf8ff;
        color: #0f172a;
    }

    a {
        text-decoration: none;
    }

    .container,
    .container-fluid,
    main {
        padding: 0 !important;
        margin: 0 !important;
        max-width: 100% !important;
        background: transparent !important;
    }

    /* =========================================================
           FUNDO DA PÁGINA
        ========================================================= */

    .painel-page {
        position: relative;
        min-height: 100vh;
        overflow-x: hidden;
        overflow-y: visible;
        padding: 64px 24px 70px;
        background: radial-gradient(circle at top left, rgba(14,165,233,.18), transparent 32%), 
                    radial-gradient(circle at bottom right, rgba(124,58,237,.14), transparent 35%),
                    linear-gradient(135deg,#e0f7ff 0%, #f8fcff 42%, #edf3ff 100%);
    }

    .rgb {
        position: absolute;
        border-radius: 50%;
        filter: blur(95px);
        opacity: .8;
        pointer-events: none;
    }

    .rgb-1 {
        width: 360px;
        height: 360px;
        background: rgba(14,165,233,.20);
        top: -120px;
        left: -120px;
    }

    .rgb-2 {
        width: 320px;
        height: 320px;
        background: rgba(124,58,237,.18);
        right: -120px;
        top: 260px;
    }

    .rgb-3 {
        width: 280px;
        height: 280px;
        background: rgba(20,184,166,.18);
        left: 20%;
        bottom: -140px;
    }

    .painel-container {
        position: relative;
        z-index: 2;
        max-width: 1240px;
        margin: auto;
    }

    /* =========================================================
           TOPO DO PAINEL
        ========================================================= */

    .topo-painel {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 28px;
        margin-bottom: 34px;
        flex-wrap: wrap;
    }

    .topo-esquerda {
        display: flex;
        align-items: center;
        gap: 28px;
    }

    .logo-painel {
        width: 230px;
        max-width: 100%;
        height: auto;
        object-fit: contain;
    }

    .badge-painel {
        display: inline-block;
        padding: 8px 16px;
        border-radius: 999px;
        background: rgba(14,165,233,.13);
        color: #0369a1;
        font-size: 13px;
        font-weight: 800;
        margin-bottom: 14px;
    }

    .topo-painel h1 {
        margin: 0 0 8px;
        color: #0f172a;
        font-size: 34px;
        line-height: 1.1;
        font-weight: 800;
        letter-spacing: -1px;
    }

    .topo-painel p {
        margin: 0;
        color: #64748b;
        font-size: 16px;
        max-width: 620px;
        line-height: 1.6;
    }

    .topo-acoes {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    /* =========================================================
           BOTÕES GERAIS
        ========================================================= */

    .btn-topo,
    .btn-alerta,
    .btn-completar,
    .btn-bloco,
    .btn-clube,
    .btn-clube-descontos,
    .btn-dashboard {
        text-decoration: none;
        transition: .25s;
    }

    .btn-topo {
        padding: 14px 18px;
        border-radius: 16px;
        font-weight: 800;
    }

        .btn-topo.principal {
            color: white;
            background: linear-gradient(135deg,#14b8a6,#0ea5e9);
            box-shadow: 0 14px 28px rgba(14,165,233,.18);
        }

        .btn-topo.secundario {
            color: #0ea5e9;
            background: white;
            border: 1px solid #dbeafe;
        }

        .btn-topo:hover,
        .btn-alerta:hover,
        .btn-completar:hover,
        .btn-bloco:hover,
        .btn-clube:hover,
        .btn-clube-descontos:hover,
        .btn-dashboard:hover,
        .card-operacional:hover,
        .kpi-card:hover {
            transform: translateY(-3px);
        }

    /* =========================================================
           CARDS BASE
        ========================================================= */

    .alerta,
    .alerta-perfil,
    .dashboard-hero,
    .kpi-card,
    .painel-bloco,
    .card-operacional,
    .erro-card {
        background: rgba(255,255,255,.88);
        border: 1px solid rgba(226,232,240,.9);
        box-shadow: 0 20px 55px rgba(15,23,42,.07);
        backdrop-filter: blur(18px);
    }

    /* =========================================================
           ALERTAS DE STATUS
        ========================================================= */

    .alerta {
        border-radius: 28px;
        padding: 28px;
        margin-bottom: 26px;
        display: flex;
        align-items: center;
        gap: 22px;
    }

    .alerta-icone {
        width: 58px;
        height: 58px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: white;
        font-size: 24px;
    }

    .alerta h2 {
        margin: 0 0 8px;
        font-size: 24px;
    }

    .alerta p {
        margin: 0;
        color: #64748b;
        line-height: 1.6;
    }

    .status-analise {
        border-color: #fed7aa;
    }

        .status-analise .alerta-icone {
            color: #ea580c;
        }

    .status-aprovado {
        border-color: #bfdbfe;
    }

        .status-aprovado .alerta-icone {
            color: #2563eb;
        }

    .status-ativo {
        border-color: #86efac;
    }

        .status-ativo .alerta-icone {
