@page
@model ProjetoTerapia.Pages.SolicitarDivulgacaoModel
@using System.Globalization

@{
    var cultura = new CultureInfo("pt-BR");

    /*
        Quantidade de cidades realmente disponíveis agora.
        Exemplo:
        - Se a clínica for de Osasco, sobram Barueri e São Paulo = 2 cidades adicionais.
        - Se a clínica for de Cotia, sobram Osasco, Barueri e São Paulo = 3 cidades adicionais.
    */
    var limiteAtualCidades = Model.CidadesDisponiveis
        .Count(c => Model.CidadeLiberada(c) && !Model.EhCidadePrincipal(c));

    /*
        Planos exibidos na tela.
        Os planos maiores continuam aparecendo como "Em breve".
    */
    var planos = new[]
    {
        new { Quantidade = 1, Nome = "+1 cidade", Valor = 30m },
        new { Quantidade = 2, Nome = "+2 cidades", Valor = 35m },
        new { Quantidade = 3, Nome = "+3 cidades", Valor = 35m },
        new { Quantidade = 5, Nome = "+5 cidades", Valor = 40m },
        new { Quantidade = 8, Nome = "+8 cidades", Valor = 45m },
        new { Quantidade = 10, Nome = "+10 cidades", Valor = 50m },
        new { Quantidade = 15, Nome = "+15 cidades", Valor = 55m },
        new { Quantidade = 20, Nome = "+20 cidades", Valor = 60m },
        new { Quantidade = 25, Nome = "+25 cidades", Valor = 65m },
        new { Quantidade = 27, Nome = "+27 cidades", Valor = 70m }
    };
}

<div class="divulgacao-page">

    <div class="divulgacao-card">

        <img src="/imagem/logo.png"
             class="logo-divulgacao"
             alt="AlinhaMente" />

        <span class="badge">
            Clube de Descontos
        </span>

        <h1>
            Solicitar divulgação regional
        </h1>

        <p class="sub">
            Escolha um plano e selecione as cidades adicionais onde deseja aparecer.
            Sua cidade principal já está inclusa no plano profissional.
        </p>

        @if (!string.IsNullOrWhiteSpace(Model.Clinica?.Cidade))
        {
            <div class="cidade-principal-box">

                <span>Sua cidade principal</span>

                <strong>@Model.Clinica.Cidade</strong>

                <p>
                    Ela já está inclusa no seu plano. As cidades abaixo serão adicionadas à sua divulgação regional.
                </p>

            </div>
        }

        @if (TempData["Sucesso"] != null)
        {
            <div class="alerta-sucesso">
                @TempData["Sucesso"]
            </div>
        }

        @if (TempData["Erro"] != null)
        {
            <div class="alerta-erro">
                @TempData["Erro"]
            </div>
        }

        @if (limiteAtualCidades <= 0)
        {
            <div class="alerta-erro">
                No momento, não há cidades adicionais disponíveis para sua região.
            </div>
        }

        <form method="post">

            <!-- ETAPA 1: PLANOS -->
            <div class="secao-form">

                <div class="secao-titulo">
                    <span>Etapa 1</span>

                    <h2>
                        Escolha o plano
                    </h2>

                    <p>
                        No momento, a divulgação regional está disponível apenas para Osasco, Barueri e São Paulo.
                    </p>
                </div>

                <div class="planos-grid">

                    @foreach (var plano in planos)
                    {
                        var planoDisponivel = plano.Quantidade <= limiteAtualCidades;

                        <label class="plano-card @(planoDisponivel ? "" : "plano-bloqueado") @(plano.Quantidade == 3 && planoDisponivel ? "destaque" : "")">

                            @if (planoDisponivel)
                            {
                                <input type="radio"
                                       name="QuantidadeCidades"
                                       value="@plano.Quantidade"
                                       class="plano-check"
                                       required
                                       checked="@(Model.QuantidadeCidades == plano.Quantidade ? "checked" : null)" />
                            }
                            else
                            {
                                <input type="radio"
                                       name="QuantidadeCidades"
                                       value="@plano.Quantidade"
                                       disabled />
                            }

                            <span>@plano.Nome</span>

                            <strong>
                                @plano.Valor.ToString("C", cultura)
                            </strong>

                            @if (!planoDisponivel)
                            {
                                <small class="selo-em-breve">
                                    Em breve
                                </small>
                            }

                        </label>
                    }

                </div>

            </div>

            <!-- ETAPA 2: CIDADES -->
            <div class="secao-form">

                <div class="secao-titulo linha">

                    <div>
                        <span>Etapa 2</span>

                        <h2>
                            Selecione as cidades
                        </h2>

                        <p>
                            Escolha apenas cidades adicionais. A cidade principal não precisa ser selecionada.
                        </p>
                    </div>

                    <div class="contador-cidades">
                        <strong id="contadorSelecionadas">0</strong>
                        <span id="contadorLimite">/ 0 cidades</span>
                    </div>

                </div>

                <div class="cidades-grid">

                    @foreach (var cidade in Model.CidadesDisponiveis)
                    {
                        if (Model.EhCidadePrincipal(cidade))
                        {
                            continue;
                        }

                        var cidadeLiberada = Model.CidadeLiberada(cidade);

                        if (cidadeLiberada)
                        {
                            <label class="cidade-opcao cidade-disponivel">

                                <input type="checkbox"
                                       name="CidadesEscolhidas"
                                       value="@cidade"
                                       class="cidade-check"
                                       checked="@(Model.CidadeSelecionada(cidade) ? "checked" : null)" />

                                <span>@cidade</span>

                                <small class="selo-disponivel">
                                    Disponível
                                </small>

                            </label>
                        }
                        else
                        {
                            <div class="cidade-opcao cidade-bloqueada">

                                <span>@cidade</span>

                                <small class="selo-em-breve">
                                    Em breve
                                </small>

                            </div>
                        }
                    }

                </div>

            </div>

            <button type="submit"
                    class="btn-principal"
                    @(limiteAtualCidades <= 0 ? "disabled" : null)>
                Ir para pagamento
            </button>

        </form>

        <a href="/PainelClinica" class="btn-voltar">
            Voltar ao painel
        </a>

    </div>

    <!-- HISTÓRICO -->
    <div class="historico-card">

        <h2>
            Minhas solicitações
        </h2>

        @if (!Model.MinhasSolicitacoes.Any())
        {
            <p class="vazio">
                Nenhuma solicitação enviada ainda.
            </p>
        }
        else
        {
            <div class="lista-solicitacoes">

                @foreach (var item in Model.MinhasSolicitacoes)
                {
                    <div class="solicitacao-item">

                        <div>
                            <span>@item.NomePlano</span>

                            <strong>
                                @item.Valor.ToString("C", cultura)
                            </strong>

                            <p>
                                @item.CidadesSelecionadas
                            </p>

                            @if (!item.Pago && item.Status != "Expirado")
                            {
                                var prazoPagamento = item.DataSolicitacao.AddHours(72);
                                var horasRestantes = Math.Ceiling((prazoPagamento - DateTime.Now).TotalHours);

                                <small class="prazo-pagamento">
                                    Prazo para pagamento: até @prazoPagamento.ToString("dd/MM/yyyy HH:mm")
                                    (@horasRestantes hora(s) restante(s))
                                </small>
                            }

                            @if (item.Status == "Expirado")
                            {
                                <small class="prazo-expirado">
                                    Prazo de pagamento encerrado. Faça uma nova solicitação se ainda tiver interesse.
                                </small>
                            }

                            @if (!item.Pago &&
                                                item.Status != "Expirado" &&
                                                item.Status != "Cancelado" &&
                                                !string.IsNullOrWhiteSpace(item.LinkPagamento))
                            {
                                <a href="@item.LinkPagamento"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="btn-pagar-agora">
                                    Pagar agora
                                </a>
                            }

                        </div>

                        <div class="status @(item.Status == "Expirado" ? "expirado" : item.Pago ? "pago" : "")">
                            @item.Status
                        </div>

                    </div>
                }

            </div>
        }

    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        // Radios dos planos disponíveis
        var radiosPlano = document.querySelectorAll("input[name='QuantidadeCidades']");

        // Checkboxes apenas das cidades liberadas
        var cidades = document.querySelectorAll(".cidade-check");

        var contadorSelecionadas = document.getElementById("contadorSelecionadas");
        var contadorLimite = document.getElementById("contadorLimite");

        function obterLimite() {
            var selecionado = document.querySelector("input[name='QuantidadeCidades']:checked");

            if (selecionado == null) {
                return 0;
            }

            return parseInt(selecionado.value);
        }

        function atualizarPlanos() {
            radiosPlano.forEach(function (radio) {
                var card = radio.closest(".plano-card");

                if (card != null) {
                    card.classList.toggle("selecionado", radio.checked);
                }
            });
        }

        function atualizarCidades() {
            var limite = obterLimite();

            var selecionadas = Array.from(cidades).filter(function (cidade) {
                return cidade.checked;
            });

            // Se trocar para um plano menor, remove seleções extras
            if (limite > 0 && selecionadas.length > limite) {
                selecionadas.slice(limite).forEach(function (cidade) {
                    cidade.checked = false;
                });

                selecionadas = Array.from(cidades).filter(function (cidade) {
                    return cidade.checked;
                });
            }

            cidades.forEach(function (cidade) {
                var card = cidade.closest(".cidade-opcao");

                if (card != null) {
                    card.classList.toggle("selecionada", cidade.checked);
                }

                if (limite === 0) {
                    cidade.disabled = true;
                }
                else if (!cidade.checked && selecionadas.length >= limite) {
                    cidade.disabled = true;
                }
                else {
                    cidade.disabled = false;
                }
            });

            contadorSelecionadas.innerText = selecionadas.length;
            contadorLimite.innerText = "/ " + limite + " cidade(s)";
        }

        radiosPlano.forEach(function (radio) {
            radio.addEventListener("change", function () {
                atualizarPlanos();
                atualizarCidades();
            });
        });

        cidades.forEach(function (cidade) {
            cidade.addEventListener("change", atualizarCidades);
        });

        atualizarPlanos();
        atualizarCidades();
    });
</script>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

    * {
        box-sizing: border-box;
        font-family: 'Poppins', sans-serif;
    }

    html,
    body {
        margin: 0;
        padding: 0;
        background: #eaf8ff;
        color: #0f172a;
    }

    .container,
    .container-fluid,
    main {
        padding: 0 !important;
        margin: 0 !important;
        max-width: 100% !important;
        background: transparent !important;
    }

    .divulgacao-page {
        min-height: 100vh;
        padding: 45px 22px;
        background: radial-gradient(circle at top left, rgba(14,165,233,.20), transparent 34%), radial-gradient(circle at bottom right, rgba(124,58,237,.16), transparent 35%), linear-gradient(135deg,#e0f7ff 0%, #f8fcff 48%, #edf3ff 100%);
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(360px, .85fr);
        gap: 26px;
        align-items: start;
    }

    .divulgacao-card,
    .historico-card {
        background: rgba(255,255,255,.92);
        border: 1px solid rgba(226,232,240,.9);
        backdrop-filter: blur(18px);
        border-radius: 34px;
        padding: 34px;
        box-shadow: 0 25px 70px rgba(15,23,42,.10);
    }

    .logo-divulgacao {
        width: 230px;
        display: block;
        margin: 0 auto 10px;
    }

    .badge {
        display: inline-block;
        padding: 8px 16px;
        border-radius: 999px;
        background: rgba(14,165,233,.12);
        color: #0369a1;
        font-size: 13px;
        font-weight: 800;
        margin-bottom: 16px;
    }

    h1 {
        margin: 0 0 12px;
        font-size: 36px;
        color: #0f172a;
        letter-spacing: -1px;
    }

    .sub {
        color: #64748b;
        line-height: 1.7;
        margin-bottom: 24px;
    }

    .cidade-principal-box {
        background: linear-gradient(135deg,#eff6ff,#ecfeff);
        border: 1px solid #bfdbfe;
        border-radius: 22px;
        padding: 18px 20px;
        margin-bottom: 22px;
    }

        .cidade-principal-box span {
            display: block;
            color: #0ea5e9;
            font-size: 12px;
            font-weight: 800;
            text-transform: uppercase;
            margin-bottom: 6px;
        }

        .cidade-principal-box strong {
            display: block;
            color: #0f172a;
            font-size: 22px;
            margin-bottom: 6px;
        }

        .cidade-principal-box p {
            margin: 0;
            color: #64748b;
            line-height: 1.6;
            font-size: 14px;
        }

    .secao-form {
        margin-bottom: 28px;
    }

    .secao-titulo {
        margin-bottom: 16px;
    }

        .secao-titulo.linha {
            display: flex;
            justify-content: space-between;
            gap: 18px;
            align-items: flex-start;
        }

        .secao-titulo span {
            display: inline-block;
            color: #0ea5e9;
            font-size: 12px;
            font-weight: 900;
            text-transform: uppercase;
            margin-bottom: 6px;
        }

        .secao-titulo h2 {
            margin: 0 0 6px;
            color: #0f172a;
            font-size: 24px;
        }

        .secao-titulo p {
            margin: 0;
            color: #64748b;
            line-height: 1.6;
            font-size: 14px;
        }

    .contador-cidades {
        min-width: 135px;
        padding: 12px 14px;
        border-radius: 18px;
        background: #f8fafc;
        border: 1px solid #dbeafe;
        text-align: center;
    }

        .contador-cidades strong {
            color: #0ea5e9;
            font-size: 24px;
        }

        .contador-cidades span {
            color: #64748b;
            font-size: 13px;
            font-weight: 800;
        }

    .planos-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
    }

    .plano-card {
        display: block;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        padding: 18px;
        cursor: pointer;
        transition: .25s;
        position: relative;
    }

        .plano-card:hover,
        .plano-card.selecionado {
            transform: translateY(-3px);
            border-color: #0ea5e9;
            background: #eff6ff;
            box-shadow: 0 14px 26px rgba(14,165,233,.10);
        }

        .plano-card input {
            margin-bottom: 12px;
            accent-color: #0ea5e9;
        }

        .plano-card span {
            display: block;
            color: #0f172a;
            font-weight: 800;
            margin-bottom: 8px;
        }

        .plano-card strong {
            color: #16a34a;
            font-size: 20px;
        }

        .plano-card.destaque {
            background: linear-gradient(135deg,#f8fafc,#ecfeff);
        }

    .plano-bloqueado {
        background: #f1f5f9;
        color: #94a3b8;
        cursor: not-allowed;
        opacity: .78;
    }

        .plano-bloqueado:hover {
            transform: none;
            border-color: #e2e8f0;
            box-shadow: none;
            background: #f1f5f9;
        }

        .plano-bloqueado span,
        .plano-bloqueado strong {
            color: #94a3b8;
        }

    .cidades-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
    }

    .cidade-opcao {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 13px 14px;
        display: flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
        transition: .25s;
        min-height: 58px;
        position: relative;
    }

        .cidade-opcao:hover,
        .cidade-opcao.selecionada {
            border-color: #0ea5e9;
            background: #eff6ff;
        }

        .cidade-opcao input {
            accent-color: #0ea5e9;
        }

            .cidade-opcao input:disabled + span {
                opacity: .45;
            }

        .cidade-opcao span {
            color: #334155;
            font-size: 14px;
            font-weight: 700;
        }

    .cidade-disponivel {
        justify-content: flex-start;
    }

    .cidade-bloqueada {
        background: #f1f5f9;
        color: #94a3b8;
        cursor: not-allowed;
        opacity: .82;
        justify-content: space-between;
    }

        .cidade-bloqueada:hover {
            border-color: #e2e8f0;
            background: #f1f5f9;
        }

        .cidade-bloqueada span {
            color: #94a3b8;
        }

    .selo-disponivel,
    .selo-em-breve {
        margin-left: auto;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 5px 9px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 800;
        white-space: nowrap;
    }

    .selo-disponivel {
        background: #dcfce7;
        color: #166534;
    }

    .selo-em-breve {
        background: #e2e8f0;
        color: #64748b;
    }

    .btn-principal,
    .btn-voltar {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        border-radius: 16px;
        padding: 15px 22px;
        font-weight: 800;
        transition: .25s;
    }

    .btn-principal {
        width: 100%;
        border: none;
        color: white;
        background: linear-gradient(135deg,#14b8a6,#0ea5e9);
        cursor: pointer;
        font-size: 16px;
    }

        .btn-principal:disabled {
            opacity: .6;
            cursor: not-allowed;
        }

    .btn-voltar {
        margin-top: 14px;
        width: 100%;
        color: #0ea5e9;
        background: white;
        border: 1px solid #dbeafe;
    }

        .btn-principal:hover,
        .btn-voltar:hover {
            transform: translateY(-2px);
        }

    .historico-card h2 {
        margin: 0 0 20px;
        color: #0f172a;
    }

    .lista-solicitacoes {
        display: grid;
        gap: 14px;
    }

    .solicitacao-item {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 22px;
        padding: 18px;
        display: flex;
        justify-content: space-between;
        gap: 16px;
    }

        .solicitacao-item span {
            color: #0ea5e9;
            font-weight: 800;
            font-size: 13px;
        }

        .solicitacao-item strong {
            display: block;
            margin: 6px 0;
            color: #0f172a;
        }

        .solicitacao-item p {
            margin: 0;
            color: #64748b;
            line-height: 1.5;
        }

    .btn-pagar-agora {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-top: 12px;
        padding: 11px 15px;
        border-radius: 14px;
        background: linear-gradient(135deg,#22c55e,#16a34a);
        color: white;
        font-size: 13px;
        font-weight: 900;
        text-decoration: none;
        transition: .25s;
    }

        .btn-pagar-agora:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 24px rgba(34,197,94,.18);
        }

    .status {
        align-self: start;
        padding: 8px 12px;
        border-radius: 999px;
        background: #fef3c7;
        color: #92400e;
        font-weight: 800;
        font-size: 12px;
        white-space: nowrap;
    }

        .status.pago {
            background: #dcfce7;
            color: #166534;
        }

        .status.expirado {
            background: #fee2e2;
            color: #991b1b;
        }

    .alerta-sucesso,
    .alerta-erro {
        padding: 14px;
        border-radius: 16px;
        margin-bottom: 18px;
        font-weight: 700;
    }

    .alerta-sucesso {
        background: #dcfce7;
        color: #166534;
    }

    .alerta-erro {
        background: #fee2e2;
        color: #991b1b;
    }

    .vazio {
        color: #64748b;
    }

    .prazo-pagamento,
    .prazo-expirado {
        display: block;
        margin-top: 8px;
        font-size: 12px;
        line-height: 1.5;
    }

    .prazo-pagamento {
        color: #92400e;
    }

    .prazo-expirado {
        color: #991b1b;
        font-weight: 700;
    }

    @@media(max-width: 1180px) {
        .divulgacao-page {
            grid-template-columns: 1fr;
        }

        .historico-card {
            order: 2;
        }
    }

    @@media(max-width: 850px) {
        .planos-grid,
        .cidades-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .secao-titulo.linha {
            flex-direction: column;
        }

        .contador-cidades {
            width: 100%;
        }
    }

    @@media(max-width: 650px) {
        .divulgacao-page {
            padding: 24px 14px;
        }

        .divulgacao-card,
        .historico-card {
            padding: 24px 20px;
            border-radius: 28px;
        }

        .planos-grid,
        .cidades-grid {
            grid-template-columns: 1fr;
        }

        h1 {
            font-size: 30px;
        }

        .logo-divulgacao {
            width: 200px;
        }

        .solicitacao-item {
            flex-direction: column;
        }

        .status,
        .btn-pagar-agora {
            width: 100%;
            justify-content: center;
            text-align: center;
        }

        .selo-disponivel,
        .selo-em-breve {
            margin-left: 0;
        }
    }
</style>