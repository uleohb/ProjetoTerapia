@page
@model ProjetoTerapia.Pages.AgendarConsultaModel

<div class="agendar-page">

    <div class="agendar-card">

        <img src="/imagem/AlinhaVIDA.png"
             class="logo-agendar"
             alt="AlinhaVida" />

        <span class="badge-agendar">
            Solicitação de contato
        </span>

        <h1>
            Solicitar consulta
        </h1>

        <p class="sub">
            Envie uma solicitação para @Model.Clinica.Nome. O horário e os detalhes da consulta serão combinados diretamente pelo WhatsApp entre paciente e profissional.
        </p>

        @if (TempData["Sucesso"] != null)
        {
            <div class="alerta-sucesso">
                @TempData["Sucesso"]
            </div>
        }

        @if (TempData["Erro"] != null)
        {
            <div class="alerta-erro">
                @TempData["Erro"]
            </div>
        }

        <div class="aviso-whatsapp">

            <div class="aviso-icone">
                <i class="fa-brands fa-whatsapp"></i>
            </div>

            <div>
                <strong>
                    Combine o melhor horário pelo WhatsApp
                </strong>

                <p>
                    Este formulário registra seu interesse na consulta. Para conversar diretamente com o profissional, use também o botão de WhatsApp abaixo.
                </p>
            </div>

        </div>

        <div class="profissional-box">

            <div>
                <span>Profissional</span>
                <strong>@Model.Clinica.Nome</strong>
            </div>

            <div>
                <span>Valor</span>
                <strong>R$ @Model.Clinica.Valor</strong>
            </div>

            <div>
                <span>Atendimento</span>
                <strong>
                    @(Model.Clinica.AtendimentoOnline && Model.Clinica.AtendimentoPresencial
                                        ? "Online e presencial"
                                        : Model.Clinica.AtendimentoOnline
                                        ? "Online"
                                        : "Presencial")
                </strong>
            </div>

        </div>

        <form method="post">

            <input type="hidden" asp-for="ClinicaId" />

            <div class="grid-campos">

                <div class="campo">
                    <label>Modalidade desejada</label>

                    <select asp-for="TipoAtendimento" required>
                        <option value="">Selecione</option>

                        @if (Model.Clinica.AtendimentoOnline)
                        {
                            <option value="Online">Online</option>
                        }

                        @if (Model.Clinica.AtendimentoPresencial)
                        {
                            <option value="Presencial">Presencial</option>
                        }
                    </select>
                </div>

                <div class="campo">
                    <label>
                        Seu WhatsApp
                        <span class="opcional">(opcional)</span>
                    </label>

                    <input asp-for="WhatsappPaciente"
                           id="whatsappPaciente"
                           placeholder="(11) 99999-9999"
                           inputmode="tel"
                           maxlength="15" />

                    <small>
                        Informe caso queira facilitar o retorno do profissional.
                    </small>
                </div>

            </div>

            <div class="campo">
                <label>Observações</label>

                <textarea asp-for="Observacoes"
                          placeholder="Conte brevemente o que você procura ou deixe alguma observação para o profissional."></textarea>
            </div>

            @if (Model.UltimoResultado != null)
            {
                <div class="resultado-box">

                    <div>
                        <span>Resultado do teste</span>

                        <strong>
                            @Model.UltimoResultado.Nivel
                        </strong>

                        <p>
                            Ansiedade: @Model.UltimoResultado.PercentualAnsiedade% |
                            Depressão: @Model.UltimoResultado.PercentualDepressao%
                        </p>
                    </div>

                    <label class="check-compartilhar">
                        <input asp-for="CompartilharResultado" type="checkbox" />
                        Compartilhar este resultado com o profissional
                    </label>

                </div>
            }
            else
            {
                <div class="resultado-box neutro">
                    <strong>Nenhum teste encontrado</strong>

                    <p>
                        Você pode solicitar contato mesmo assim. Se desejar, faça o teste antes para compartilhar seu resultado com o profissional.
                    </p>
                </div>
            }

            <button type="submit" class="btn-agendar">
                Enviar solicitação
            </button>

        </form>

        @if (!string.IsNullOrWhiteSpace(Model.LinkWhatsappProfissional))
        {
            <a href="@Model.LinkWhatsappProfissional"
               target="_blank"
               rel="noopener noreferrer"
               class="btn-whatsapp-profissional">
                <i class="fa-brands fa-whatsapp"></i>
                Chamar profissional no WhatsApp
            </a>
        }

        <a href="/PerfilClinica?id=@Model.Clinica.Id" class="btn-voltar">
            Voltar ao perfil
        </a>

    </div>

</div>

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const whatsappInput = document.getElementById("whatsappPaciente");

        if (!whatsappInput) {
            return;
        }

        whatsappInput.addEventListener("input", function () {
            let valor = this.value.replace(/\D/g, "");

            valor = valor.slice(0, 11);

            if (valor.length <= 10) {
                valor = valor.replace(/(\d{2})(\d)/, "($1) $2");
                valor = valor.replace(/(\d{4})(\d)/, "$1-$2");
            }
            else {
                valor = valor.replace(/(\d{2})(\d)/, "($1) $2");
                valor = valor.replace(/(\d{5})(\d)/, "$1-$2");
            }

            this.value = valor;
        });
    });
</script>

<style>

    @@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

    * {
        box-sizing: border-box;
        font-family: 'Poppins', sans-serif;
    }

    html,
    body {
        margin: 0;
        padding: 0;
        background: #eaf8ff;
    }

    .container,
    .container-fluid,
    main {
        padding: 0 !important;
        margin: 0 !important;
        max-width: 100% !important;
        background: transparent !important;
    }

    .agendar-page {
        min-height: 100vh;
        padding: 45px 20px;
        background: radial-gradient(circle at top left, rgba(14,165,233,.20), transparent 34%), radial-gradient(circle at bottom right, rgba(124,58,237,.15), transparent 35%), linear-gradient(135deg,#e0f7ff 0%, #f8fcff 48%, #edf3ff 100%);
        display: flex;
        justify-content: center;
        align-items: flex-start;
    }

    .agendar-card {
        width: 100%;
        max-width: 860px;
        background: rgba(255,255,255,.94);
        border: 1px solid rgba(226,232,240,.9);
        backdrop-filter: blur(18px);
        border-radius: 34px;
        padding: 38px;
        box-shadow: 0 25px 70px rgba(15,23,42,.10);
    }

    .logo-agendar {
        width: 230px;
        display: block;
        margin: 0 auto 12px;
    }

    .badge-agendar {
        display: inline-block;
        padding: 8px 16px;
        border-radius: 999px;
        background: rgba(14,165,233,.12);
        color: #0369a1;
        font-size: 13px;
        font-weight: 800;
        margin-bottom: 16px;
    }

    h1 {
        margin: 0 0 12px;
        color: #0f172a;
        font-size: 38px;
        letter-spacing: -1px;
    }

    .sub {
        color: #64748b;
        line-height: 1.7;
        margin-bottom: 24px;
    }

    .aviso-whatsapp {
        display: flex;
        align-items: flex-start;
        gap: 16px;
        padding: 18px;
        border-radius: 22px;
        background: #ecfdf5;
        border: 1px solid #bbf7d0;
        margin-bottom: 24px;
    }

    .aviso-icone {
        width: 48px;
        height: 48px;
        min-width: 48px;
        border-radius: 16px;
        background: #22c55e;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 23px;
    }

    .aviso-whatsapp strong {
        display: block;
        color: #166534;
        font-size: 17px;
        margin-bottom: 5px;
    }

    .aviso-whatsapp p {
        margin: 0;
        color: #166534;
        line-height: 1.5;
        font-size: 14px;
    }

    .profissional-box {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 12px;
        margin-bottom: 24px;
    }

        .profissional-box div,
        .resultado-box {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 20px;
            padding: 18px;
        }

            .profissional-box span,
            .resultado-box span {
                display: block;
                color: #94a3b8;
                font-size: 12px;
                font-weight: 800;
                margin-bottom: 7px;
                text-transform: uppercase;
            }

            .profissional-box strong,
            .resultado-box strong {
                color: #0f172a;
            }

    .grid-campos {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin-bottom: 18px;
    }

    .campo {
        margin-bottom: 18px;
    }

    .grid-campos .campo {
        margin-bottom: 0;
    }

    .campo label {
        display: block;
        color: #334155;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .campo input,
    .campo select,
    .campo textarea {
        width: 100%;
        border: 1px solid #dbeafe;
        border-radius: 16px;
        padding: 15px;
        background: #f8fafc;
        outline: none;
        font-size: 15px;
    }

    .campo textarea {
        min-height: 120px;
        resize: vertical;
    }

        .campo input:focus,
        .campo select:focus,
        .campo textarea:focus {
            border-color: #0ea5e9;
            background: white;
            box-shadow: 0 0 0 4px rgba(14,165,233,.10);
        }

    .campo small {
        display: block;
        margin-top: 7px;
        color: #94a3b8;
        font-size: 12px;
        line-height: 1.5;
    }

    .opcional {
        color: #94a3b8;
        font-size: 12px;
        font-weight: 600;
    }

    .resultado-box {
        margin-bottom: 20px;
    }

        .resultado-box p {
            margin: 8px 0 0;
            color: #64748b;
            line-height: 1.6;
        }

        .resultado-box.neutro {
            background: #fff7ed;
            border-color: #fed7aa;
        }

    .check-compartilhar {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 14px;
        color: #334155;
        font-weight: 700;
    }

    .btn-agendar,
    .btn-voltar,
    .btn-whatsapp-profissional {
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        text-decoration: none;
        border-radius: 18px;
        padding: 16px 22px;
        font-weight: 800;
        transition: .25s;
    }

    .btn-agendar {
        border: none;
        color: white;
        background: linear-gradient(135deg,#14b8a6,#0ea5e9);
        cursor: pointer;
        font-size: 16px;
        box-shadow: 0 14px 28px rgba(14,165,233,.18);
    }

    .btn-whatsapp-profissional {
        margin-top: 14px;
        color: white;
        background: linear-gradient(135deg,#22c55e,#16a34a);
        box-shadow: 0 14px 28px rgba(34,197,94,.18);
        gap: 9px;
    }

    .btn-voltar {
        margin-top: 14px;
        color: #0ea5e9;
        background: white;
        border: 1px solid #dbeafe;
    }

        .btn-agendar:hover,
        .btn-voltar:hover,
        .btn-whatsapp-profissional:hover {
            transform: translateY(-2px);
        }

    .alerta-sucesso,
    .alerta-erro {
        padding: 15px 18px;
        border-radius: 16px;
        margin-bottom: 20px;
        font-weight: 700;
    }

    .alerta-sucesso {
        background: #dcfce7;
        color: #166534;
        border: 1px solid #bbf7d0;
    }

    .alerta-erro {
        background: #fee2e2;
        color: #991b1b;
        border: 1px solid #fecaca;
    }

    @@media(max-width: 750px) {
        .agendar-page {
            padding: 24px 14px;
        }

        .agendar-card {
            padding: 26px 18px;
            border-radius: 28px;
        }

        .logo-agendar {
            width: 190px;
        }

        h1 {
            font-size: 31px;
            line-height: 1.15;
        }

        .sub {
            font-size: 15px;
            line-height: 1.6;
        }

        .aviso-whatsapp {
            flex-direction: column;
            gap: 12px;
        }

        .profissional-box,
        .grid-campos {
            grid-template-columns: 1fr;
        }

            .profissional-box div,
            .resultado-box {
                padding: 16px;
            }

        .btn-agendar,
        .btn-voltar,
        .btn-whatsapp-profissional {
            padding: 15px 18px;
            border-radius: 16px;
        }
    }

</style>