@page
@model ProjetoTerapia.Pages.PagamentoClinicaModel

<div class="pagamento-page">

    <div class="rgb rgb-1"></div>
    <div class="rgb rgb-2"></div>

    <div class="pagamento-card">

        <div class="logo-area-pagamento">
            <img src="/imagem/AlinhaVIDA.png"
                 class="logo-pagamento"
                 alt="AlinhaVIDA" />
        </div>

        @if (TempData["Sucesso"] != null)
        {
            <div class="mensagem sucesso">
                @TempData["Sucesso"]
            </div>
        }

        @if (TempData["Erro"] != null)
        {
            <div class="mensagem erro">
                @TempData["Erro"]
            </div>
        }

        @if (Model.Clinica != null)
        {
            @if (!Model.Clinica.Aprovado)
            {
                <span class="badge-pagamento analise">
                    Cadastro em análise
                </span>

                <h1>
                    Seu cadastro ainda está em análise
                </h1>

                <p class="descricao-principal">
                    Após a aprovação da administração,
                    você poderá ativar seu plano profissional.
                </p>

                <a asp-page="/PainelClinica"
                   class="btn-secundario">
                    Voltar ao painel
                </a>
            }
            else if (Model.AssinaturaAtiva)
            {
                <span class="badge-pagamento ativo">
                    Assinatura ativa
                </span>

                @if (Model.EmTesteGratis)
                {
                    <h1>
                        Seus 7 dias gratuitos estão ativos
                    </h1>

                    <p class="descricao-principal">
                        Seu plano profissional já está liberado.
                        Nenhuma cobrança foi realizada neste momento.
                    </p>

                    <div class="trial-ativo">
                        <span class="trial-icone">✓</span>

                        <div>
                            <strong>
                                Período gratuito em andamento
                            </strong>

                            <p>
                                Sua primeira cobrança de
                                <strong>R$ 450,00</strong>
                                será realizada após o término dos 7 dias gratuitos.
                            </p>
                        </div>
                    </div>
                }
                else
                {
                    <h1>
                        Sua assinatura está ativa
                    </h1>

                    <p class="descricao-principal">
                        Seu plano profissional está ativo
                        e possui renovação automática anual.
                    </p>
                }

                <div class="info-plano">

                    <div>
                        <span>Plano</span>
                        <strong>Plano Profissional Anual</strong>
                    </div>

                    <div>
                        <span>Valor</span>
                        <strong>R$ 450,00 / ano</strong>
                    </div>

                    @if (Model.EmTesteGratis &&
                         Model.FimTesteGratisLocal.HasValue)
                    {
                        <div>
                            <span>Fim dos 7 dias grátis</span>

                            <strong>
                                @Model.FimTesteGratisLocal.Value.ToString("dd/MM/yyyy")
                            </strong>
                        </div>
                    }

                    @if (Model.ProximaCobrancaLocal.HasValue)
                    {
                        <div>
                            <span>Próxima cobrança</span>

                            <strong>
                                @Model.ProximaCobrancaLocal.Value.ToString("dd/MM/yyyy")
                            </strong>
                        </div>
                    }

                    <div>
                        <span>Renovação automática</span>
                        <strong class="status-renovacao">Ativada</strong>
                    </div>

                </div>

                <p class="observacao-cancelamento">
                    Na próxima etapa vamos colocar no painel
                    a opção de gerenciar e cancelar a assinatura.
                </p>

                <a asp-page="/PainelClinica"
                   class="btn-principal">
                    Ir para o painel
                </a>
            }
            else if (Model.AssinaturaPendente)
            {
                <span class="badge-pagamento pendente">
                    Autorização pendente
                </span>

                <h1>
                    Falta concluir sua assinatura
                </h1>

                <p class="descricao-principal">
                    Sua assinatura já foi criada.
                    Conclua a autorização no Mercado Pago
                    para iniciar os 7 dias gratuitos.
                </p>

                <div class="plano-box">

                    <div class="trial-destaque">
                        <span>7 dias grátis</span>
                        <strong>R$ 0 hoje</strong>
                    </div>

                    <p class="texto-pendente">
                        Depois do período gratuito, o plano passa a custar
                        <strong>R$ 450,00 por ano</strong>,
                        com renovação automática até o cancelamento.
                    </p>

                </div>

                <div class="acoes-pagamento">

                    <a href="@(Model.AssinaturaAtual?.LinkAutorizacao)"
                       class="btn-principal btn-pagar">
                        Continuar no Mercado Pago
                    </a>

                    <a asp-page="/PainelClinica"
                       class="btn-secundario">
                        Voltar ao painel
                    </a>

                </div>
            }
            else if (Model.Clinica.Pago &&
                     !Model.PlanoVencido &&
                     !Model.PlanoPertoDeVencer)
            {
                <span class="badge-pagamento ativo">
                    Plano atual ativo
                </span>

                <h1>
                    Seu plano profissional está ativo
                </h1>

                <p class="descricao-principal">
                    Seu plano atual continua válido.
                    A assinatura recorrente ficará disponível
                    quando chegar o período de renovação.
                </p>

                <div class="info-plano">

                    <div>
                        <span>Plano</span>

                        <strong>
                            @(Model.Clinica.NomePlano ?? "Plano Profissional Anual")
                        </strong>
                    </div>

                    <div>
                        <span>Valor</span>
                        <strong>@Model.ValorPlanoFormatado</strong>
                    </div>

                    <div>
                        <span>Vencimento</span>

                        <strong>
                            @(Model.Clinica.DataVencimento.HasValue
                                ? Model.Clinica.DataVencimento.Value.ToString("dd/MM/yyyy")
                                : "Não informado")
                        </strong>
                    </div>

                </div>

                <a asp-page="/PainelClinica"
                   class="btn-principal">
                    Voltar ao painel
                </a>
            }
            else
            {
                <span class="badge-pagamento teste">
                    7 dias grátis
                </span>

                <h1 class="titulo-ativacao">
                    Ative seu plano profissional
                </h1>

                <p class="descricao-principal">
                    Autorize sua assinatura agora e use o AlinhaVIDA
                    por 7 dias sem cobrança.
                </p>

                @if (Model.PlanoPertoDeVencer)
                {
                    <div class="alerta-renovacao">
                        Seu plano atual vence em
                        <strong>@Model.DiasRestantes dia(s)</strong>.
                    </div>
                }

                @if (Model.PlanoVencido)
                {
                    <div class="alerta-vencido">
                        Seu plano anterior está vencido.
                        Ative a nova assinatura para continuar utilizando
                        os recursos do plano profissional.
                    </div>
                }

                <div class="plano-box">

                    <div class="trial-destaque">
                        <span>Primeiros 7 dias</span>
                        <strong>GRÁTIS</strong>
                    </div>

                    <span class="plano-nome">
                        Plano Profissional Anual
                    </span>

                    <strong class="plano-valor">
                        R$ 450,00
                    </strong>

                    <div class="plano-periodo">
                        por ano, após o período gratuito
                    </div>

                    <p class="parcelamento">
                        Hoje: <strong>R$ 0,00</strong>.
                        A primeira cobrança ocorre somente
                        depois dos 7 dias gratuitos.
                    </p>

                    <div class="separador-plano"></div>

                    <div class="beneficios-plano">

                        <div>
                            <span>✓</span>
                            Perfil profissional na plataforma
                        </div>

                        <div>
                            <span>✓</span>
                            Conteúdos profissionais no perfil
                        </div>

                        <div>
                            <span>✓</span>
                            Acesso aos recursos do painel profissional
                        </div>

                        <div>
                            <span>✓</span>
                            Renovação automática anual
                        </div>

                    </div>

                    <div class="mercado-pago-info">

                        <div class="icone-seguranca">✓</div>

                        <div>
                            <strong>
                                Assinatura segura via Mercado Pago
                            </strong>

                            <p>
                                O meio de pagamento é autorizado
                                no ambiente do Mercado Pago.
                            </p>
                        </div>

                    </div>

                </div>

                <form method="post"
                      asp-page-handler="Pagar"
                      id="formAssinatura">

                    <div class="termos-box">

                        <label class="aceite-item">

                            <input asp-for="AceitouTermosEPrivacidade"
                                   id="aceiteTermos" />

                            <span class="check-visual"></span>

                            <span class="texto-aceite">
                                Li e aceito os
                                <a href="/termos/profissionais"
                                   target="_blank"
                                   rel="noopener noreferrer">
                                    Termos de Uso do Profissional
                                </a>
                                e a
                                <a href="/politica-de-privacidade"
                                   target="_blank"
                                   rel="noopener noreferrer">
                                    Política de Privacidade
                                </a>.
                            </span>

                        </label>

                        <label class="aceite-item">

                            <input asp-for="AceitouCobrancaRecorrente"
                                   id="aceiteCobranca" />

                            <span class="check-visual"></span>

                            <span class="texto-aceite">
                                Estou ciente de que terei
                                <strong>7 dias gratuitos</strong>
                                e, após esse período, será realizada
                                cobrança de
                                <strong>R$ 450,00 por ano</strong>,
                                com renovação automática anual
                                até o cancelamento.
                            </span>

                        </label>

                    </div>

                    <p class="aviso-aceite">
                        Os dois aceites são obrigatórios
                        para iniciar a assinatura.
                    </p>

                    <div class="acoes-pagamento">

                        <button type="submit"
                                class="btn-principal btn-pagar"
                                id="btnAssinar"
                                disabled>
                            Aceitar e iniciar 7 dias grátis
                        </button>

                        <a asp-page="/PainelClinica"
                           class="btn-secundario">
                            Voltar ao painel
                        </a>

                    </div>

                </form>
            }
        }

    </div>

</div>

<style>

    @@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

    * {
        box-sizing: border-box;
        font-family: 'Poppins', sans-serif;
    }

    html,
    body {
        margin: 0;
        padding: 0;
        background: #eaf8ff;
    }

    .container,
    .container-fluid,
    main {
        padding: 0 !important;
        margin: 0 !important;
        max-width: 100% !important;
        background: transparent !important;
    }

    .pagamento-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        position: relative;
        overflow: hidden;
        background:
            radial-gradient(circle at top left, rgba(14,165,233,.20), transparent 34%),
            radial-gradient(circle at bottom right, rgba(124,58,237,.16), transparent 35%),
            linear-gradient(135deg, #e0f7ff 0%, #f8fcff 48%, #edf3ff 100%);
    }

    .rgb {
        position: absolute;
        border-radius: 50%;
        filter: blur(90px);
        pointer-events: none;
    }

    .rgb-1 {
        width: 340px;
        height: 340px;
        background: rgba(14,165,233,.22);
        top: -120px;
        left: -100px;
    }

    .rgb-2 {
        width: 320px;
        height: 320px;
        background: rgba(124,58,237,.18);
        bottom: -120px;
        right: -100px;
    }

    .pagamento-card {
        width: 100%;
        max-width: 660px;
        position: relative;
        z-index: 2;
        background: rgba(255,255,255,.95);
        border: 1px solid rgba(226,232,240,.95);
        backdrop-filter: blur(18px);
        border-radius: 34px;
        padding: 38px 40px 40px;
        box-shadow: 0 25px 70px rgba(15,23,42,.10);
        text-align: center;
    }

    .logo-area-pagamento {
        display: flex;
        justify-content: center;
        margin-bottom: 18px;
    }

    .logo-pagamento {
        display: block;
        width: 280px;
        max-width: 82%;
        height: auto;
        object-fit: contain;
    }

    .mensagem {
        border-radius: 16px;
        padding: 14px 16px;
        margin: 0 0 20px;
        font-size: 13px;
        font-weight: 700;
        line-height: 1.55;
        text-align: left;
    }

    .mensagem.sucesso {
        color: #166534;
        background: #dcfce7;
        border: 1px solid #bbf7d0;
    }

    .mensagem.erro {
        color: #991b1b;
        background: #fee2e2;
        border: 1px solid #fecaca;
    }

    .badge-pagamento {
        display: inline-block;
        padding: 8px 16px;
        border-radius: 999px;
        background: rgba(14,165,233,.12);
        color: #0369a1;
        font-size: 13px;
        font-weight: 800;
        margin-bottom: 18px;
    }

    .badge-pagamento.ativo {
        background: #dcfce7;
        color: #166534;
    }

    .badge-pagamento.analise {
        background: #fef3c7;
        color: #92400e;
    }

    .badge-pagamento.teste {
        background: #ede9fe;
        color: #6d28d9;
    }

    .badge-pagamento.pendente {
        background: #e0f2fe;
        color: #075985;
    }

    h1 {
        margin: 0 0 14px;
        font-size: 36px;
        line-height: 1.15;
        color: #0f172a;
        letter-spacing: -1.2px;
        font-weight: 800;
    }

    .descricao-principal {
        max-width: 520px;
        margin: 0 auto 26px;
        color: #64748b;
        line-height: 1.7;
        font-size: 16px;
    }

    .plano-box {
        background: linear-gradient(145deg, #f8fafc, #f5f9ff);
        border: 1px solid #e2e8f0;
        border-radius: 24px;
        padding: 28px;
        margin: 24px 0;
    }

    .trial-destaque {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 14px 16px;
        margin-bottom: 22px;
        border-radius: 16px;
        background: linear-gradient(135deg, #ede9fe, #e0f2fe);
        color: #4c1d95;
        text-align: left;
    }

    .trial-destaque span {
        font-size: 13px;
        font-weight: 800;
    }

    .trial-destaque strong {
        font-size: 18px;
        font-weight: 900;
    }

    .plano-nome {
        display: block;
        color: #64748b;
        font-size: 13px;
        font-weight: 800;
        margin-bottom: 10px;
    }

    .plano-valor {
        display: block;
        font-size: 38px;
        color: #0f172a;
        font-weight: 800;
    }

    .plano-periodo {
        color: #64748b;
        font-size: 14px;
        font-weight: 600;
        margin-top: 6px;
    }

    .parcelamento,
    .texto-pendente {
        color: #64748b;
        margin: 14px 0 20px;
        font-size: 14px;
        line-height: 1.65;
    }

    .separador-plano {
        height: 1px;
        background: #e2e8f0;
        margin: 22px 0;
    }

    .beneficios-plano {
        display: grid;
        gap: 11px;
        margin-bottom: 20px;
        text-align: left;
    }

    .beneficios-plano div {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #475569;
        font-size: 13px;
        font-weight: 600;
    }

    .beneficios-plano span {
        width: 22px;
        height: 22px;
        min-width: 22px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #dcfce7;
        color: #15803d;
        font-size: 12px;
        font-weight: 900;
    }

    .mercado-pago-info,
    .trial-ativo {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        text-align: left;
        border-radius: 18px;
        padding: 16px 18px;
    }

    .mercado-pago-info {
        background: white;
        border: 1px solid #e2e8f0;
    }

    .trial-ativo {
        margin-bottom: 22px;
        background: #f5f3ff;
        border: 1px solid #c4b5fd;
    }

    .icone-seguranca,
    .trial-icone {
        width: 34px;
        height: 34px;
        min-width: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        font-weight: 900;
    }

    .icone-seguranca {
        background: #dcfce7;
        color: #15803d;
    }

    .trial-icone {
        background: #7c3aed;
        color: white;
    }

    .mercado-pago-info strong,
    .trial-ativo strong {
        color: #0f172a;
        font-size: 14px;
    }

    .mercado-pago-info p,
    .trial-ativo p {
        margin: 4px 0 0;
        color: #64748b;
        font-size: 13px;
        line-height: 1.55;
    }

    .termos-box {
        margin: 6px 0 12px;
        display: grid;
        gap: 12px;
        text-align: left;
    }

    .aceite-item {
        position: relative;
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 15px 16px;
        border: 1px solid #dbe4ee;
        border-radius: 16px;
        background: #fff;
        cursor: pointer;
    }

    .aceite-item:hover {
        border-color: #93c5fd;
        background: #f8fbff;
    }

    .aceite-item input[type="checkbox"] {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }

    .check-visual {
        width: 20px;
        height: 20px;
        min-width: 20px;
        margin-top: 2px;
        border: 2px solid #94a3b8;
        border-radius: 6px;
        background: white;
        position: relative;
    }

    .aceite-item input[type="checkbox"]:checked + .check-visual {
        border-color: #0ea5e9;
        background: #0ea5e9;
    }

    .aceite-item input[type="checkbox"]:checked + .check-visual::after {
        content: "✓";
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 13px;
        font-weight: 900;
    }

    .texto-aceite {
        color: #475569;
        font-size: 13px;
        line-height: 1.65;
    }

    .texto-aceite a {
        color: #0284c7;
        font-weight: 800;
        text-decoration: underline;
        text-underline-offset: 2px;
    }

    .aviso-aceite {
        margin: 0 0 20px;
        color: #94a3b8;
        font-size: 12px;
    }

    .info-plano {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 24px;
        padding: 24px;
        margin: 24px 0;
        display: grid;
        gap: 14px;
        text-align: left;
    }

    .info-plano div {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        padding: 16px;
    }

    .info-plano span {
        display: block;
        color: #94a3b8;
        font-size: 12px;
        font-weight: 800;
        margin-bottom: 6px;
        text-transform: uppercase;
    }

    .info-plano strong {
        color: #0f172a;
        font-size: 15px;
    }

    .status-renovacao {
        color: #15803d !important;
    }

    .observacao-cancelamento {
        margin: -8px 0 22px;
        color: #94a3b8;
        font-size: 12px;
        line-height: 1.55;
    }

    .alerta-renovacao,
    .alerta-vencido {
        padding: 16px 18px;
        border-radius: 16px;
        margin: 20px 0;
        font-size: 14px;
        font-weight: 600;
    }

    .alerta-renovacao {
        background: #fef3c7;
        color: #92400e;
        border: 1px solid #fde68a;
    }

    .alerta-vencido {
        background: #fee2e2;
        color: #991b1b;
        border: 1px solid #fecaca;
    }

    .acoes-pagamento {
        display: flex;
        gap: 12px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .btn-principal,
    .btn-secundario {
        min-height: 52px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 14px 24px;
        border-radius: 16px;
        text-decoration: none;
        font-size: 14px;
        font-weight: 800;
        transition: .2s;
    }

    .btn-principal {
        color: white;
        background: linear-gradient(135deg, #14b8a6, #0ea5e9);
        box-shadow: 0 14px 28px rgba(14,165,233,.18);
        border: none;
        cursor: pointer;
    }

    .btn-principal:disabled {
        cursor: not-allowed;
        opacity: .45;
        box-shadow: none;
    }

    .btn-pagar {
        min-width: 270px;
    }

    .btn-secundario {
        color: #0284c7;
        background: white;
        border: 1px solid #dbeafe;
    }

    @@media (max-width: 600px) {

        .pagamento-page {
            padding: 22px 14px;
        }

        .pagamento-card {
            padding: 28px 20px 30px;
            border-radius: 26px;
        }

        .logo-pagamento {
            width: 235px;
        }

        h1 {
            font-size: 29px;
        }

        .descricao-principal {
            font-size: 14px;
        }

        .plano-box {
            padding: 22px 18px;
        }

        .trial-destaque {
            flex-direction: column;
        }

        .acoes-pagamento {
            flex-direction: column;
        }

        .btn-principal,
        .btn-secundario,
        .btn-pagar {
            width: 100%;
            min-width: 0;
        }
    }

</style>

<script>
    (function () {

        const termos =
            document.getElementById("aceiteTermos");

        const cobranca =
            document.getElementById("aceiteCobranca");

        const botao =
            document.getElementById("btnAssinar");

        if (!termos || !cobranca || !botao)
            return;

        function atualizar() {
            botao.disabled =
                !termos.checked ||
                !cobranca.checked;
        }

        termos.addEventListener("change", atualizar);
        cobranca.addEventListener("change", atualizar);

        atualizar();
    })();
</script>
