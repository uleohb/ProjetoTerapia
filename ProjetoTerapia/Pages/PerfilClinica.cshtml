@page "/profissional/perfil"
@model ProjetoTerapia.Pages.PerfilClinicaModel

@using System
@using System.Linq
@using System.Globalization

@{
    var clinica = Model.Clinica
        ?? throw new InvalidOperationException(
            "O perfil profissional não foi carregado."
        );

    var nomeProfissional =
        string.IsNullOrWhiteSpace(clinica.Nome)
            ? "Profissional"
            : clinica.Nome.Trim();

    ViewData["Title"] = nomeProfissional;


    // =====================================================
    // WHATSAPP
    // =====================================================

    var telefoneOriginal =
        clinica.Telefone ?? "";

    var telefoneWhatsapp =
        new string(
            telefoneOriginal
                .Where(char.IsDigit)
                .ToArray()
        );

    telefoneWhatsapp =
        telefoneWhatsapp.TrimStart('0');

    if (!string.IsNullOrWhiteSpace(telefoneWhatsapp) &&
        !telefoneWhatsapp.StartsWith("55"))
    {
        telefoneWhatsapp =
            "55" + telefoneWhatsapp;
    }

    var whatsappDisponivel =
        !string.IsNullOrWhiteSpace(telefoneWhatsapp) &&
        telefoneWhatsapp.Length >= 12;


    var mensagemWhatsapp =
        Uri.EscapeDataString(
            "Olá! Encontrei seu perfil no AlinhaVIDA e gostaria de saber mais sobre o atendimento."
        );


    var whatsappUrl =
        whatsappDisponivel
            ? $"https://wa.me/{telefoneWhatsapp}?text={mensagemWhatsapp}"
            : "";


    // =====================================================
    // INSTAGRAM
    // =====================================================

    var instagramUrl =
        clinica.Instagram?.Trim() ?? "";

    if (!string.IsNullOrWhiteSpace(instagramUrl) &&
        !instagramUrl.StartsWith(
            "http",
            StringComparison.OrdinalIgnoreCase))
    {
        instagramUrl =
            "https://instagram.com/" +
            instagramUrl.Replace("@", "");
    }


    // =====================================================
    // SITE
    // =====================================================

    var siteUrl =
        clinica.Site?.Trim() ?? "";

    if (!string.IsNullOrWhiteSpace(siteUrl) &&
        !siteUrl.StartsWith(
            "http",
            StringComparison.OrdinalIgnoreCase))
    {
        siteUrl =
            "https://" + siteUrl;
    }


    // =====================================================
    // AVATAR
    // =====================================================

    var inicial =
        string.IsNullOrWhiteSpace(nomeProfissional)
            ? "P"
            : nomeProfissional
                .Substring(0, 1)
                .ToUpperInvariant();
}


<div class="perfil-page">

    <!-- =====================================================
         VOLTAR
    ====================================================== -->

    <div class="voltar-container">

        @if (Model.EhDonoPerfil)
        {
            <a asp-page="/PainelClinica"
               class="btn-voltar">

                <i class="fa-solid fa-arrow-left"></i>

                Voltar ao painel

            </a>
        }
        else
        {
            <a asp-page="/Clinicas"
               class="btn-voltar">

                <i class="fa-solid fa-arrow-left"></i>

                Voltar aos profissionais

            </a>
        }

    </div>


    <!-- =====================================================
         TOPO
    ====================================================== -->

    <section class="perfil-topo-moderno">

        <div class="perfil-topo-card">


            <!-- IDENTIDADE -->

            <div class="perfil-identidade">

                <div class="avatar-perfil">

                    @if (!string.IsNullOrWhiteSpace(
                        clinica.FotoPerfil))
                    {
                        <img src="@clinica.FotoPerfil"
                             alt="@nomeProfissional" />
                    }
                    else
                    {
                        @inicial
                    }

                </div>


                <div class="perfil-info-principal">

                    <span class="badge-top">
                        Perfil profissional
                    </span>


                    <h1>
                        @nomeProfissional
                    </h1>


                    <div class="linha-badges">


                        @if (clinica.AtendimentoOnline)
                        {
                            <span class="badge-info online">

                                <i class="fa-solid fa-video"></i>

                                Online

                            </span>
                        }


                        @if (clinica.AtendimentoPresencial)
                        {
                            <span class="badge-info presencial">

                                <i class="fa-solid fa-location-dot"></i>

                                Presencial

                            </span>
                        }


                        <span class="badge-info aprovado">

                            <i class="fa-solid fa-circle-check"></i>

                            Verificado

                        </span>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 AÇÕES PRINCIPAIS
            ================================================== -->

            <div class="perfil-acoes-rapidas">

                @if (!Model.EhDonoPerfil)
                {

                    @if (whatsappDisponivel)
                    {
                        <a href="@whatsappUrl"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="btn-topo whatsapp-topo">

                            <i class="fa-brands fa-whatsapp"></i>

                            Chamar no WhatsApp

                        </a>
                    }
                    else
                    {
                        <span class="btn-topo whatsapp-topo indisponivel">

                            <i class="fa-brands fa-whatsapp"></i>

                            WhatsApp indisponível

                        </span>
                    }


                    @if (Model.PacienteLogado)
                    {
                        <a asp-page="/AgendarConsulta"
                           asp-route-id="@clinica.Id"
                           class="btn-topo agendar-topo">

                            <i class="fa-regular fa-calendar-check"></i>

                            Agendar consulta

                        </a>
                    }
                    else
                    {
                        <a asp-page="/LoginPaciente"
                           class="btn-topo agendar-topo">

                            <i class="fa-regular fa-calendar-check"></i>

                            Entrar para agendar

                        </a>
                    }

                }
                else
                {
                    <a asp-page="/CadastroClinica"
                       class="btn-topo agendar-topo">

                        <i class="fa-regular fa-pen-to-square"></i>

                        Editar perfil

                    </a>
                }

            </div>

        </div>

    </section>


    <!-- =====================================================
         CONTEÚDO
    ====================================================== -->

    <div class="conteudo-perfil">


        <!-- =================================================
             COLUNA PRINCIPAL
        ================================================== -->

        <div class="perfil-main">


            <!-- ESPECIALIDADES -->

            <section class="card-perfil">

                <h3>
                    Especialidades
                </h3>


                <div class="especialidades-lista">

                    @if (Model.ListaEspecialidades != null &&
                         Model.ListaEspecialidades.Any())
                    {
                        @foreach (var especialidade
                            in Model.ListaEspecialidades)
                        {
                            @if (!string.IsNullOrWhiteSpace(
                                especialidade))
                            {
                                <span class="tag-especialidade">

                                    @especialidade

                                </span>
                            }
                        }
                    }
                    else
                    {
                        <p class="info-texto">
                            Especialidades não informadas.
                        </p>
                    }

                </div>

            </section>


            <!-- =================================================
                 SOBRE
            ================================================== -->

            <section class="card-perfil">

                <h3>
                    Sobre o profissional
                </h3>


                <p class="texto-sobre">

                    @(string.IsNullOrWhiteSpace(
                        clinica.Descricao)

                        ? "Este profissional ainda não adicionou uma descrição."
                        : clinica.Descricao)

                </p>

            </section>


            <!-- =================================================
                 LOCALIZAÇÃO
            ================================================== -->

            <section class="card-perfil">

                <h3>
                    Localização
                </h3>


                <p class="info-texto">

                    <i class="fa-solid fa-location-dot"></i>

                    <span>

                        @(string.IsNullOrWhiteSpace(
                            clinica.Endereco)

                            ? "Endereço não informado"
                            : clinica.Endereco)

                    </span>

                </p>


                <p class="info-texto">

                    <i class="fa-solid fa-city"></i>

                    <span>

                        @(string.IsNullOrWhiteSpace(
                            clinica.Cidade)

                            ? "Cidade não informada"
                            : clinica.Cidade)

                    </span>

                </p>

            </section>

        </div>


        <!-- =================================================
             COLUNA LATERAL
        ================================================== -->

        <aside class="perfil-side">


            <!-- =================================================
                 VALOR
            ================================================== -->

            <section class="card-side destaque">

                <span>
                    Consulta inicial
                </span>


                <h2>

                    @clinica.Valor.ToString(
                        "C",
                        new CultureInfo("pt-BR")
                    )

                </h2>

            </section>


            <!-- =================================================
                 AGENDAMENTO
            ================================================== -->
            @if (!Model.EhDonoPerfil)
            {
                <section class="card-side agendamento-card">

                    <h3>
                        Agendamento
                    </h3>


                    <p>
                        Solicite uma consulta diretamente
                        com este profissional.
                    </p>


                    @if (Model.PacienteLogado)
                    {
                        <a asp-page="/AgendarConsulta"
                           asp-route-id="@clinica.Id"
                           class="btn-agendar-consulta">

                            <i class="fa-regular fa-calendar-check"></i>

                            Agendar consulta

                        </a>
                    }
                    else
                    {
                        <a asp-page="/LoginPaciente"
                           class="btn-agendar-consulta">

                            <i class="fa-regular fa-user"></i>

                            Entrar para agendar

                        </a>
                    }

                </section>
            }


            <!-- =================================================
                 CONTATO
            ================================================== -->

            <section class="card-side">

                <h3>
                    Contato
                </h3>


                <p class="telefone-perfil">

                    <i class="fa-solid fa-phone"></i>

                    <span>

                        @(string.IsNullOrWhiteSpace(
                            clinica.Telefone)

                            ? "Telefone não informado"
                            : clinica.Telefone)

                    </span>

                </p>


                @if (whatsappDisponivel)
                {
                    <a href="@whatsappUrl"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="rede whatsapp"
                       aria-label="Abrir conversa no WhatsApp"
                       title="WhatsApp">

                        <i class="fa-brands fa-whatsapp"></i>

                    </a>
                }

            </section>


            <!-- =================================================
                 REDES SOCIAIS
            ================================================== -->
            @if (!string.IsNullOrWhiteSpace(instagramUrl) ||
                             !string.IsNullOrWhiteSpace(siteUrl))
            {
                <section class="card-side">

                    <h3>
                        Redes sociais
                    </h3>


                    <div class="redes-grid">


                        @if (!string.IsNullOrWhiteSpace(
                            instagramUrl))
                        {
                            <a href="@instagramUrl"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="rede insta"
                               aria-label="Instagram"
                               title="Instagram">

                                <i class="fa-brands fa-instagram"></i>

                            </a>
                        }


                        @if (!string.IsNullOrWhiteSpace(
                            siteUrl))
                        {
                            <a href="@siteUrl"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="rede site"
                               aria-label="Site profissional"
                               title="Site profissional">

                                <i class="fa-solid fa-globe"></i>

                            </a>
                        }

                    </div>

                </section>
            }


            <!-- =================================================
                 ESTATÍSTICAS
            ================================================== -->
            @if (Model.EhDonoPerfil)
            {
                <section class="card-side">

                    <h3>
                        Estatísticas do perfil
                    </h3>


                    <div class="stats-grid">

                        <div class="stat-box">

                            <strong>
                                @clinica.Visualizacoes
                            </strong>

                            <span>
                                Visualizações
                            </span>

                        </div>


                        <div class="stat-box">

                            <strong>
                                @clinica.CliquesWhatsapp
                            </strong>

                            <span>
                                Cliques WhatsApp
                            </span>

                        </div>

                    </div>

                </section>


                <a asp-page="/CadastroClinica"
                   class="btn-editar">

                    <i class="fa-regular fa-pen-to-square"></i>

                    Editar perfil

                </a>
            }

        </aside>

    </div>

</div>


<style>

    /* =========================================================
           BASE
        ========================================================= */

    body {
        margin: 0;
        background: #ecfeff;
        font-family: 'Segoe UI', sans-serif;
    }


    .perfil-page {
        min-height: 100vh;
        padding-bottom: 50px;
        background: radial-gradient( circle at top right, rgba(14,165,233,.08), transparent 28% ), radial-gradient( circle at bottom left, rgba(20,184,166,.08), transparent 32% ), #ecfeff;
    }


    /* =========================================================
           VOLTAR
        ========================================================= */

    .voltar-container {
        max-width: 1200px;
        margin: 20px auto;
        padding: 0 25px;
    }


    .btn-voltar {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #2563eb;
        text-decoration: none;
        font-weight: 600;
        transition: .2s;
    }


        .btn-voltar:hover {
            color: #0ea5e9;
            transform: translateX(-3px);
        }


    /* =========================================================
           TOPO
        ========================================================= */

    .perfil-topo-moderno {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 25px;
    }


    .perfil-topo-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 28px;
        padding: 34px 0 18px;
    }


    .perfil-identidade {
        display: flex;
        align-items: center;
        gap: 26px;
    }


    /* =========================================================
           AVATAR
        ========================================================= */

    .avatar-perfil {
        width: 118px;
        height: 118px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        border: 4px solid white;
        border-radius: 30px;
        background: linear-gradient( 135deg, #ffffff, #f0fdfa );
        color: #0ea5e9;
        font-size: 42px;
        font-weight: 900;
        box-shadow: 0 18px 40px rgba(14,165,233,.16);
    }


        .avatar-perfil img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }


    /* =========================================================
           INFORMAÇÕES PRINCIPAIS
        ========================================================= */

    .perfil-info-principal h1 {
        margin: 12px 0 10px;
        color: #0f172a;
        font-size: 38px;
        line-height: 1.1;
        letter-spacing: -1px;
        overflow-wrap: anywhere;
    }


    .badge-top {
        display: inline-flex;
        padding: 8px 14px;
        border-radius: 999px;
        background: #ecfeff;
        color: #0369a1;
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
    }


    .linha-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 14px;
    }


    .badge-info {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 13px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 800;
    }


    .online {
        background: #dcfce7;
        color: #166534;
    }


    .presencial {
        background: #dbeafe;
        color: #1d4ed8;
    }


    .aprovado {
        background: #fef3c7;
        color: #92400e;
    }


    /* =========================================================
           AÇÕES PRINCIPAIS
        ========================================================= */

    .perfil-acoes-rapidas {
        min-width: 230px;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }


    .btn-topo {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 15px 18px;
        border-radius: 17px;
        color: white;
        text-decoration: none;
        text-align: center;
        font-weight: 800;
        transition: .25s;
    }


        .btn-topo:hover {
            color: white;
            transform: translateY(-3px);
            box-shadow: 0 18px 35px rgba(15,23,42,.12);
        }


    .whatsapp-topo {
        background: linear-gradient( 135deg, #22c55e, #16a34a );
    }


    .agendar-topo {
        background: linear-gradient( 135deg, #14b8a6, #0ea5e9 );
    }


    .btn-topo.indisponivel {
        cursor: not-allowed;
        opacity: .55;
        box-shadow: none;
        transform: none;
    }


    /* =========================================================
           CONTEÚDO
        ========================================================= */

    .conteudo-perfil {
        position: relative;
        z-index: 10;
        max-width: 1200px;
        margin: 28px auto 50px;
        padding: 0 25px;
        display: grid;
        grid-template-columns: minmax(0, 2fr) minmax(300px, 1fr);
        gap: 30px;
    }


    .perfil-main,
    .perfil-side {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 22px;
    }


    /* =========================================================
           CARDS
        ========================================================= */

    .card-perfil,
    .card-side {
        padding: 26px;
        border: 1px solid #ddeceb;
        border-radius: 26px;
        background: #ffffff;
        box-shadow: 0 10px 24px rgba(15,23,42,.05);
        transition: .25s;
    }


        .card-perfil:hover,
        .card-side:hover {
            transform: translateY(-3px);
            box-shadow: 0 26px 60px rgba(15,23,42,.10);
        }


        .card-perfil h3,
        .card-side h3 {
            margin: 0 0 18px;
            color: #0f172a;
            font-size: 16px;
            font-weight: 700;
        }


    /* =========================================================
           ESPECIALIDADES
        ========================================================= */

    .especialidades-lista {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }


    .tag-especialidade {
        padding: 10px 14px;
        border-radius: 999px;
        background: #dbeafe;
        color: #2563eb;
        font-size: 13px;
        font-weight: 700;
    }


    /* =========================================================
           TEXTOS
        ========================================================= */

    .texto-sobre,
    .info-texto,
    .telefone-perfil {
        color: #475569;
        line-height: 1.7;
        font-size: 14px;
        overflow-wrap: break-word;
        word-break: break-word;
    }


    .texto-sobre {
        margin: 0;
    }


    .info-texto,
    .telefone-perfil {
        display: flex;
        align-items: flex-start;
        gap: 8px;
    }


        .info-texto i,
        .telefone-perfil i {
            margin-top: 5px;
            flex-shrink: 0;
            color: #0ea5e9;
        }


    /* =========================================================
           VALOR
        ========================================================= */

    .destaque {
        background: linear-gradient( 135deg, #2563eb, #0ea5e9 );
        color: white;
    }


        .destaque span {
            opacity: .85;
        }


        .destaque h2 {
            margin: 8px 0 0;
            font-size: 32px;
            font-weight: 700;
        }


    /* =========================================================
           AGENDAMENTO
        ========================================================= */

    .agendamento-card p {
        margin-bottom: 18px;
        color: #64748b;
        line-height: 1.6;
    }


    .btn-agendar-consulta {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        padding: 16px;
        border-radius: 16px;
        background: linear-gradient( 135deg, #14b8a6, #0ea5e9 );
        color: white;
        text-decoration: none;
        font-weight: 700;
        transition: .25s;
    }


        .btn-agendar-consulta:hover {
            color: white;
            transform: translateY(-3px);
        }


    /* =========================================================
           REDES
        ========================================================= */

    .redes-grid {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }


    .rede {
        width: 58px;
        height: 58px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        font-size: 25px;
        text-decoration: none;
        transition: .25s;
    }


        .rede:hover {
            transform: translateY(-3px);
        }


    .whatsapp {
        background: #ecfdf5;
        color: #16a34a;
    }


    .insta {
        background: #fdf2f8;
        color: #be185d;
    }


    .site {
        background: #eff6ff;
        color: #2563eb;
    }


    /* =========================================================
           ESTATÍSTICAS
        ========================================================= */

    .stats-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
    }


    .stat-box {
        padding: 20px;
        border-radius: 18px;
        background: #f8fafc;
        text-align: center;
    }


        .stat-box strong {
            display: block;
            color: #0f172a;
            font-size: 24px;
        }


        .stat-box span {
            color: #64748b;
            font-size: 13px;
        }


    /* =========================================================
           EDITAR
        ========================================================= */

    .btn-editar {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 16px;
        border-radius: 16px;
        background: linear-gradient( 135deg, #2563eb, #0ea5e9 );
        color: white;
        text-decoration: none;
        font-weight: 700;
        transition: .25s;
    }


        .btn-editar:hover {
            color: white;
            transform: translateY(-3px);
        }


    /* =========================================================
           TABLET
        ========================================================= */

    @@media (max-width: 900px) {

        .perfil-topo-card {
            flex-direction: column;
            align-items: stretch;
            text-align: center;
        }


        .perfil-identidade {
            flex-direction: column;
            text-align: center;
        }


        .linha-badges {
            justify-content: center;
        }


        .perfil-acoes-rapidas {
            width: 100%;
            min-width: 0;
        }


        .conteudo-perfil {
            grid-template-columns: 1fr;
        }


        .perfil-info-principal h1 {
            font-size: 32px;
        }
    }


    /* =========================================================
           MOBILE
        ========================================================= */

    @@media (max-width: 520px) {

        .perfil-topo-moderno,
        .conteudo-perfil,
        .voltar-container {
            padding-left: 16px;
            padding-right: 16px;
        }


        .voltar-container {
            margin: 16px auto;
        }


        .perfil-topo-card {
            padding-top: 18px;
        }


        .avatar-perfil {
            width: 100px;
            height: 100px;
            border-radius: 25px;
            font-size: 36px;
        }


        .perfil-info-principal h1 {
            font-size: 28px;
        }


        .card-perfil,
        .card-side {
            padding: 21px;
            border-radius: 22px;
        }


        .stats-grid {
            grid-template-columns: 1fr;
        }


        .btn-topo,
        .btn-agendar-consulta,
        .btn-editar {
            min-height: 52px;
        }
    }

</style>