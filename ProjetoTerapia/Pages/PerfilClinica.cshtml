@page
@model ProjetoTerapia.Pages.PerfilClinicaModel

<div class="perfil-page">

    <div class="voltar-container">
        <a href="@(Model.EhDonoPerfil ? "/PainelClinica" : "/Clinicas")"
           class="btn-voltar"
           onclick="return voltarPagina(this)">
            ← Voltar
        </a>
    </div>

    <!-- TOPO MODERNO -->

    <section class="perfil-topo-moderno">

        <div class="perfil-topo-card">

            <div class="perfil-identidade">

                <div class="avatar-perfil">

                    @if (!string.IsNullOrEmpty(Model.Clinica.FotoPerfil))
                    {
                        <img src="@Model.Clinica.FotoPerfil" alt="@Model.Clinica.Nome" />
                    }
                    else
                    {
                        @(string.IsNullOrEmpty(Model.Clinica.Nome)
                                            ? "C"
                                            : Model.Clinica.Nome.Substring(0, 1).ToUpper())
                                        }

                </div>

                <div class="perfil-info-principal">

                    <span class="badge-top">
                        Perfil Profissional
                    </span>

                    <h1>
                        @Model.Clinica.Nome
                    </h1>

                    <div class="linha-badges">

                        @if (Model.Clinica.AtendimentoOnline)
                        {
                            <span class="badge-info online">
                                Online
                            </span>
                        }

                        @if (Model.Clinica.AtendimentoPresencial)
                        {
                            <span class="badge-info presencial">
                                Presencial
                            </span>
                        }

                        <span class="badge-info aprovado">
                            Verificado
                        </span>

                    </div>

                </div>

            </div>

            <div class="perfil-acoes-rapidas">

                @if (!Model.EhDonoPerfil)
                {
                    <a href="/PerfilClinica?handler=Whatsapp&id=@Model.Clinica.Id"
                       target="_blank"
                       class="btn-topo whatsapp-topo">
                        <i class="fa-brands fa-whatsapp"></i>
                        Chamar no WhatsApp
                    </a>

                    @if (Model.PacienteLogado)
                    {
                        <a href="/AgendarConsulta?id=@Model.Clinica.Id"
                           class="btn-topo agendar-topo">
                            Agendar consulta
                        </a>
                    }
                    else
                    {
                        <a href="/LoginPaciente"
                           class="btn-topo agendar-topo">
                            Entrar para agendar
                        </a>
                    }
                }
                else
                {
                    <a href="/CadastroClinica"
                       class="btn-topo agendar-topo">
                        Editar perfil
                    </a>
                }

            </div>

        </div>

    </section>

    <!-- CONTEÚDO -->

    <div class="conteudo-perfil">

        <!-- ESQUERDA -->

        <div class="perfil-main">

            <!-- ESPECIALIDADES -->

            <div class="card-perfil">

                <h3>Especialidades</h3>

                <div class="especialidades-lista">

                    @foreach (var esp in Model.ListaEspecialidades)
                    {
                        <span class="tag-especialidade">
                            @esp
                        </span>
                    }

                </div>

            </div>

            <!-- SOBRE -->

            <div class="card-perfil">

                <h3>Sobre o profissional</h3>

                <p class="texto-sobre">
                    @Model.Clinica.Descricao
                </p>

            </div>

            <!-- LOCALIZAÇÃO -->

            <div class="card-perfil">

                <h3>Localização</h3>

                <p class="info-texto">
                    @(string.IsNullOrWhiteSpace(Model.Clinica.Endereco) ? "Endereço não informado" : Model.Clinica.Endereco)
                </p>

                <p class="info-texto">
                    Cidade: @(string.IsNullOrWhiteSpace(Model.Clinica.Cidade) ? "Não informada" : Model.Clinica.Cidade)
                </p>

            </div>

        </div>

        <!-- DIREITA -->

        <aside class="perfil-side">

            <!-- VALOR -->

            <div class="card-side destaque">

                <span>Consulta inicial</span>

                <h2>
                    @Model.Clinica.Valor.ToString("C", new System.Globalization.CultureInfo("pt-BR"))
                </h2>

            </div>

            <!-- AGENDAMENTO -->
            @if (!Model.EhDonoPerfil)
            {
                <div class="card-side agendamento-card">

                    <h3>Agendamento</h3>

                    <p>
                        Solicite uma consulta com este profissional.
                    </p>

                    @if (Model.PacienteLogado)
                    {
                        <a href="/AgendarConsulta?id=@Model.Clinica.Id"
                           class="btn-agendar-consulta">
                            Agendar consulta
                        </a>
                    }
                    else
                    {
                        <a href="/LoginPaciente"
                           class="btn-agendar-consulta">
                            Entrar para agendar
                        </a>
                    }

                </div>
            }

            <!-- CONTATO -->

            <div class="card-side">

                <h3>Contato</h3>

                <p>
                    @Model.Clinica.Telefone
                </p>

                <a href="/PerfilClinica?handler=Whatsapp&id=@Model.Clinica.Id"
                   target="_blank"
                   class="rede whatsapp">

                    <i class="fa-brands fa-whatsapp"></i>

                </a>

            </div>

            <!-- REDES -->

            <div class="card-side">

                <h3>Redes Sociais</h3>

                <div class="redes-grid">

                    @if (!string.IsNullOrEmpty(Model.Clinica.Instagram))
                    {
                        <a href="@Model.Clinica.Instagram"
                           target="_blank"
                           class="rede insta">

                            <i class="fa-brands fa-instagram"></i>

                        </a>
                    }

                    @if (!string.IsNullOrEmpty(Model.Clinica.Site))
                    {
                        <a href="@Model.Clinica.Site"
                           target="_blank"
                           class="rede site">

                            <i class="fa-solid fa-globe"></i>

                        </a>
                    }

                </div>

            </div>

            <!-- STATS -->
            @if (Model.EhDonoPerfil)
            {
                <div class="card-side">

                    <h3>Estatísticas do perfil</h3>

                    <div class="stats-grid">

                        <div class="stat-box">
                            <strong>
                                @Model.Clinica.Visualizacoes
                            </strong>

                            <span>
                                Visualizações
                            </span>
                        </div>

                        <div class="stat-box">
                            <strong>
                                @Model.Clinica.CliquesWhatsapp
                            </strong>

                            <span>
                                Cliques WhatsApp
                            </span>
                        </div>

                    </div>

                </div>

                <a href="/CadastroClinica"
                   class="btn-editar">

                    Editar perfil

                </a>
            }

        </aside>

    </div>

</div>

<script>
    function voltarPagina(link) {
        if (document.referrer && document.referrer.includes(window.location.origin)) {
            window.history.back();
            return false;
        }

        window.location.href = link.getAttribute("href");
        return false;
    }
</script>

<style>

    body {
        margin: 0;
        background: #ecfeff;
        font-family: 'Segoe UI', sans-serif;
    }

    /* TOPO MODERNO */

    .perfil-page {
        min-height: 100vh;
        background: #ecfeff;
        padding-bottom: 50px;
    }

    .perfil-topo-moderno {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 25px;
    }

    .perfil-topo-card {
        background: transparent;
        border: none;
        border-radius: 0;
        padding: 34px 0 18px;
        box-shadow: none;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 28px;
        position: relative;
        overflow: visible;
    }

        .perfil-topo-card::before {
           display: none;
        }

    .perfil-identidade {
        display: flex;
        align-items: center;
        gap: 26px;
        position: relative;
        z-index: 2;
    }

    .avatar-perfil {
        width: 118px;
        height: 118px;
        border-radius: 30px;
        background: white;
        color: #0ea5e9;
        font-size: 42px;
        font-weight: 900;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        overflow: hidden;
        box-shadow: 0 18px 40px rgba(14,165,233,.16);
        border: 4px solid white;
    }

        .avatar-perfil img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .perfil-info-principal h1 {
        margin: 12px 0 10px;
        font-size: 38px;
        line-height: 1.1;
        color: #0f172a;
        letter-spacing: -1px;
    }

    .badge-top {
        display: inline-flex;
        background: #ecfeff;
        color: #0369a1;
        padding: 8px 14px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 900;
        text-transform: uppercase;
    }

    .linha-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 14px;
    }

    .badge-info {
        padding: 8px 13px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 900;
    }

    .online {
        background: #dcfce7;
        color: #166534;
    }

    .presencial {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .aprovado {
        background: #fef3c7;
        color: #92400e;
    }

    .perfil-acoes-rapidas {
        display: flex;
        flex-direction: column;
        gap: 12px;
        min-width: 230px;
        position: relative;
        z-index: 2;
    }

    .btn-topo {
        padding: 15px 18px;
        border-radius: 17px;
        text-decoration: none;
        font-weight: 900;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        transition: .25s;
        text-align: center;
    }

        .btn-topo:hover {
            transform: translateY(-3px);
            box-shadow: 0 18px 35px rgba(15,23,42,.12);
        }

    .whatsapp-topo {
        background: linear-gradient(135deg,#22c55e,#16a34a);
        color: white;
    }

    .agendar-topo {
        background: linear-gradient(135deg,#14b8a6,#0ea5e9);
        color: white;
    }

    /* CONTEÚDO */

    .conteudo-perfil {
        max-width: 1200px;
        margin: 28px auto 50px;
        position: relative;
        z-index: 10;
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 30px;
        padding: 0 25px;
    }

    /* CARDS */

    .card-perfil,
    .card-side {
        background: #ffffff;
        border-radius: 26px;
        padding: 26px;
        box-shadow: 0 10px 24px rgba(15,23,42,.05);
        border: 1px solid #ddeceb;
        transition: .25s;
    }

        .card-perfil:hover,
        .card-side:hover {
            transform: translateY(-3px);
            box-shadow: 0 26px 60px rgba(15,23,42,.10);
        }

        .card-perfil h3,
        .card-side h3 {
            margin-top: 0;
            margin-bottom: 18px;
            color: #0f172a;
            font-size: 16px;
            font-weight: 600;
        }

    /* TAGS */

    .especialidades-lista {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }

    .tag-especialidade {
        background: #dbeafe;
        color: #2563eb;
        padding: 10px 14px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 700;
    }

    /* TEXTO */

    .texto-sobre,
    .info-texto {
        color: #475569;
        line-height: 1.7;
        max-width: 620px;
        font-size: 14px;
        font-weight: 400;
        overflow-wrap: break-word;
        word-break: break-word;
    }

    /* SIDE */

    .destaque {
        background: linear-gradient(135deg,#2563eb,#0ea5e9);
        color: white;
    }

        .destaque span {
            opacity: .85;
        }

        .destaque h2 {
            font-size: 32px;
            font-weight: 700;
        }

    /* BOTÕES */

    .btn-whatsapp,
    .btn-editar {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 16px;
        border-radius: 16px;
        text-decoration: none;
        font-weight: 700;
        transition: .25s;
    }

    .btn-whatsapp {
        background: #25D366;
        color: white;
        margin-top: 18px;
    }

    .btn-editar {
        background: linear-gradient(135deg,#2563eb,#0ea5e9);
        color: white;
    }

        .btn-whatsapp:hover,
        .btn-editar:hover {
            transform: translateY(-3px);
        }

    .whatsapp {
        background: #ecfdf5;
        color: #16a34a;
    }

    .rede {
        width: 60px;
        height: 60px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        transition: .25s;
    }

        .rede:hover {
            transform: translateY(-3px);
        }

    /* REDES */

    .redes-grid {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .rede {
        flex: 1;
        text-align: center;
        padding: 14px;
        border-radius: 14px;
        text-decoration: none;
        font-weight: 700;
    }

    .insta {
        background: #fdf2f8;
        color: #be185d;
    }

    .site {
        background: #eff6ff;
        color: #2563eb;
    }

    /* STATS */

    .stats-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
    }

    .stat-box {
        background: #f8fafc;
        border-radius: 18px;
        padding: 20px;
        text-align: center;
    }

        .stat-box strong {
            display: block;
            font-size: 24px;
            color: #0f172a;
        }

        .stat-box span {
            color: #64748b;
            font-size: 13px;
        }

    /* RESPONSIVO */

    @@media(max-width:900px) {

        .perfil-topo-card {
            flex-direction: column;
            align-items: stretch;
            text-align: center;
        }

        .perfil-identidade {
            flex-direction: column;
            text-align: center;
        }

        .linha-badges {
            justify-content: center;
        }

        .perfil-acoes-rapidas {
            width: 100%;
            min-width: 0;
        }

        .conteudo-perfil {
            grid-template-columns: 1fr;
        }

        .perfil-info-principal h1 {
            font-size: 32px;
        }
    }

    .voltar-container {
        max-width: 1200px;
        margin: 20px auto;
        padding: 0 25px;
    }

    .btn-voltar {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        color: #2563eb;
        font-weight: 600;
    }

    .agendamento-card p {
        color: #64748b;
        line-height: 1.6;
        margin-bottom: 18px;
    }

    .btn-agendar-consulta {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 16px;
        border-radius: 16px;
        text-decoration: none;
        font-weight: 700;
        transition: .25s;
        background: linear-gradient(135deg,#14b8a6,#0ea5e9);
        color: white;
    }

        .btn-agendar-consulta:hover {
            transform: translateY(-3px);
        }

</style>