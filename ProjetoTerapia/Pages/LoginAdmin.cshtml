@page "/admin/login"
@model ProjetoTerapia.Pages.LoginAdminModel

@{
    ViewData["Title"] = "Acesso administrativo";
}

<div class="admin-login-page">

    <div class="login-bg bg-1"></div>
    <div class="login-bg bg-2"></div>

    <main class="login-admin-card" aria-labelledby="tituloAdmin">

        <div class="logo-area-admin">
            <img src="~/imagem/AlinhaVIDA.png"
                 asp-append-version="true"
                 alt="AlinhaVIDA" />
        </div>

        <span class="badge-admin-login">
            <i class="fa-solid fa-shield-halved"></i>
            Área restrita
        </span>

        <h1 id="tituloAdmin">
            Acesso administrativo
        </h1>

        <p class="descricao-admin">
            Entre com suas credenciais autorizadas para acessar
            o painel de gerenciamento do AlinhaVIDA.
        </p>

        @if (Model.Erro)
        {
            <div class="alerta-erro"
                 role="alert"
                 aria-live="polite">

                <i class="fa-solid fa-circle-exclamation"></i>

                <span>
                    Não foi possível realizar o acesso.
                    Verifique suas credenciais e tente novamente.
                </span>

            </div>
        }

        <form method="post"
              class="form-admin">

            <div class="campo-login">

                <label asp-for="Email">
                    Email
                </label>

                <div class="input-wrapper">

                    <i class="fa-regular fa-envelope"></i>

                    <input asp-for="Email"
                           type="email"
                           autocomplete="username"
                           inputmode="email"
                           placeholder="Digite seu email"
                           required />

                </div>

            </div>

            <div class="campo-login">

                <label asp-for="Senha">
                    Senha
                </label>

                <div class="input-wrapper">

                    <i class="fa-solid fa-lock"></i>

                    <input asp-for="Senha"
                           id="senhaAdmin"
                           type="password"
                           autocomplete="current-password"
                           placeholder="Digite sua senha"
                           required />

                    <button type="button"
                            class="btn-mostrar-senha"
                            id="btnMostrarSenha"
                            aria-label="Mostrar senha"
                            title="Mostrar senha">

                        <i class="fa-regular fa-eye"></i>

                    </button>

                </div>

            </div>

            <button type="submit"
                    class="btn-entrar-admin"
                    id="btnEntrarAdmin">

                <span class="texto-botao">
                    Entrar no painel
                </span>

                <i class="fa-solid fa-arrow-right"></i>

            </button>

        </form>

        <div class="aviso-seguranca">

            <i class="fa-solid fa-lock"></i>

            <span>
                Área exclusiva para usuários administrativos autorizados.
            </span>

        </div>

        <a asp-page="/Index"
           class="voltar-site">

            <i class="fa-solid fa-arrow-left"></i>
            Voltar para o AlinhaVIDA

        </a>

    </main>

</div>


<style>

    @@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');


    /* =========================================================
       BASE
    ========================================================= */

    * {
        box-sizing: border-box;
        font-family: 'Poppins', sans-serif;
    }

    html,
    body {
        margin: 0;
        padding: 0;

        background: #eaf8ff;

        color: #0f172a;
    }

    .container,
    .container-fluid,
    main.pb-3 {
        padding: 0 !important;
        margin: 0 !important;
        max-width: 100% !important;

        background: transparent !important;
    }


    /* =========================================================
       PÁGINA
    ========================================================= */

    .admin-login-page {
        position: relative;

        min-height: 100vh;

        display: flex;
        align-items: center;
        justify-content: center;

        padding: 40px 20px;

        overflow: hidden;

        background:
            radial-gradient(
                circle at top left,
                rgba(14,165,233,.20),
                transparent 34%
            ),
            radial-gradient(
                circle at bottom right,
                rgba(124,58,237,.16),
                transparent 35%
            ),
            linear-gradient(
                135deg,
                #e0f7ff 0%,
                #f8fcff 48%,
                #edf3ff 100%
            );
    }


    /* =========================================================
       EFEITOS DE FUNDO
    ========================================================= */

    .login-bg {
        position: absolute;

        border-radius: 50%;

        filter: blur(90px);

        pointer-events: none;
    }

    .bg-1 {
        width: 340px;
        height: 340px;

        top: -120px;
        left: -100px;

        background: rgba(14,165,233,.22);
    }

    .bg-2 {
        width: 320px;
        height: 320px;

        right: -100px;
        bottom: -120px;

        background: rgba(124,58,237,.18);
    }


    /* =========================================================
       CARD PRINCIPAL
    ========================================================= */

    .login-admin-card {
        position: relative;
        z-index: 2;

        width: 100%;
        max-width: 470px;

        margin: 0;

        padding: 40px;

        border: 1px solid rgba(226,232,240,.90);

        border-radius: 30px;

        background: rgba(255,255,255,.96);

        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);

        box-shadow:
            0 25px 70px rgba(15,23,42,.12);

        text-align: center;
    }


    /* =========================================================
       LOGO
    ========================================================= */

    .logo-area-admin img {
        width: 230px;
        max-width: 100%;
        height: auto;

        margin-bottom: 12px;

        object-fit: contain;
    }


    /* =========================================================
       BADGE
    ========================================================= */

    .badge-admin-login {
        display: inline-flex;
        align-items: center;

        gap: 7px;

        margin-bottom: 19px;

        padding: 8px 15px;

        border: 1px solid rgba(14,165,233,.14);

        border-radius: 999px;

        background: rgba(14,165,233,.09);

        color: #0369a1;

        font-size: 12px;
        font-weight: 700;
    }


    /* =========================================================
       TÍTULOS
    ========================================================= */

    .login-admin-card h1 {
        margin: 0 0 10px;

        color: #0f172a;

        font-size: 30px;
        line-height: 1.2;

        font-weight: 700;

        letter-spacing: -.8px;
    }

    .descricao-admin {
        margin: 0 0 27px;

        color: #64748b;

        font-size: 13px;

        line-height: 1.7;
    }


    /* =========================================================
       ALERTA
    ========================================================= */

    .alerta-erro {
        display: flex;
        align-items: flex-start;

        gap: 10px;

        margin-bottom: 20px;

        padding: 14px 15px;

        border: 1px solid #fecaca;

        border-radius: 14px;

        background: #fff1f2;

        color: #991b1b;

        font-size: 13px;
        font-weight: 600;

        line-height: 1.5;

        text-align: left;
    }

    .alerta-erro i {
        margin-top: 3px;

        flex-shrink: 0;
    }


    /* =========================================================
       FORMULÁRIO
    ========================================================= */

    .form-admin {
        width: 100%;
    }

    .campo-login {
        margin-bottom: 17px;

        text-align: left;
    }

    .campo-login label {
        display: block;

        margin: 0 0 7px 2px;

        color: #334155;

        font-size: 13px;
        font-weight: 600;
    }


    /* =========================================================
       INPUT
    ========================================================= */

    .input-wrapper {
        position: relative;

        display: flex;
        align-items: center;
    }

    .input-wrapper > i {
        position: absolute;

        left: 16px;

        z-index: 2;

        color: #94a3b8;

        font-size: 14px;

        pointer-events: none;
    }

    .input-wrapper input {
        width: 100%;
        height: 54px;

        padding:
            0
            48px
            0
            44px;

        border: 1px solid #dbe2ea;

        border-radius: 14px;

        background: #f8fafc;

        color: #0f172a;

        outline: none;

        font-size: 14px;

        transition:
            border-color .2s ease,
            box-shadow .2s ease,
            background .2s ease;
    }

    .input-wrapper input::placeholder {
        color: #94a3b8;
    }

    .input-wrapper input:focus {
        border-color: #0ea5e9;

        background: white;

        box-shadow:
            0 0 0 4px rgba(14,165,233,.10);
    }


    /* =========================================================
       MOSTRAR SENHA
    ========================================================= */

    .btn-mostrar-senha {
        position: absolute;

        right: 12px;

        width: 34px;
        height: 34px;

        display: flex;
        align-items: center;
        justify-content: center;

        border: 0;

        border-radius: 9px;

        background: transparent;

        color: #64748b;

        cursor: pointer;

        transition:
            background .2s ease,
            color .2s ease;
    }

    .btn-mostrar-senha:hover {
        background: #eef6ff;

        color: #0ea5e9;
    }


    /* =========================================================
       BOTÃO ENTRAR
    ========================================================= */

    .btn-entrar-admin {
        width: 100%;
        min-height: 56px;

        margin-top: 5px;

        padding: 0 20px;

        display: flex;
        align-items: center;
        justify-content: center;

        gap: 10px;

        border: none;

        border-radius: 15px;

        background:
            linear-gradient(
                135deg,
                #14b8a6,
                #0ea5e9
            );

        color: white;

        font-size: 15px;
        font-weight: 700;

        cursor: pointer;

        box-shadow:
            0 14px 28px rgba(14,165,233,.18);

        transition:
            transform .2s ease,
            box-shadow .2s ease,
            opacity .2s ease;
    }

    .btn-entrar-admin:hover {
        transform: translateY(-2px);

        box-shadow:
            0 18px 34px rgba(14,165,233,.24);
    }

    .btn-entrar-admin:disabled {
        cursor: wait;

        opacity: .7;

        transform: none;
    }


    /* =========================================================
       AVISO DE SEGURANÇA
    ========================================================= */

    .aviso-seguranca {
        display: flex;
        align-items: center;
        justify-content: center;

        gap: 7px;

        margin-top: 19px;

        color: #94a3b8;

        font-size: 11px;

        line-height: 1.5;
    }

    .aviso-seguranca i {
        color: #64748b;

        font-size: 11px;
    }


    /* =========================================================
       VOLTAR
    ========================================================= */

    .voltar-site {
        display: inline-flex;
        align-items: center;

        gap: 7px;

        margin-top: 18px;

        color: #0284c7;

        text-decoration: none;

        font-size: 13px;
        font-weight: 600;

        transition:
            color .2s ease,
            transform .2s ease;
    }

    .voltar-site:hover {
        color: #0369a1;

        transform: translateX(-2px);
    }


    /* =========================================================
       RESPONSIVO
    ========================================================= */

    @@media (max-width: 600px) {

        .admin-login-page {
            padding: 20px 14px;
        }

        .login-admin-card {
            padding: 30px 22px;

            border-radius: 24px;
        }

        .logo-area-admin img {
            width: 205px;
        }

        .login-admin-card h1 {
            font-size: 26px;
        }

        .descricao-admin {
            font-size: 12px;
        }

    }

</style>


<script>

    (() => {

        const senha =
            document.getElementById("senhaAdmin");

        const botaoMostrar =
            document.getElementById("btnMostrarSenha");

        const formulario =
            document.querySelector(".form-admin");

        const botaoEntrar =
            document.getElementById("btnEntrarAdmin");


        /* =====================================================
           MOSTRAR / OCULTAR SENHA
        ===================================================== */

        if (senha && botaoMostrar) {

            botaoMostrar.addEventListener(
                "click",
                () => {

                    const estaOculta =
                        senha.type === "password";

                    senha.type =
                        estaOculta
                            ? "text"
                            : "password";


                    botaoMostrar.innerHTML =
                        estaOculta
                            ? '<i class="fa-regular fa-eye-slash"></i>'
                            : '<i class="fa-regular fa-eye"></i>';


                    botaoMostrar.setAttribute(
                        "aria-label",
                        estaOculta
                            ? "Ocultar senha"
                            : "Mostrar senha"
                    );

                }
            );

        }


        /* =====================================================
           EVITA CLIQUES DUPLOS
        ===================================================== */

        if (formulario && botaoEntrar) {

            formulario.addEventListener(
                "submit",
                () => {

                    botaoEntrar.disabled = true;

                    botaoEntrar.innerHTML =
                        '<i class="fa-solid fa-circle-notch fa-spin"></i>' +
                        '<span>Verificando acesso...</span>';

                }
            );

        }

    })();

</script>